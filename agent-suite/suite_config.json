            8,
            9
          ],
          "weekdays": [
            0,
            1,
            2,
            3,
            4
          ],
          "multiplier": 2
        }
      },
      "budget_usd": null,
      "plan": {
        "kind": "subscription",
        "price_usd": 10.0,
        "monthly_credits_usd": 100.0,
        "window_5h_usd": 20.0,
        "weekly_usd": 50.0
      },
      "cap_detection": {
        "cap_statuses": [
          402
        ],
        "cap_pattern": "usage limit|usage exceeded|spending limit|reached your|insufficient credits|out of credits|monthly credits"
      },
      "cap_policy": {
        "wait_on_cap_minutes": 300,
        "max_cap_waits": null,
        "max_single_wait_hours": 6
      },
      "inject_body": {
        "reasoning_effort": "off"
      }
    }
  ],
  "agent": {
    "cmd": [
      "opencode",
      "run",
      "--pure",
      "--auto",
      "--dir",
      "{workspace}",
      "-m",
      "bench/{model}"
    ],
    "config_file": "opencode.json",
    "config": {
      "$schema": "https://opencode.ai/config.json",
      "autoupdate": false,
      "share": "disabled",
      "provider": {
        "bench": {
          "npm": "@ai-sdk/openai-compatible",
          "name": "bench",
          "options": {
            "baseURL": "{proxy_url}",
            "apiKey": "proxy-injects-real-key"
          },
          "models": {
            "{model}": {
              "name": "{model}"
            }
          }
        }
      },
      "model": "bench/{model}",
      "small_model": "bench/{model}"
    },
    "isolate_home": true,
    "prompt_suffix": "\n\nWork only in the current directory. Run the test suite with `python -m pytest -q` before you finish. Do not ask questions; make reasonable decisions and complete the task."
  }
}
