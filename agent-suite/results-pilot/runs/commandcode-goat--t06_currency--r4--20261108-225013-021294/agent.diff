+
+def test_currency_mismatch_raises():
+    with pytest.raises(CurrencyMismatch):
+        Money("1.00", "USD") + Money("1.00", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        Money("1.00", "USD") - Money("1.00", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        Money("1.00", "USD") < Money("1.00", "EUR")
+
+
+def test_balance_multiple_currencies():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("10.00", "USD"), "x"),
+        Transaction(date(2026, 1, 2), "b", Money("20.00", "EUR"), "x"),
+    ])
+    assert l.balance() == {"USD": Money("10.00", "USD"), "EUR": Money("20.00", "EUR")}
+    assert Ledger().balance() == {}
+
+
+def test_summary_mixed_currencies():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("10.00", "USD"), "food"),
+        Transaction(date(2026, 1, 2), "b", Money("20.00", "EUR"), "food"),
+        Transaction(date(2026, 2, 1), "c", Money("5.00", "USD"), "food"),
+    ])
+    s = monthly_summary(l)
+    assert s["2026-01"][("food", "USD")] == Money("10.00", "USD")
+    assert s["2026-01"][("food", "EUR")] == Money("20.00", "EUR")
+    assert s["2026-02"]["food"] == Money("5.00", "USD")
