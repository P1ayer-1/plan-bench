index 0000000..3768294
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,284 @@
+from datetime import date
+
+from ledger import Ledger, Money, Transaction
+from ledger.report import largest_expenses, monthly_summary
+
+
+def make_tx(day, amount, category="misc", description="tx", currency="USD"):
+    return Transaction(
+        date=day,
+        description=description,
+        amount=Money(amount, currency),
+        category=category,
+    )
+
+
+def test_monthly_summary_empty_ledger():
+    assert monthly_summary(Ledger()) == {}
+
+
+def test_monthly_summary_groups_by_month_and_category():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 3), "-4.50", "food"),
+        make_tx(date(2026, 1, 4), "-5.50", "food"),
+        make_tx(date(2026, 1, 15), "100.00", "income"),
+        make_tx(date(2026, 2, 1), "-1200.00", "housing"),
+    ])
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01", "2026-02"]
+    assert summary["2026-01"] == {
+        "food": Money("-10.00"),
+        "income": Money("100.00"),
+    }
+    assert summary["2026-02"] == {"housing": Money("-1200.00")}
+
+
+def test_monthly_summary_sums_repeated_categories_instead_of_overwriting():
+    ledger = Ledger([
+        make_tx(date(2026, 3, 1), "-1.25", "food"),
+        make_tx(date(2026, 3, 2), "-2.50", "food"),
+        make_tx(date(2026, 3, 3), "-3.75", "food"),
+    ])
+
+    assert monthly_summary(ledger)["2026-03"]["food"] == Money("-7.50")
+
+
+def test_monthly_summary_does_not_merge_categories():
+    ledger = Ledger([
+        make_tx(date(2026, 4, 1), "-10.00", "food"),
+        make_tx(date(2026, 4, 2), "-20.00", "travel"),
+        make_tx(date(2026, 4, 3), "-30.00", "housing"),
+    ])
+
+    assert monthly_summary(ledger)["2026-04"] == {
+        "food": Money("-10.00"),
+        "travel": Money("-20.00"),
+        "housing": Money("-30.00"),
+    }
+
+
+def test_monthly_summary_does_not_merge_same_named_month_across_years():
+    ledger = Ledger([
+        make_tx(date(2025, 1, 10), "-10.00", "food"),
+        make_tx(date(2026, 1, 10), "-99.00", "food"),
+    ])
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2025-01", "2026-01"]
+    assert summary["2025-01"]["food"] == Money("-10.00")
+    assert summary["2026-01"]["food"] == Money("-99.00")
+
+
+def test_monthly_summary_sorts_months_across_year_boundary():
+    ledger = Ledger([
+        make_tx(date(2026, 2, 10), "-4.00", "food"),
+        make_tx(date(2025, 12, 31), "-3.00", "food"),
+        make_tx(date(2026, 1, 1), "-2.00", "food"),
+        make_tx(date(2025, 1, 15), "-1.00", "food"),
+    ])
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2025-01", "2025-12", "2026-01", "2026-02"]
+
+
+def test_monthly_summary_zero_pads_single_digit_months():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 5), "-1.00", "food"),
+        make_tx(date(2026, 9, 5), "-9.00", "food"),
+        make_tx(date(2026, 12, 5), "-12.00", "food"),
+    ])
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01", "2026-09", "2026-12"]
+    assert all(len(key) == 7 and key[4] == "-" for key in summary)
+
+
+def test_monthly_summary_keeps_positive_and_negative_amounts():
+    ledger = Ledger([
+        make_tx(date(2026, 5, 1), "100.00", "refund"),
+        make_tx(date(2026, 5, 2), "-40.00", "refund"),
+    ])
+
+    assert monthly_summary(ledger)["2026-05"]["refund"] == Money("60.00")
+
+
+def test_monthly_summary_keeps_negative_net_for_spending_category():
+    ledger = Ledger([
+        make_tx(date(2026, 6, 1), "-25.00", "food"),
+        make_tx(date(2026, 6, 2), "-15.00", "food"),
+    ])
+
+    assert monthly_summary(ledger)["2026-06"]["food"] == Money("-40.00")
+
+
+def test_monthly_summary_sums_decimal_cents_exactly():
+    ledger = Ledger([
+        make_tx(date(2026, 7, 1), "0.10", "cash"),
+        make_tx(date(2026, 7, 2), "0.20", "cash"),
+    ])
+
+    assert monthly_summary(ledger)["2026-07"]["cash"] == Money("0.30")
+
+
+def test_monthly_summary_preserves_currencies_per_category():
+    ledger = Ledger([
+        make_tx(date(2026, 8, 1), "-10.00", "food", currency="USD"),
+        make_tx(date(2026, 8, 2), "-20.00", "travel", currency="EUR"),
+    ])
+
+    summary = monthly_summary(ledger)["2026-08"]
+
+    assert summary["food"] == Money("-10.00", "USD")
+    assert summary["travel"] == Money("-20.00", "EUR")
+
+
+def test_monthly_summary_omits_months_without_transactions():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-1.00", "food"),
+        make_tx(date(2026, 4, 1), "-4.00", "food"),
+    ])
+
+    assert list(monthly_summary(ledger)) == ["2026-01", "2026-04"]
+
+
+def test_monthly_summary_does_not_mutate_ledger_transactions():
+    transactions = [
+        make_tx(date(2026, 1, 1), "-1.00", "food"),
+        make_tx(date(2026, 1, 2), "-2.00", "food"),
+    ]
+    ledger = Ledger(transactions)
+    original = list(ledger.transactions)
+
+    monthly_summary(ledger)
+
+    assert ledger.transactions == original
+
+
+def test_monthly_summary_defaults_empty_ledger_to_plain_dict():
+    summary = monthly_summary(Ledger([]))
+
+    assert summary == {}
+    assert isinstance(summary, dict)
+
+
+def test_largest_expenses_empty_ledger():
+    assert largest_expenses(Ledger()) == []
+
+
+def test_largest_expenses_default_returns_three_most_negative_in_order():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-5.00", description="five"),
+        make_tx(date(2026, 1, 2), "-100.00", description="hundred"),
+        make_tx(date(2026, 1, 3), "-20.00", description="twenty"),
+        make_tx(date(2026, 1, 4), "-1.00", description="one"),
+    ])
+
+    result = largest_expenses(ledger)
+
+    assert [tx.description for tx in result] == ["hundred", "twenty", "five"]
+    assert [tx.amount for tx in result] == [
+        Money("-100.00"),
+        Money("-20.00"),
+        Money("-5.00"),
+    ]
+
+
+def test_largest_expenses_respects_n():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-5.00"),
+        make_tx(date(2026, 1, 2), "-100.00"),
+        make_tx(date(2026, 1, 3), "-20.00"),
+    ])
+
+    result = largest_expenses(ledger, n=2)
+
+    assert [tx.amount for tx in result] == [Money("-100.00"), Money("-20.00")]
+
+
+def test_largest_expenses_returns_all_when_fewer_than_n():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-5.00"),
+        make_tx(date(2026, 1, 2), "-10.00"),
+    ])
+
+    assert len(largest_expenses(ledger, n=10)) == 2
+
+
+def test_largest_expenses_returns_none_when_n_is_zero():
+    ledger = Ledger([make_tx(date(2026, 1, 1), "-5.00")])
+
+    assert largest_expenses(ledger, n=0) == []
+
+
+def test_largest_expenses_excludes_income_and_zero_amounts():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "1000.00", description="salary"),
+        make_tx(date(2026, 1, 2), "0.00", description="zero"),
+        make_tx(date(2026, 1, 3), "-2.00", description="expense"),
+    ])
+
+    result = largest_expenses(ledger, n=5)
+
+    assert [tx.description for tx in result] == ["expense"]
+
+
+def test_largest_expenses_does_not_prefer_small_magnitude_negative():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-0.01", description="tiny"),
+        make_tx(date(2026, 1, 2), "-999.99", description="huge"),
+        make_tx(date(2026, 1, 3), "-50.00", description="medium"),
+    ])
+
+    result = largest_expenses(ledger, n=3)
+
+    assert [tx.description for tx in result] == ["huge", "medium", "tiny"]
+
+
+def test_largest_expenses_returns_transaction_objects_unchanged():
+    expected = make_tx(
+        date(2026, 2, 14),
+        "-42.42",
+        category="food",
+        description="dinner",
+        currency="EUR",
+    )
+    ledger = Ledger([expected, make_tx(date(2026, 2, 15), "10.00")])
+
+    result = largest_expenses(ledger)
+
+    assert len(result) == 1
+    assert result[0] is expected
+    assert result[0].date == date(2026, 2, 14)
+    assert result[0].category == "food"
+    assert result[0].amount == Money("-42.42", "EUR")
+
+
+def test_largest_expenses_does_not_mutate_ledger_order():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-5.00", description="first"),
+        make_tx(date(2026, 1, 2), "-100.00", description="second"),
+        make_tx(date(2026, 1, 3), "-20.00", description="third"),
+    ])
+    original = list(ledger.transactions)
+
+    largest_expenses(ledger, n=2)
+
+    assert ledger.transactions == original
+
+
+def test_largest_expenses_handles_duplicate_amounts():
+    ledger = Ledger([
+        make_tx(date(2026, 1, 1), "-10.00", description="a"),
+        make_tx(date(2026, 1, 2), "-10.00", description="b"),
+        make_tx(date(2026, 1, 3), "-5.00", description="c"),
+    ])
+
+    result = largest_expenses(ledger, n=2)
+
+    assert len(result) == 2
+    assert all(tx.amount == Money("-10.00") for tx in result)
