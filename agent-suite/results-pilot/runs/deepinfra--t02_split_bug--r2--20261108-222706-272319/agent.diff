diff --git a/ledger/money.py b/ledger/money.py
index c17d860..62b3a09 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -38,9 +38,21 @@ class Money:
         return f"{self.amount} {self.currency}"
 
     def split(self, n):
-        """Split into n parts."""
-        part = (self.amount / n).quantize(CENT, rounding=ROUND_HALF_UP)
-        return [Money(part, self.currency) for _ in range(n)]
+        """Split into n parts whose sum is exactly this amount.
+
+        Parts differ by at most one cent, with any remainder going to the
+        earliest parts.
+        """
+        if n <= 0:
+            raise ValueError("n must be a positive integer")
+        total_cents = int((self.amount / CENT).to_integral_value(rounding=ROUND_HALF_UP))
+        sign = -1 if total_cents < 0 else 1
+        base, extra = divmod(abs(total_cents), n)
+        parts = []
+        for i in range(n):
+            cents = base + (1 if i < extra else 0)
+            parts.append(Money(sign * cents * CENT, self.currency))
+        return parts
 
     @classmethod
     def zero(cls, currency="USD"):
