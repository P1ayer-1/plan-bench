diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..c0486a7
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,318 @@
+from datetime import date
+
+from ledger import Ledger, Money, Transaction
+from ledger.report import largest_expenses, monthly_summary
+
+
+def tx(day, description, amount, category, currency="USD"):
+    return Transaction(
+        date=day,
+        description=description,
+        amount=Money(amount, currency),
+        category=category,
+    )
+
+
+def make_ledger(*transactions):
+    return Ledger(list(transactions))
+
+
+# ---------------------------------------------------------------------------
+# monthly_summary
+# ---------------------------------------------------------------------------
+
+
+def test_monthly_summary_empty_ledger():
+    assert monthly_summary(Ledger()) == {}
+
+
+def test_monthly_summary_single_transaction():
+    ledger = make_ledger(tx(date(2026, 3, 15), "Coffee", "-4.50", "food"))
+
+    assert monthly_summary(ledger) == {"2026-03": {"food": Money("-4.50")}}
+
+
+def test_monthly_summary_pads_single_digit_month():
+    ledger = make_ledger(tx(date(2026, 1, 5), "Coffee", "-4.50", "food"))
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01"]
+    assert "2026-1" not in summary
+
+
+def test_monthly_summary_handles_december_and_year_boundary():
+    ledger = make_ledger(
+        tx(date(2026, 12, 31), "Party", "-50.00", "fun"),
+        tx(date(2027, 1, 1), "Coffee", "-3.00", "food"),
+    )
+
+    assert list(monthly_summary(ledger)) == ["2026-12", "2027-01"]
+
+
+def test_monthly_summary_groups_all_days_of_same_month_together():
+    ledger = make_ledger(
+        tx(date(2026, 5, 1), "First", "-10.00", "food"),
+        tx(date(2026, 5, 31), "Last", "-20.00", "food"),
+        tx(date(2026, 6, 1), "Next", "-30.00", "food"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-05", "2026-06"]
+    assert summary["2026-05"] == {"food": Money("-30.00")}
+    assert summary["2026-06"] == {"food": Money("-30.00")}
+
+
+def test_monthly_summary_sums_multiple_transactions_in_same_category():
+    ledger = make_ledger(
+        tx(date(2026, 1, 3), "Coffee", "-4.50", "food"),
+        tx(date(2026, 1, 7), "Lunch", "-12.25", "food"),
+        tx(date(2026, 1, 20), "Snacks", "-3.25", "food"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["food"] == Money("-20.00")
+
+
+def test_monthly_summary_keeps_categories_separate():
+    ledger = make_ledger(
+        tx(date(2026, 1, 3), "Coffee", "-4.50", "food"),
+        tx(date(2026, 1, 5), "Bus", "-2.00", "transport"),
+        tx(date(2026, 1, 7), "Lunch", "-12.25", "food"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"] == {
+        "food": Money("-16.75"),
+        "transport": Money("-2.00"),
+    }
+
+
+def test_monthly_summary_does_not_mix_categories_across_months():
+    ledger = make_ledger(
+        tx(date(2026, 1, 31), "January food", "-10.00", "food"),
+        tx(date(2026, 2, 1), "February food", "-25.00", "food"),
+        tx(date(2026, 2, 10), "February rent", "-900.00", "housing"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"] == {"food": Money("-10.00")}
+    assert summary["2026-02"] == {
+        "food": Money("-25.00"),
+        "housing": Money("-900.00"),
+    }
+
+
+def test_monthly_summary_net_amounts_include_positive_and_negative():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Salary", "3000.00", "income"),
+        tx(date(2026, 1, 2), "Refund", "15.25", "income"),
+        tx(date(2026, 1, 3), "Tax", "-500.50", "income"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["income"] == Money("2514.75")
+
+
+def test_monthly_summary_handles_negative_and_positive_in_different_months():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Salary", "3000.00", "income"),
+        tx(date(2026, 2, 1), "Rent", "-1200.00", "housing"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["income"] == Money("3000.00")
+    assert summary["2026-02"]["housing"] == Money("-1200.00")
+
+
+def test_monthly_summary_returns_month_keys_in_chronological_order():
+    ledger = make_ledger(
+        tx(date(2026, 9, 1), "September", "-1.00", "misc"),
+        tx(date(2025, 12, 15), "December", "-2.00", "misc"),
+        tx(date(2026, 1, 15), "January", "-3.00", "misc"),
+        tx(date(2026, 10, 1), "October", "-4.00", "misc"),
+    )
+
+    assert list(monthly_summary(ledger)) == [
+        "2025-12",
+        "2026-01",
+        "2026-09",
+        "2026-10",
+    ]
+
+
+def test_monthly_summary_does_not_mutate_ledger_or_transactions():
+    transactions = [
+        tx(date(2026, 1, 3), "Coffee", "-4.50", "food"),
+        tx(date(2026, 1, 4), "Lunch", "-12.00", "food"),
+    ]
+    ledger = make_ledger(*transactions)
+
+    monthly_summary(ledger)
+
+    assert ledger.transactions == transactions
+
+
+def test_monthly_summary_preserves_category_currency():
+    ledger = make_ledger(
+        tx(date(2026, 1, 3), "Coffee", "-4.50", "food", currency="EUR"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["food"] == Money("-4.50", "EUR")
+    assert summary["2026-01"]["food"].currency == "EUR"
+
+
+def test_monthly_summary_sums_more_than_two_transactions_with_cents():
+    ledger = make_ledger(
+        tx(date(2026, 7, 1), "A", "0.10", "misc"),
+        tx(date(2026, 7, 2), "B", "0.20", "misc"),
+        tx(date(2026, 7, 3), "C", "-0.05", "misc"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-07"]["misc"] == Money("0.25")
+
+
+# ---------------------------------------------------------------------------
+# largest_expenses
+# ---------------------------------------------------------------------------
+
+
+def test_largest_expenses_filters_out_income_and_zero():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Salary", "3000.00", "income"),
+        tx(date(2026, 1, 2), "Rent", "-1200.00", "housing"),
+        tx(date(2026, 1, 3), "Zero", "0.00", "misc"),
+        tx(date(2026, 1, 4), "Coffee", "-4.50", "food"),
+    )
+
+    expenses = largest_expenses(ledger, n=10)
+
+    assert [t.description for t in expenses] == ["Rent", "Coffee"]
+
+
+def test_largest_expenses_sorts_most_negative_first():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Small", "-5.00", "misc"),
+        tx(date(2026, 1, 2), "Large", "-100.00", "misc"),
+        tx(date(2026, 1, 3), "Medium", "-20.00", "misc"),
+    )
+
+    expenses = largest_expenses(ledger, n=3)
+
+    assert [t.description for t in expenses] == ["Large", "Medium", "Small"]
+    assert [t.amount for t in expenses] == [
+        Money("-100.00"),
+        Money("-20.00"),
+        Money("-5.00"),
+    ]
+
+
+def test_largest_expenses_respects_n():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "A", "-1.00", "misc"),
+        tx(date(2026, 1, 2), "B", "-2.00", "misc"),
+        tx(date(2026, 1, 3), "C", "-3.00", "misc"),
+        tx(date(2026, 1, 4), "D", "-4.00", "misc"),
+    )
+
+    assert [t.description for t in largest_expenses(ledger, n=2)] == ["D", "C"]
+
+
+def test_largest_expenses_default_n_is_three():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "A", "-1.00", "misc"),
+        tx(date(2026, 1, 2), "B", "-2.00", "misc"),
+        tx(date(2026, 1, 3), "C", "-3.00", "misc"),
+        tx(date(2026, 1, 4), "D", "-4.00", "misc"),
+        tx(date(2026, 1, 5), "E", "-5.00", "misc"),
+    )
+
+    assert [t.description for t in largest_expenses(ledger)] == ["E", "D", "C"]
+
+
+def test_largest_expenses_n_larger_than_available_returns_all_expenses():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "A", "-1.00", "misc"),
+        tx(date(2026, 1, 2), "B", "-2.00", "misc"),
+    )
+
+    expenses = largest_expenses(ledger, n=100)
+
+    assert [t.description for t in expenses] == ["B", "A"]
+
+
+def test_largest_expenses_n_zero_returns_empty():
+    ledger = make_ledger(tx(date(2026, 1, 1), "A", "-1.00", "misc"))
+
+    assert largest_expenses(ledger, n=0) == []
+
+
+def test_largest_expenses_empty_ledger():
+    assert largest_expenses(Ledger()) == []
+
+
+def test_largest_expenses_only_income_or_zero_returns_empty():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Salary", "3000.00", "income"),
+        tx(date(2026, 1, 2), "Zero", "0.00", "misc"),
+    )
+
+    assert largest_expenses(ledger, n=10) == []
+
+
+def test_largest_expenses_does_not_mutate_ledger_order():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Small", "-5.00", "misc"),
+        tx(date(2026, 1, 2), "Large", "-100.00", "misc"),
+        tx(date(2026, 1, 3), "Medium", "-20.00", "misc"),
+    )
+    original = list(ledger.transactions)
+
+    largest_expenses(ledger, n=2)
+
+    assert ledger.transactions == original
+
+
+def test_largest_expenses_ties_stable_in_original_order():
+    first = tx(date(2026, 1, 1), "First tie", "-50.00", "misc")
+    second = tx(date(2026, 1, 2), "Second tie", "-50.00", "misc")
+    ledger = make_ledger(first, second)
+
+    expenses = largest_expenses(ledger, n=2)
+
+    assert [t.description for t in expenses] == ["First tie", "Second tie"]
+
+
+def test_largest_expenses_includes_large_negative_across_categories():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Rent", "-1200.00", "housing"),
+        tx(date(2026, 1, 2), "Food", "-300.00", "food"),
+        tx(date(2026, 1, 3), "Transport", "-80.00", "transport"),
+        tx(date(2026, 1, 4), "Salary", "5000.00", "income"),
+    )
+
+    assert [t.description for t in largest_expenses(ledger, n=2)] == ["Rent", "Food"]
+
+
+def test_largest_expenses_single_cent_amounts_sorted_numerically():
+    ledger = make_ledger(
+        tx(date(2026, 1, 1), "Nine cents", "-0.09", "misc"),
+        tx(date(2026, 1, 2), "One dollar", "-1.00", "misc"),
+        tx(date(2026, 1, 3), "Ten cents", "-0.10", "misc"),
+    )
+
+    assert [t.description for t in largest_expenses(ledger, n=3)] == [
+        "One dollar",
+        "Ten cents",
+        "Nine cents",
+    ]
