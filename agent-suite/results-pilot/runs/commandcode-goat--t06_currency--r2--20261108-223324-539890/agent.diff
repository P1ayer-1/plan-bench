index 0f3c778..1072833 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,31 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return monthly category totals.
+
+    Months containing a single currency use ``category`` keys.  Months with
+    more than one currency use ``(category, currency)`` tuple keys so that
+    amounts in different currencies are never added together.
+    """
+    totals = {}
+    currencies = {}
     for tx in ledger.transactions:
-        m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        month = f"{tx.date.year:04d}-{tx.date.month:02d}"
+        totals.setdefault(month, {})
+        currencies.setdefault(month, set()).add(tx.amount.currency)
+        key = (tx.category, tx.amount.currency)
+        if key not in totals[month]:
+            totals[month][key] = Money.zero(tx.amount.currency)
+        totals[month][key] = totals[month][key] + tx.amount
+
+    result = {}
+    for month, cats in totals.items():
+        if len(currencies[month]) > 1:
+            result[month] = cats
+        else:
+            result[month] = {
+                category: total for (category, _currency), total in cats.items()
+            }
     return dict(sorted(result.items()))
 
 
