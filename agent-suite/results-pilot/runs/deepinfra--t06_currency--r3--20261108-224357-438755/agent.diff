+
+
+def test_currency_mismatch():
+    import pytest
+    from ledger import CurrencyMismatch
+    with pytest.raises(CurrencyMismatch):
+        Money("1", "USD") + Money("1", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        Money("1", "USD") - Money("1", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        Money("1", "USD") < Money("1", "EUR")
+
+
+def test_mixed_currency_balance_and_summary():
+    from datetime import date
+    txs = [
+        Transaction(date(2026, 1, 1), "a", Money("1", "USD"), "food"),
+        Transaction(date(2026, 1, 2), "b", Money("2", "EUR"), "food"),
+        Transaction(date(2026, 2, 1), "c", Money("3", "USD"), "food"),
+    ]
+    l = Ledger(txs)
+    assert l.balance() == {"USD": Money("4"), "EUR": Money("2", "EUR")}
+    assert Ledger().balance() == {}
+    s = monthly_summary(l)
+    assert s["2026-01"][("food", "USD")] == Money("1")
+    assert s["2026-01"][("food", "EUR")] == Money("2", "EUR")
+    assert s["2026-02"]["food"] == Money("3")
