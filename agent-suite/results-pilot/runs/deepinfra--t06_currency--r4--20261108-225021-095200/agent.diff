+def test_currency_mismatch_raises():
+    import pytest
+    from ledger import CurrencyMismatch
+    usd, eur = Money("1.00", "USD"), Money("1.00", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        usd + eur
+    with pytest.raises(CurrencyMismatch):
+        usd - eur
+    with pytest.raises(CurrencyMismatch):
+        usd < eur
+
+
+def test_balance_multi_currency():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("10.00", "USD"), "x"),
+        Transaction(date(2026, 1, 2), "b", Money("5.00", "EUR"), "x"),
+        Transaction(date(2026, 1, 3), "c", Money("2.00", "USD"), "x"),
+    ])
+    assert l.balance() == {"USD": Money("12.00", "USD"), "EUR": Money("5.00", "EUR")}
+    assert Ledger().balance() == {}
+
+
+def test_monthly_summary_mixed():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("10.00", "USD"), "food"),
+        Transaction(date(2026, 1, 2), "b", Money("5.00", "EUR"), "food"),
+        Transaction(date(2026, 2, 1), "c", Money("7.00", "USD"), "food"),
+    ])
+    s = monthly_summary(l)
+    assert s["2026-01"] == {
+        ("food", "USD"): Money("10.00", "USD"),
+        ("food", "EUR"): Money("5.00", "EUR"),
+    }
+    assert s["2026-02"] == {"food": Money("7.00", "USD")}
