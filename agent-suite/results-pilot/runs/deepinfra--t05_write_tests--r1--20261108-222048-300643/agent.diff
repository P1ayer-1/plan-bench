+from datetime import date
+
+import pytest
+
+from ledger import Ledger, Money, Transaction
+from ledger.report import largest_expenses, monthly_summary
+
+
+def tx(year, month, day, amount, category="misc", description="tx"):
+    return Transaction(
+        date=date(year, month, day),
+        description=description,
+        amount=Money(amount),
+        category=category,
+    )
+
+
+def ledger(*transactions):
+    return Ledger(list(transactions))
+
+
+def amounts(items):
+    return [item.amount.amount for item in items]
+
+
+class TestMonthlySummary:
+    def test_empty_ledger_returns_empty_dict(self):
+        assert monthly_summary(Ledger()) == {}
+
+    def test_groups_transactions_by_year_and_month(self):
+        l = ledger(
+            tx(2026, 1, 3, "-4.50", "food"),
+            tx(2026, 2, 1, "-1200.00", "housing"),
+            tx(2026, 1, 15, "3000.00", "income"),
+        )
+        summary = monthly_summary(l)
+        assert list(summary) == ["2026-01", "2026-02"]
+        assert set(summary["2026-01"]) == {"food", "income"}
+        assert set(summary["2026-02"]) == {"housing"}
+
+    def test_sums_same_category_within_month(self):
+        l = ledger(
+            tx(2026, 1, 3, "-4.50", "food"),
+            tx(2026, 1, 9, "-10.25", "food"),
+            tx(2026, 1, 20, "-0.25", "food"),
+        )
+        assert monthly_summary(l)["2026-01"]["food"] == Money("-15.00")
+
+    def test_sums_mixed_signs(self):
+        l = ledger(
+            tx(2026, 3, 1, "-100.00", "food"),
+            tx(2026, 3, 2, "30.50", "food"),
+        )
+        assert monthly_summary(l)["2026-03"]["food"] == Money("-69.50")
+
+    def test_categories_kept_separate_within_month(self):
+        l = ledger(
+            tx(2026, 1, 1, "-10.00", "food"),
+            tx(2026, 1, 2, "-20.00", "travel"),
+        )
+        summary = monthly_summary(l)
+        assert summary["2026-01"]["food"] == Money("-10.00")
+        assert summary["2026-01"]["travel"] == Money("-20.00")
+
+    def test_same_category_separated_across_months(self):
+        l = ledger(
+            tx(2026, 1, 31, "-10.00", "food"),
+            tx(2026, 2, 1, "-20.00", "food"),
+        )
+        summary = monthly_summary(l)
+        assert summary["2026-01"]["food"] == Money("-10.00")
+        assert summary["2026-02"]["food"] == Money("-20.00")
+
+    def test_year_boundary_is_distinct_month(self):
+        l = ledger(
+            tx(2025, 12, 31, "-10.00", "food"),
+            tx(2026, 1, 1, "-20.00", "food"),
+        )
+        summary = monthly_summary(l)
+        assert list(summary) == ["2025-12", "2026-01"]
+        assert summary["2025-12"]["food"] == Money("-10.00")
+        assert summary["2026-01"]["food"] == Money("-20.00")
+
+    def test_months_are_zero_padded(self):
+        l = ledger(tx(2026, 9, 5, "-1.00"), tx(2026, 10, 5, "-2.00"))
+        assert list(monthly_summary(l)) == ["2026-09", "2026-10"]
+
+    def test_result_keys_sorted_chronologically_not_by_insertion(self):
+        l = ledger(
+            tx(2026, 5, 1, "-1.00"),
+            tx(2025, 11, 1, "-2.00"),
+            tx(2026, 1, 1, "-3.00"),
+            tx(2025, 2, 1, "-4.00"),
+        )
+        assert list(monthly_summary(l)) == [
+            "2025-02",
+            "2025-11",
+            "2026-01",
+            "2026-05",
+        ]
+
+    def test_all_transactions_in_one_month(self):
+        l = ledger(tx(2026, 4, 1, "-1.10"), tx(2026, 4, 30, "-2.20"))
+        summary = monthly_summary(l)
+        assert list(summary) == ["2026-04"]
+        assert summary["2026-04"]["misc"] == Money("-3.30")
+
+    def test_does_not_mutate_ledger(self):
+        l = ledger(tx(2026, 1, 1, "-5.00", "food"))
+        before = list(l.transactions)
+        monthly_summary(l)
+        assert l.transactions == before
+
+    def test_handles_many_categories_and_decimal_precision(self):
+        l = ledger(
+            tx(2026, 7, 1, "0.10", "a"),
+            tx(2026, 7, 2, "0.20", "a"),
+            tx(2026, 7, 3, "0.30", "a"),
+        )
+        assert monthly_summary(l)["2026-07"]["a"] == Money("0.60")
+
+
+class TestLargestExpenses:
+    def test_empty_ledger_returns_empty_list(self):
+        assert largest_expenses(Ledger()) == []
+
+    def test_only_negative_transactions_considered(self):
+        l = ledger(
+            tx(2026, 1, 1, "100.00", "income"),
+            tx(2026, 1, 2, "-50.00", "food"),
+            tx(2026, 1, 3, "0.00", "misc"),
+        )
+        result = largest_expenses(l)
+        assert amounts(result) == [Money("-50.00").amount]
+
+    def test_most_negative_first(self):
+        l = ledger(
+            tx(2026, 1, 1, "-10.00", "a"),
+            tx(2026, 1, 2, "-100.00", "b"),
+            tx(2026, 1, 3, "-50.00", "c"),
+        )
+        result = largest_expenses(l)
+        assert [t.category for t in result] == ["b", "c", "a"]
+
+    def test_default_n_is_three(self):
+        l = ledger(*[tx(2026, 1, i + 1, f"-{i + 1}.00") for i in range(5)])
+        result = largest_expenses(l)
+        assert len(result) == 3
+        assert amounts(result) == [
+            Money("-5.00").amount,
+            Money("-4.00").amount,
+            Money("-3.00").amount,
+        ]
+
+    def test_custom_n(self):
+        l = ledger(*[tx(2026, 1, i + 1, f"-{i + 1}.00") for i in range(5)])
+        assert len(largest_expenses(l, n=2)) == 2
+        assert len(largest_expenses(l, n=10)) == 5
+
+    def test_n_zero_returns_nothing(self):
+        l = ledger(tx(2026, 1, 1, "-10.00"))
+        assert largest_expenses(l, n=0) == []
+
+    def test_n_larger_than_expense_count(self):
+        l = ledger(tx(2026, 1, 1, "-10.00"), tx(2026, 1, 2, "-5.00"))
+        result = largest_expenses(l, n=100)
+        assert len(result) == 2
+
+    def test_sign_handling_ignores_positive_even_if_large(self):
+        l = ledger(
+            tx(2026, 1, 1, "5000.00", "income"),
+            tx(2026, 1, 2, "-1.00", "food"),
+            tx(2026, 1, 3, "-2.00", "food"),
+        )
+        result = largest_expenses(l)
+        assert amounts(result) == [Money("-2.00").amount, Money("-1.00").amount]
+
+    def test_no_positive_transactions_returns_empty(self):
+        l = ledger(tx(2026, 1, 1, "10.00"), tx(2026, 1, 2, "20.00"))
+        assert largest_expenses(l) == []
+
+    def test_results_are_original_transactions(self):
+        cheap = tx(2026, 1, 1, "-5.00", "a", "cheap")
+        pricey = tx(2026, 1, 2, "-50.00", "b", "pricey")
+        result = largest_expenses(ledger(cheap, pricey), n=1)
+        assert result == [pricey]
+        assert result[0] is pricey
+
+    def test_does_not_mutate_ledger_order(self):
+        l = ledger(
+            tx(2026, 1, 1, "-10.00"),
+            tx(2026, 1, 2, "-100.00"),
+        )
+        before = list(l.transactions)
+        largest_expenses(l)
+        assert l.transactions == before
+
+    def test_negative_values_with_equal_amounts_are_all_included_when_n_allows(self):
+        l = ledger(
+            tx(2026, 1, 1, "-10.00", "a"),
+            tx(2026, 1, 2, "-10.00", "b"),
+        )
+        result = largest_expenses(l, n=2)
+        assert len(result) == 2
+        assert all(t.amount == Money("-10.00") for t in result)
