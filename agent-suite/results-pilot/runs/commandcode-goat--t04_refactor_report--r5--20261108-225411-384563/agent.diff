+def category_share(ledger, month):
+    """Return {category: fraction} of a month's total spending.
+
+    Only negative amounts count as spending, compared by absolute value.
+    Categories without spending are omitted; a month with no spending is {}.
+    """
+    spending = {}
+    for tx in group_by_month(ledger.transactions).get(month, []):
+        if tx.amount.amount < 0:
+            spent = -tx.amount
+            if tx.category not in spending:
+                spending[tx.category] = Money.zero(spent.currency)
+            spending[tx.category] = spending[tx.category] + spent
+
+    total = sum((money.amount for money in spending.values()), Decimal("0"))
+    if total == 0:
+        return {}
+    return {category: float(money.amount / total) for category, money in spending.items()}
+
