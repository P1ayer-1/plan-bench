@@ -0,0 +1,288 @@
+from datetime import date
+
+import pytest
+
+from ledger import Ledger, Money, Transaction
+from ledger.report import largest_expenses, monthly_summary
+
+
+def tx(day, amount, category="general", description="tx", currency="USD"):
+    return Transaction(
+        date=day,
+        description=description,
+        amount=Money(amount, currency),
+        category=category,
+    )
+
+
+# ---------------------------------------------------------------------------
+# monthly_summary
+# ---------------------------------------------------------------------------
+
+
+def test_monthly_summary_empty_ledger():
+    assert monthly_summary(Ledger()) == {}
+
+
+def test_monthly_summary_groups_by_year_and_month():
+    ledger = Ledger(
+        [
+            tx(date(2025, 1, 31), "-10.00", "food"),
+            tx(date(2026, 1, 1), "-20.00", "food"),
+            tx(date(2026, 1, 15), "-30.00", "food"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2025-01", "2026-01"]
+    assert summary["2025-01"]["food"] == Money("-10.00")
+    assert summary["2026-01"]["food"] == Money("-50.00")
+
+
+def test_monthly_summary_zero_pads_month_and_sorts_chronologically():
+    ledger = Ledger(
+        [
+            tx(date(2026, 10, 1), "-1.00", "a"),
+            tx(date(2026, 2, 1), "-2.00", "a"),
+            tx(date(2026, 1, 1), "-3.00", "a"),
+            tx(date(2026, 9, 1), "-4.00", "a"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01", "2026-02", "2026-09", "2026-10"]
+    assert all(len(month) == 7 and month[4] == "-" for month in summary)
+
+
+def test_monthly_summary_does_not_merge_same_named_months_across_years():
+    ledger = Ledger(
+        [
+            tx(date(2024, 5, 1), "-1.00", "x"),
+            tx(date(2025, 5, 1), "-2.00", "x"),
+            tx(date(2026, 5, 1), "-3.00", "x"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2024-05", "2025-05", "2026-05"]
+    assert [summary[m]["x"] for m in summary] == [
+        Money("-1.00"),
+        Money("-2.00"),
+        Money("-3.00"),
+    ]
+
+
+def test_monthly_summary_sums_each_category_separately_within_month():
+    ledger = Ledger(
+        [
+            tx(date(2026, 3, 1), "-5.00", "food"),
+            tx(date(2026, 3, 2), "-7.50", "transport"),
+            tx(date(2026, 3, 3), "-2.50", "food"),
+            tx(date(2026, 3, 4), "10.00", "transport"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary == {
+        "2026-03": {
+            "food": Money("-7.50"),
+            "transport": Money("2.50"),
+        }
+    }
+
+
+def test_monthly_summary_nets_positive_and_negative_amounts():
+    ledger = Ledger(
+        [
+            tx(date(2026, 6, 1), "-100.00", "income"),
+            tx(date(2026, 6, 2), "250.00", "income"),
+            tx(date(2026, 6, 3), "-25.00", "income"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-06"]["income"] == Money("125.00")
+
+
+def test_monthly_summary_only_includes_months_with_transactions():
+    ledger = Ledger(
+        [
+            tx(date(2026, 1, 1), "-1.00", "a"),
+            tx(date(2026, 4, 1), "-2.00", "a"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01", "2026-04"]
+    assert "2026-02" not in summary
+    assert "2026-03" not in summary
+
+
+def test_monthly_summary_preserves_transaction_currency():
+    ledger = Ledger(
+        [
+            tx(date(2026, 7, 1), "-10.00", "travel", currency="EUR"),
+            tx(date(2026, 7, 2), "-5.00", "travel", currency="EUR"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-07"]["travel"] == Money("-15.00", "EUR")
+    assert summary["2026-07"]["travel"].currency == "EUR"
+
+
+def test_monthly_summary_returns_money_values_not_raw_numbers():
+    ledger = Ledger([tx(date(2026, 8, 1), "-9.99", "misc")])
+
+    value = monthly_summary(ledger)["2026-08"]["misc"]
+
+    assert isinstance(value, Money)
+    assert value == Money("-9.99")
+
+
+def test_monthly_summary_category_with_same_name_in_different_months():
+    ledger = Ledger(
+        [
+            tx(date(2026, 1, 1), "-1.00", "food"),
+            tx(date(2026, 2, 1), "-2.00", "food"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["food"] == Money("-1.00")
+    assert summary["2026-02"]["food"] == Money("-2.00")
+
+
+def test_monthly_summary_aggregates_many_transactions_with_cents():
+    ledger = Ledger(
+        [tx(date(2026, 12, i + 1), "-0.10", "fees") for i in range(10)]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-12"]["fees"] == Money("-1.00")
+
+
+# ---------------------------------------------------------------------------
+# largest_expenses
+# ---------------------------------------------------------------------------
+
+
+def test_largest_expenses_empty_ledger():
+    assert largest_expenses(Ledger()) == []
+
+
+def test_largest_expenses_ignores_income_and_zero_amounts():
+    salary = tx(date(2026, 1, 1), "3000.00", "income")
+    zero = tx(date(2026, 1, 2), "0.00", "misc")
+    coffee = tx(date(2026, 1, 3), "-4.50", "food")
+    rent = tx(date(2026, 1, 4), "-1200.00", "housing")
+
+    result = largest_expenses(Ledger([salary, zero, coffee, rent]))
+
+    assert result == [rent, coffee]
+    assert salary not in result
+    assert zero not in result
+
+
+def test_largest_expenses_sorted_most_negative_first():
+    small = tx(date(2026, 2, 1), "-1.00", "a")
+    medium = tx(date(2026, 2, 2), "-50.00", "a")
+    large = tx(date(2026, 2, 3), "-500.00", "a")
+
+    result = largest_expenses(Ledger([small, large, medium]))
+
+    assert result == [large, medium, small]
+
+
+def test_largest_expenses_returns_at_most_n_by_default_three():
+    transactions = [tx(date(2026, 3, i + 1), f"-{i + 1}.00", "a") for i in range(6)]
+
+    result = largest_expenses(Ledger(transactions))
+
+    assert [t.amount for t in result] == [
+        Money("-6.00"),
+        Money("-5.00"),
+        Money("-4.00"),
+    ]
+    assert len(result) == 3
+
+
+def test_largest_expenses_respects_explicit_n():
+    transactions = [tx(date(2026, 4, i + 1), f"-{i + 1}.00", "a") for i in range(6)]
+
+    result = largest_expenses(Ledger(transactions), n=2)
+
+    assert [t.amount for t in result] == [Money("-6.00"), Money("-5.00")]
+    assert len(result) == 2
+
+
+def test_largest_expenses_returns_all_expenses_when_fewer_than_n():
+    transactions = [
+        tx(date(2026, 5, 1), "-10.00", "a"),
+        tx(date(2026, 5, 2), "-20.00", "a"),
+    ]
+
+    result = largest_expenses(Ledger(transactions), n=10)
+
+    assert [t.amount for t in result] == [Money("-20.00"), Money("-10.00")]
+
+
+def test_largest_expenses_n_zero_returns_empty_list():
+    transactions = [tx(date(2026, 6, 1), "-10.00", "a")]
+
+    assert largest_expenses(Ledger(transactions), n=0) == []
+
+
+def test_largest_expenses_does_not_mutate_ledger():
+    transactions = [
+        tx(date(2026, 7, 1), "-1.00", "a"),
+        tx(date(2026, 7, 2), "-2.00", "a"),
+        tx(date(2026, 7, 3), "3.00", "a"),
+    ]
+    ledger = Ledger(transactions)
+    original = list(ledger.transactions)
+
+    largest_expenses(ledger, n=1)
+
+    assert ledger.transactions == original
+    assert len(ledger.transactions) == 3
+
+
+def test_largest_expenses_returns_transaction_instances():
+    first = tx(date(2026, 8, 1), "-1.00", "a", description="first")
+    second = tx(date(2026, 8, 2), "-2.00", "a", description="second")
+
+    result = largest_expenses(Ledger([first, second]))
+
+    assert [t.description for t in result] == ["second", "first"]
+    assert all(isinstance(t, Transaction) for t in result)
+    assert result[0] is second
+    assert result[1] is first
+
+
+@pytest.mark.parametrize(
+    "amounts, expected",
+    [
+        (["-0.01"], ["-0.01"]),
+        (["-0.02", "-0.01"], ["-0.02", "-0.01"]),
+        (["-10.00", "-9.99", "-9.98"], ["-10.00", "-9.99", "-9.98"]),
+        (["-100.00", "-20.00", "-3.00", "-0.50"], ["-100.00", "-20.00", "-3.00"]),
+    ],
+)
+def test_largest_expenses_various_amounts(amounts, expected):
+    ledger = Ledger(
+        [tx(date(2026, 9, i + 1), amount, "a") for i, amount in enumerate(amounts)]
+    )
+
+    result = largest_expenses(ledger)
+
+    assert [t.amount for t in result] == [Money(a) for a in expected]
