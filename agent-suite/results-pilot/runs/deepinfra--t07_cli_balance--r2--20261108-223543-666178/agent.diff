+def test_cli_balance(tmp_path, capsys):
+    from ledger.cli import main
+    p = tmp_path / "t.csv"
+    p.write_text(CSV)
+    assert main(["balance", str(p)]) == 0
+    assert capsys.readouterr().out == "Balance: 1795.50 USD\n"
+    assert main(["balance", str(p), "--since", "2026-02-01", "--until", "2026-02-28"]) == 0
+    assert capsys.readouterr().out == "Balance: -1200.00 USD\n"
+    assert main(["balance", str(p), "--category", "food"]) == 0
+    assert capsys.readouterr().out == "Balance: -4.50 USD\n"
+    assert main(["balance", str(p), "--category", "nope"]) == 0
+    assert capsys.readouterr().out == "Balance: 0.00 USD\n"
+
+
+def test_cli_balance_invalid_date(tmp_path, capsys):
+    import pytest
+    from ledger.cli import main
+    p = tmp_path / "t.csv"
+    p.write_text(CSV)
+    with pytest.raises(SystemExit) as exc:
+        main(["balance", str(p), "--since", "not-a-date"])
+    assert exc.value.code == 2
+    assert capsys.readouterr().err
