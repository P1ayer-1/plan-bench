--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,27 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    When a month contains more than one currency, keys are
+    (category, currency) tuples instead of plain category names.
+    """
+    by_month = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        by_month.setdefault(m, []).append(tx)
+
+    result = {}
+    for m, txs in by_month.items():
+        currencies = {tx.amount.currency for tx in txs}
+        prefix_keys = len(currencies) > 1
+        groups = {}
+        for tx in txs:
+            key = (tx.category, tx.amount.currency) if prefix_keys else tx.category
+            if key not in groups:
+                groups[key] = Money.zero(tx.amount.currency)
+            groups[key] = groups[key] + tx.amount
+        result[m] = groups
     return dict(sorted(result.items()))
 
 
