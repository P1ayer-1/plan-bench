@@ -0,0 +1,178 @@
+from dataclasses import dataclass, field
+from typing import List, Tuple
+
+
+@dataclass
+class Reconciliation:
+    matched: List[Tuple[object, object]] = field(default_factory=list)
+    unmatched_ledger: List[object] = field(default_factory=list)
+    unmatched_bank: List[object] = field(default_factory=list)
+
+
+def _days_between(a, b):
+    return abs((a - b).days)
+
+
+def _min_cost_assignment(cost):
+    """Minimum-cost rectangular assignment via the Hungarian algorithm.
+
+    ``cost`` is an n x m matrix of integers. Returns a list of (row, col)
+    pairs covering min(n, m) rows/columns with minimum total cost.
+    """
+    n = len(cost)
+    if n == 0:
+        return []
+    m = len(cost[0])
+    if m == 0:
+        return []
+
+    transposed = False
+    if n > m:
+        cost = [[cost[i][j] for i in range(n)] for j in range(m)]
+        n, m = m, n
+        transposed = True
+
+    INF = float("inf")
+    u = [0] * (n + 1)
+    v = [0] * (m + 1)
+    p = [0] * (m + 1)
+    way = [0] * (m + 1)
+    for i in range(1, n + 1):
+        p[0] = i
+        j0 = 0
+        minv = [INF] * (m + 1)
+        used = [False] * (m + 1)
+        while True:
+            used[j0] = True
+            i0 = p[j0]
+            delta = INF
+            j1 = 0
+            row = cost[i0 - 1]
+            ui = u[i0]
+            for j in range(1, m + 1):
+                if not used[j]:
+                    cur = row[j - 1] - ui - v[j]
+                    if cur < minv[j]:
+                        minv[j] = cur
+                        way[j] = j0
+                    if minv[j] < delta:
+                        delta = minv[j]
+                        j1 = j
+            for j in range(m + 1):
+                if used[j]:
+                    u[p[j]] += delta
+                    v[j] -= delta
+                else:
+                    minv[j] -= delta
+            j0 = j1
+            if p[j0] == 0:
+                break
+        while True:
+            j1 = way[j0]
+            p[j0] = p[j1]
+            j0 = j1
+            if j0 == 0:
+                break
+
+    result = []
+    for j in range(1, m + 1):
+        if p[j] != 0:
+            row = p[j] - 1
+            col = j - 1
+            if transposed:
+                result.append((col, row))
+            else:
+                result.append((row, col))
+    result.sort()
+    return result
+
+
+def reconcile(ledger_txs, bank_txs, max_days=3):
+    ledger_txs = list(ledger_txs)
+    bank_txs = list(bank_txs)
+
+    bank_by_amount = {}
+    for j, btx in enumerate(bank_txs):
+        bank_by_amount.setdefault(btx.amount, []).append(j)
+
+    ledger_groups = {}
+    for i, ltx in enumerate(ledger_txs):
+        cand = bank_by_amount.get(ltx.amount)
+        if not cand:
+            continue
+        feasible = []
+        for j in cand:
+            d = _days_between(ltx.date, bank_txs[j].date)
+            if d <= max_days:
+                feasible.append((j, d))
+        if feasible:
+            ledger_groups[i] = feasible
+
+    group_items = sorted(ledger_groups.items())
+
+    parent = {}
+
+    def find(x):
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+
+    def union(a, b):
+        ra, rb = find(a), find(b)
+        if ra != rb:
+            parent[rb] = ra
+
+    for li, feasible in group_items:
+        parent.setdefault(("l", li), ("l", li))
+        for j, _ in feasible:
+            parent.setdefault(("b", j), ("b", j))
+            union(("l", li), ("b", j))
+
+    components = {}
+    for li, feasible in group_items:
+        root = find(("l", li))
+        components.setdefault(root, []).append((li, feasible))
+
+    matched_pairs = []
+
+    for root in sorted(components):
+        rows = []
+        row_feas = []
+        cand_bank = set()
+        for li, feasible in components[root]:
+            rows.append(li)
+            row_feas.append(feasible)
+            cand_bank.update(j for j, _ in feasible)
+
+        paired_items = sorted(zip(rows, row_feas), key=lambda it: it[0])
+        rows = [it[0] for it in paired_items]
+        row_feas = [it[1] for it in paired_items]
+        cols = sorted(cand_bank)
+        col_index = {j: k for k, j in enumerate(cols)}
+        n, m = len(rows), len(cols)
+
+        BIG = 10 ** 9
+        if n <= m:
+            cost = [[BIG] * m for _ in range(n)]
+            for r, feas in enumerate(row_feas):
+                for j, d in feas:
+                    cost[r][col_index[j]] = d
+            assign = _min_cost_assignment(cost)
+        else:
+            cost = [[BIG] * n for _ in range(m)]
+            for r, feas in enumerate(row_feas):
+                for j, d in feas:
+                    cost[col_index[j]][r] = d
+            assign = [(r, c) for c, r in _min_cost_assignment(cost)]
+
+        for r, c in assign:
+            matched_pairs.append((rows[r], cols[c]))
+
+    matched_pairs.sort()
+    matched = [(ledger_txs[i], bank_txs[j]) for i, j in matched_pairs]
+    matched_ledger = {i for i, _ in matched_pairs}
+    matched_bank = {j for _, j in matched_pairs}
+    unmatched_ledger = [tx for i, tx in enumerate(ledger_txs) if i not in matched_ledger]
+    unmatched_bank = [tx for j, tx in enumerate(bank_txs) if j not in matched_bank]
+    return Reconciliation(matched, unmatched_ledger, unmatched_bank)
