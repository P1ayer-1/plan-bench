@@ -0,0 +1,75 @@
+from datetime import date, timedelta
+
+from ledger import Money, Transaction
+from ledger.reconcile import Reconciliation, reconcile
+
+
+def tx(day, amount, desc="x", currency="USD"):
+    return Transaction(
+        date=date(2026, 1, 1) + timedelta(days=day),
+        description=desc,
+        amount=Money(amount, currency),
+        category="c",
+    )
+
+
+def test_simple_match():
+    l = tx(0, "5.00")
+    b = tx(1, "5.00")
+    r = reconcile([l], [b], max_days=3)
+    assert isinstance(r, Reconciliation)
+    assert r.matched == [(l, b)]
+    assert r.unmatched_ledger == []
+    assert r.unmatched_bank == []
+
+
+def test_beyond_max_days_not_matched():
+    l = tx(0, "5.00")
+    b = tx(4, "5.00")
+    r = reconcile([l], [b], max_days=3)
+    assert r.matched == []
+    assert r.unmatched_ledger == [l]
+    assert r.unmatched_bank == [b]
+
+
+def test_amount_and_currency_must_match():
+    l = tx(0, "5.00")
+    r = reconcile([l], [tx(0, "5.01")], 3)
+    assert r.matched == []
+    r = reconcile([l], [tx(0, "5.00", currency="EUR")], 3)
+    assert r.matched == []
+
+
+def test_borrows_other_amount_and_leaves_unmatched():
+    l = [tx(0, "5.00"), tx(1, "7.00")]
+    b = [tx(0, "5.00")]
+    r = reconcile(l, b, 3)
+    assert r.matched == [(l[0], b[0])]
+    assert r.unmatched_ledger == [l[1]]
+    assert r.unmatched_bank == []
+
+
+def test_duplicates_are_distinct_and_best_distance_chosen():
+    l = [tx(0, "5.00"), tx(3, "5.00")]
+    b = [tx(2, "5.00")]
+    r = reconcile(l, b, 3)
+    assert r.matched == [(l[1], b[0])]
+    assert r.unmatched_ledger == [l[0]]
+
+
+def test_matched_ordered_by_ledger_and_unmatched_by_input():
+    l = [tx(10, "1.00"), tx(0, "2.00"), tx(20, "3.00")]
+    b = [tx(1, "2.00"), tx(11, "1.00"), tx(30, "4.00")]
+    r = reconcile(l, b, 3)
+    assert r.matched == [(l[0], b[1]), (l[1], b[0])]
+    assert r.unmatched_ledger == [l[2]]
+    assert r.unmatched_bank == [b[2]]
+
+
+def test_maximizes_cardinality_then_minimizes_distance():
+    l = [tx(0, "5.00"), tx(2, "5.00")]
+    b = [tx(1, "5.00"), tx(3, "5.00")]
+    r = reconcile(l, b, 3)
+    assert len(r.matched) == 2
+    total = sum(abs((a.date - c.date).days) for a, c in r.matched)
+    assert total == 2
