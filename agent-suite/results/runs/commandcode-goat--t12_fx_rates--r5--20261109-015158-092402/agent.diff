+from bisect import bisect_right
+from datetime import date
+from decimal import Decimal
+
+from .money import Money
+
+
+def _to_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+class RateTable:
+    """Historical exchange rates, stored as exact Decimals."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        rate = _to_decimal(rate)
+        entries = self._rates.setdefault((base, quote), [])
+        dates = [d for d, _ in entries]
+        i = bisect_right(dates, on)
+        if i > 0 and entries[i - 1][0] == on:
+            entries[i - 1] = (on, rate)
+        else:
+            entries.insert(i, (on, rate))
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        dates = [d for d, _ in entries]
+        i = bisect_right(dates, on)
+        if i == 0:
+            return None
+        return entries[i - 1][1]
+
+    def _lookup(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        rate = self._latest(base, quote, on)
+        if rate is not None:
+            return rate
+        rate = self._latest(quote, base, on)
+        if rate is not None:
+            return Decimal(1) / rate
+        return None
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        if base == quote:
+            return Decimal(1)
+        rate = self._lookup(base, quote, on)
+        if rate is not None:
+            return rate
+        via_usd_base = self._lookup(base, "USD", on)
+        via_usd_quote = self._lookup("USD", quote, on)
+        if via_usd_base is not None and via_usd_quote is not None:
+            return via_usd_base * via_usd_quote
+        raise KeyError((base, quote, on))
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    rate = table.rate(money.currency, to, on)
+    return Money(money.amount * rate, to)
