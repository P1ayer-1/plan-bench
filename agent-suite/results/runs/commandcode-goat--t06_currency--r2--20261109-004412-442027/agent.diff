diff --git a/ledger/report.py b/ledger/report.py
index 0f3c778..0bcff43 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,32 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    If a month contains transactions in more than one currency, its keys are
+    ``(category, currency)`` tuples instead so amounts in different currencies
+    are never combined. Months with a single currency keep plain category keys.
+    """
+    grouped = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        month = grouped.setdefault(m, {})
+        currency = tx.amount.currency
+        cats = month.setdefault(currency, {})
+        if tx.category not in cats:
+            cats[tx.category] = Money.zero(currency)
+        cats[tx.category] = cats[tx.category] + tx.amount
+
+    result = {}
+    for m, by_currency in grouped.items():
+        if len(by_currency) == 1:
+            result[m] = next(iter(by_currency.values()))
+        else:
+            result[m] = {
+                (category, currency): total
+                for currency, cats in by_currency.items()
+                for category, total in cats.items()
+            }
     return dict(sorted(result.items()))
 
 
