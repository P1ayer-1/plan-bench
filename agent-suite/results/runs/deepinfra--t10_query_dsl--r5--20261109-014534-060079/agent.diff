@@ -0,0 +1,86 @@
+from datetime import date
+
+import pytest
+
+from ledger import Money, Ledger, Transaction
+
+
+TXS = [
+    Transaction(date(2026, 1, 3), "Coffee shop", Money("-4.50"), "Food", ("morning",)),
+    Transaction(date(2026, 1, 15), "Salary", Money("3000.00"), "income"),
+    Transaction(date(2026, 2, 1), "Rent", Money("-1200.00"), "housing", ("fixed", "monthly")),
+]
+
+
+def descriptions(query):
+    return [t.description for t in Ledger(TXS).search(query)]
+
+
+def test_empty_query_matches_all():
+    assert descriptions("") == ["Coffee shop", "Salary", "Rent"]
+    assert descriptions("   ") == ["Coffee shop", "Salary", "Rent"]
+
+
+def test_category_case_insensitive():
+    assert descriptions("category:food") == ["Coffee shop"]
+
+
+def test_tag_case_insensitive():
+    assert descriptions("tag:MONTHLY") == ["Rent"]
+
+
+def test_desc_substring_and_quotes():
+    assert descriptions("desc:coffee") == ["Coffee shop"]
+    assert descriptions('desc:"coffee shop"') == ["Coffee shop"]
+
+
+def test_amount_comparison():
+    assert descriptions("amount<-5") == ["Rent"]
+    assert descriptions("amount < -5") == ["Rent"]
+    assert descriptions("amount >= 10.50") == ["Salary"]
+    assert descriptions("amount=0") == []
+
+
+def test_date_comparison():
+    assert descriptions("date>=2026-02-01") == ["Rent"]
+    assert descriptions("date = 2026-01-03") == ["Coffee shop"]
+
+
+def test_implicit_and():
+    assert descriptions("category:food tag:work") == []
+    assert descriptions("category:food tag:morning") == ["Coffee shop"]
+
+
+def test_operators_and_precedence():
+    assert descriptions("amount<-5 OR category:food") == ["Coffee shop", "Rent"]
+    assert descriptions("NOT tag:fixed") == ["Coffee shop", "Salary"]
+    assert descriptions("category:food OR category:income AND tag:x") == ["Coffee shop"]
+
+
+def test_complex_query():
+    query = 'desc:"coffee shop" OR (category:housing AND NOT tag:work) amount<-5'
+    assert descriptions(query) == ["Coffee shop", "Rent"]
+
+
+def test_escapes():
+    assert descriptions(r'desc:"a\"b"') == []
+    assert descriptions(r'desc:"a\\b"') == []
+
+
+@pytest.mark.parametrize("query", [
+    "foo:bar",
+    "(category:food",
+    "category:food)",
+    "category:food AND",
+    "OR tag:x",
+    "NOT",
+    "()",
+    'desc:"unterminated',
+    "amount<x",
+    "amount>=",
+    "date>2026-13-01",
+    "amount <> 5",
+])
+def test_malformed_queries_raise(query):
+    with pytest.raises(ValueError):
+        Ledger(TXS).search(query)
