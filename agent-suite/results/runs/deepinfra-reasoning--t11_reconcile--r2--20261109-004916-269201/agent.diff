@@ -0,0 +1,116 @@
+from dataclasses import dataclass, field
+
+
+@dataclass
+class Reconciliation:
+    matched: list = field(default_factory=list)
+    unmatched_ledger: list = field(default_factory=list)
+    unmatched_bank: list = field(default_factory=list)
+
+
+def _amount_key(tx):
+    return (tx.amount.amount, tx.amount.currency)
+
+
+def _best_match_group(ledger_items, bank_items, max_days):
+    ledger_items = sorted(ledger_items, key=lambda item: item[1].date)
+    bank_items = sorted(bank_items, key=lambda item: item[1].date)
+
+    n = len(ledger_items)
+    m = len(bank_items)
+    counts = [[0] * (m + 1) for _ in range(n + 1)]
+    costs = [[0] * (m + 1) for _ in range(n + 1)]
+    choices = [[0] * (m + 1) for _ in range(n + 1)]
+
+    for i in range(1, n + 1):
+        ledger_date = ledger_items[i - 1][1].date
+        row_counts = counts[i]
+        prev_counts = counts[i - 1]
+        row_costs = costs[i]
+        prev_costs = costs[i - 1]
+        row_choices = choices[i]
+
+        for j in range(1, m + 1):
+            best_count = prev_counts[j]
+            best_cost = prev_costs[j]
+            best_choice = 1
+
+            if (row_counts[j - 1] > best_count or
+                    (row_counts[j - 1] == best_count and row_costs[j - 1] < best_cost)):
+                best_count = row_counts[j - 1]
+                best_cost = row_costs[j - 1]
+                best_choice = 2
+
+            bank_date = bank_items[j - 1][1].date
+            distance = abs((ledger_date - bank_date).days)
+            if distance <= max_days:
+                pair_count = prev_counts[j - 1] + 1
+                pair_cost = prev_costs[j - 1] + distance
+                if (pair_count > best_count or
+                        (pair_count == best_count and pair_cost < best_cost)):
+                    best_count = pair_count
+                    best_cost = pair_cost
+                    best_choice = 3
+
+            row_counts[j] = best_count
+            row_costs[j] = best_cost
+            row_choices[j] = best_choice
+
+    pairs = []
+    i = n
+    j = m
+    while i > 0 and j > 0:
+        choice = choices[i][j]
+        if choice == 3:
+            pairs.append((ledger_items[i - 1][0], bank_items[j - 1][0]))
+            i -= 1
+            j -= 1
+        elif choice == 1:
+            i -= 1
+        elif choice == 2:
+            j -= 1
+        else:
+            break
+
+    return pairs
+
+
+def reconcile(ledger_txs, bank_txs, max_days=3):
+    ledger_txs = list(ledger_txs)
+    bank_txs = list(bank_txs)
+
+    ledger_groups = {}
+    for index, tx in enumerate(ledger_txs):
+        ledger_groups.setdefault(_amount_key(tx), []).append((index, tx))
+
+    bank_groups = {}
+    for index, tx in enumerate(bank_txs):
+        bank_groups.setdefault(_amount_key(tx), []).append((index, tx))
+
+    matched_indices = []
+    matched_ledger = set()
+    matched_bank = set()
+
+    for key, ledger_items in ledger_groups.items():
+        bank_items = bank_groups.get(key)
+        if not bank_items:
+            continue
+        for ledger_index, bank_index in _best_match_group(ledger_items, bank_items, max_days):
+            matched_indices.append((ledger_index, bank_index))
+            matched_ledger.add(ledger_index)
+            matched_bank.add(bank_index)
+
+    matched_indices.sort(key=lambda pair: pair[0])
+    matched = [(ledger_txs[i], bank_txs[j]) for i, j in matched_indices]
+    unmatched_ledger = [
+        tx for index, tx in enumerate(ledger_txs) if index not in matched_ledger
+    ]
+    unmatched_bank = [
+        tx for index, tx in enumerate(bank_txs) if index not in matched_bank
+    ]
+
+    return Reconciliation(
+        matched=matched,
+        unmatched_ledger=unmatched_ledger,
+        unmatched_bank=unmatched_bank,
+    )
