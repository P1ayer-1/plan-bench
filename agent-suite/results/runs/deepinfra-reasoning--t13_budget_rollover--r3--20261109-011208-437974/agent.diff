+import re
+
+from .money import Money
+
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+
+
+def _parse_month(value):
+    if not isinstance(value, str):
+        raise ValueError(f"invalid month: {value!r}")
+    match = _MONTH_RE.fullmatch(value)
+    if match is None:
+        raise ValueError(f"invalid month: {value!r}")
+    year, month = int(match.group(1)), int(match.group(2))
+    if not 1 <= month <= 12:
+        raise ValueError(f"invalid month: {value!r}")
+    return year * 12 + month - 1
+
+
+def _format_month(index):
+    year, month = divmod(index, 12)
+    return f"{year:04d}-{month + 1:02d}"
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    """Return monthly budget rows with optional rollover between months.
+
+    ``budgets`` maps category names to their monthly :class:`Money` budget.
+    The result maps each ``"YYYY-MM"`` in the inclusive range to a dict of
+    budgeted categories, each containing ``budget``, ``carried_in``,
+    ``spent``, ``available`` and ``remaining`` amounts.
+    """
+    start = _parse_month(start_month)
+    end = _parse_month(end_month)
+    if start > end:
+        raise ValueError("start_month must not be after end_month")
+
+    months = list(range(start, end + 1))
+
+    spent = {}
+    for tx in ledger.transactions:
+        if tx.category not in budgets:
+            continue
+        month = tx.date.year * 12 + tx.date.month - 1
+        if month < start or month > end:
+            continue
+        currency = budgets[tx.category].currency
+        if tx.amount.currency != currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r}: "
+                f"expected {currency}, got {tx.amount.currency}"
+            )
+        key = (month, tx.category)
+        if key not in spent:
+            spent[key] = Money.zero(currency)
+        spent[key] = spent[key] - tx.amount
+
+    result = {}
+    carried = {category: Money.zero(budget.currency) for category, budget in budgets.items()}
+
+    for index in months:
+        month = _format_month(index)
+        rows = {}
+        for category, budget in budgets.items():
+            carried_in = carried[category]
+            available = budget + carried_in
+            month_spent = spent.get((index, category), Money.zero(budget.currency))
+            remaining = available - month_spent
+
+            rows[category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": month_spent,
+                "available": available,
+                "remaining": remaining,
+            }
+
+            carry = remaining.amount
+            if carry < 0:
+                carry = 0
+            if rollover_cap is not None and carry > rollover_cap.amount:
+                carry = rollover_cap.amount
+            carried[category] = Money(carry, budget.currency)
+
+        result[month] = rows
+
+    return result
