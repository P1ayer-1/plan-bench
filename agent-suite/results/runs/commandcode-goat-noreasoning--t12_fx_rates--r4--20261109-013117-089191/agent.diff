+from datetime import date
+from decimal import Decimal, localcontext, ROUND_HALF_UP
+
+from .money import Money, CENT
+
+
+class RateTable:
+    """Historical exchange rates, potentially with multiple rates over time."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        with localcontext() as ctx:
+            ctx.prec = 28
+            value = rate if isinstance(rate, Decimal) else Decimal(str(rate))
+        self._rates.setdefault((base, quote), {})[on] = value
+
+    def _lookup(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        candidates = [d for d in entries if d <= on]
+        if not candidates:
+            return None
+        return entries[max(candidates)]
+
+    def rate(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        with localcontext() as ctx:
+            ctx.prec = 28
+            r = self._lookup(base, quote, on)
+            if r is not None:
+                return r
+            r = self._lookup(quote, base, on)
+            if r is not None:
+                return Decimal(1) / r
+            if base == "USD" or quote == "USD":
+                raise KeyError((base, quote, on))
+            left = self.rate(base, "USD", on)
+            right = self.rate("USD", quote, on)
+            return left * right
+
+
+def convert(money, to, table, on):
+    with localcontext() as ctx:
+        ctx.prec = 28
+        if money.currency == to:
+            amount = money.amount
+        else:
+            amount = money.amount * table.rate(money.currency, to, on)
+    return Money(amount.quantize(CENT, rounding=ROUND_HALF_UP), to)
