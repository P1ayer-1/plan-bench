+    def balance_in(self, currency, table, on=None):
+        from decimal import Decimal, localcontext, ROUND_HALF_UP
+        from .money import CENT
+        with localcontext() as ctx:
+            ctx.prec = 28
+            total = Decimal(0)
+            for tx in self.transactions:
