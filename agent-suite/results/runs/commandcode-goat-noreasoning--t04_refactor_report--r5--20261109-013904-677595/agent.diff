+def totals_by_category(transactions):
+    """Return {category: Money} summing amounts by category."""
+    result = {}
+    for tx in transactions:
+        if tx.category not in result:
+            result[tx.category] = Money.zero(tx.amount.currency)
+        result[tx.category] = result[tx.category] + tx.amount
+    return result
+
+
+def monthly_summary(ledger):
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
+    return {
+        month: totals_by_category(txs)
+        for month, txs in group_by_month(ledger.transactions).items()
+    }
+
+
+def category_share(ledger, month):
+    """Return {category: fraction} of that month's total spending (0..1)."""
+    txs = [tx for tx in ledger.transactions if _month_key(tx) == month]
+    spending = {tx.category: Money.zero(tx.amount.currency) for tx in txs if tx.amount.amount < 0}
+    for tx in txs:
+        if tx.amount.amount < 0:
+            spending[tx.category] = spending[tx.category] + tx.amount
+    total = sum((-m).amount for m in spending.values())
+    if total == 0:
+        return {}
+    return {
+        cat: float((-amount).amount / total)
+        for cat, amount in spending.items()
+    }
+
+
+def _month_key(tx):
+    return f"{tx.date.year:04d}-{tx.date.month:02d}"
+
