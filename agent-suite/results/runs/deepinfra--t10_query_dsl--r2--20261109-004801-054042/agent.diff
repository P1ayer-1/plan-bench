+++ b/tests/test_search.py
@@ -0,0 +1,87 @@
+from datetime import date
+import pytest
+from ledger import Money, Ledger, Transaction
+from ledger.parser import parse_csv
+
+CSV = """date,description,amount,category,tags
+2026-01-03,Coffee Shop,-4.50,food,morning
+2026-01-15,Salary,3000.00,income,
+2026-02-01,Rent,-1200.00,housing,fixed;monthly
+2026-02-02,Lunch,-12.50,food,work;Lunch
+"""
+
+
+def make():
+    return Ledger(parse_csv(CSV))
+
+
+def descs(ledger, query):
+    return [t.description for t in ledger.search(query)]
+
+
+def test_empty_matches_all():
+    l = make()
+    assert len(l.search("")) == 4
+    assert len(l.search("   ")) == 4
+
+
+def test_category_case_insensitive():
+    assert descs(make(), "category:FOOD") == ["Coffee Shop", "Lunch"]
+
+
+def test_tag_case_insensitive():
+    assert descs(make(), "tag:work") == ["Lunch"]
+    assert descs(make(), "tag:lunch") == ["Lunch"]
+
+
+def test_desc_substring():
+    assert descs(make(), 'desc:"coffee shop"') == ["Coffee Shop"]
+
+
+def test_amount_comparisons():
+    assert descs(make(), "amount<-20") == ["Rent"]
+    assert descs(make(), "amount >= 3000") == ["Salary"]
+    assert descs(make(), "amount=0") == []
+
+
+def test_date_comparison():
+    assert descs(make(), "date>=2026-02-01") == ["Rent", "Lunch"]
+
+
+def test_preserves_original_order():
+    assert descs(make(), "category:food OR tag:monthly") == [
+        "Coffee Shop", "Rent", "Lunch"]
+
+
+def test_implicit_and_precedence():
+    assert descs(make(), "category:food tag:work") == ["Lunch"]
+    l = make()
+    assert descs(l, "category:food OR tag:monthly category:housing") == [
+        "Coffee Shop", "Rent", "Lunch"]
+    assert descs(l, "NOT category:food") == ["Salary", "Rent"]
+
+
+def test_complex():
+    q = 'desc:"coffee shop" OR (category:food AND NOT tag:work) amount<-5'
+    assert descs(make(), q) == ["Coffee Shop"]
+    q2 = 'desc:"coffee shop" OR (category:food AND NOT tag:work) OR amount<-5'
+    assert descs(make(), q2) == ["Coffee Shop", "Rent", "Lunch"]
+
+
+def test_quoted_escapes():
+    l = Ledger([Transaction(date(2026, 1, 1), 'a "b" c', Money(1), "x", ())])
+    assert quers(l, 'desc:"a \\"b\\" c"') == ['a "b" c']
+
+
+def quers(l, q):
+    return [t.description for t in l.search(q)]
+
+
+@pytest.mark.parametrize("query", [
+    "foo:bar", "(category:food", "category:food)", "category:food AND",
+    "OR tag:x", "NOT", "amount!5", "amount<abc", "date>=2026-13-01",
+    'desc:"oops', "()",
+])
+def test_errors(query):
+    with pytest.raises(ValueError):
+        make().search(query)
