+from dataclasses import dataclass, field
+
+
+@dataclass
+class Reconciliation:
+    matched: list = field(default_factory=list)
+    unmatched_ledger: list = field(default_factory=list)
+    unmatched_bank: list = field(default_factory=list)
+
+
+def _better(candidate, current):
+    """Return True if (count, cost) candidate is better than current."""
+    if candidate[0] != current[0]:
+        return candidate[0] > current[0]
+    return candidate[1] < current[1]
+
+
+def _match_group(ledger_group, bank_group, max_days):
+    """Match two date-sorted groups of transactions sharing an amount.
+
+    Returns (ledger_index, ledger_tx, bank_index, bank_tx) tuples.
+    """
+    l = [(idx, tx, tx.date.toordinal()) for idx, tx in ledger_group]
+    b = [(idx, tx, tx.date.toordinal()) for idx, tx in bank_group]
+    l.sort(key=lambda item: item[2])
+    b.sort(key=lambda item: item[2])
+
+    n, m = len(l), len(b)
+    dp = [[(0, 0)] * (m + 1) for _ in range(n + 1)]
+
+    for i in range(1, n + 1):
+        ld = l[i - 1][2]
+        for j in range(1, m + 1):
+            best = dp[i - 1][j]
+            if _better(dp[i][j - 1], best):
+                best = dp[i][j - 1]
+
+            dist = abs(ld - b[j - 1][2])
+            if dist <= max_days:
+                prev = dp[i - 1][j - 1]
+                candidate = (prev[0] + 1, prev[1] + dist)
+                if _better(candidate, best):
+                    best = candidate
+
+            dp[i][j] = best
+
+    pairs = []
+    i, j = n, m
+    while i > 0 and j > 0:
+        ld = l[i - 1][2]
+        bd = b[j - 1][2]
+        dist = abs(ld - bd)
+        if dist <= max_days:
+            prev = dp[i - 1][j - 1]
+            candidate = (prev[0] + 1, prev[1] + dist)
+            if candidate == dp[i][j]:
+                li, ltx, _ = l[i - 1]
+                bi, btx, _ = b[j - 1]
+                pairs.append((li, ltx, bi, btx))
+                i -= 1
+                j -= 1
+                continue
+
+        if dp[i - 1][j] == dp[i][j]:
+            i -= 1
+        else:
+            j -= 1
+
+    return pairs
+
+
+def reconcile(ledger_txs, bank_txs, max_days=3):
+    """Reconcile ledger transactions against bank transactions.
+
+    Pairs transactions with equal amounts whose dates are at most max_days
+    apart. Maximises the number of pairs, then minimises total date distance.
+    """
+    ledger_txs = list(ledger_txs)
+    bank_txs = list(bank_txs)
+
+    ledger_groups = {}
+    bank_groups = {}
+    for idx, tx in enumerate(ledger_txs):
+        ledger_groups.setdefault(tx.amount, []).append((idx, tx))
+    for idx, tx in enumerate(bank_txs):
+        bank_groups.setdefault(tx.amount, []).append((idx, tx))
+
+    pairs = []
+    for amount, ledger_group in ledger_groups.items():
+        bank_group = bank_groups.get(amount)
+        if not bank_group:
+            continue
+        pairs.extend(_match_group(ledger_group, bank_group, max_days))
+
+    pairs.sort(key=lambda pair: pair[0])
+
+    matched = []
+    used_ledger = set()
+    used_bank = set()
+    for li, ltx, bi, btx in pairs:
+        matched.append((ltx, btx))
+        used_ledger.add(li)
+        used_bank.add(bi)
+
+    unmatched_ledger = [
+        tx for idx, tx in enumerate(ledger_txs) if idx not in used_ledger
+    ]
+    unmatched_bank = [
+        tx for idx, tx in enumerate(bank_txs) if idx not in used_bank
+    ]
+
+    return Reconciliation(
+        matched=matched,
+        unmatched_ledger=unmatched_ledger,
+        unmatched_bank=unmatched_bank,
+    )
