+def totals_by_category(transactions):
+    """Return {category: summed Money}."""
+    result = {}
+    for tx in transactions:
+        if tx.category not in result:
+            result[tx.category] = Money.zero(tx.amount.currency)
+        result[tx.category] = result[tx.category] + tx.amount
+    return result
+
+
+def monthly_summary(ledger):
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
+    return {
+        month: totals_by_category(txs)
+        for month, txs in group_by_month(ledger.transactions).items()
+    }
+
+
+def category_share(ledger, month):
+    """Return {category: fraction} of the month's total spending.
+
+    Only negative amounts are considered, compared by absolute value.
+    Categories with no spending are omitted; returns {} if no spending.
+    """
+    spending = {
+        category: -total.amount
+        for category, total in totals_by_category(group_by_month(ledger.transactions).get(month, [])).items()
+        if total.amount < 0
+    }
+    total_spending = sum(spending.values())
+    if total_spending == 0:
+        return {}
+    return {category: float(amount / total_spending) for category, amount in spending.items()}
+
