@@ -0,0 +1,63 @@
+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+
+def _as_decimal(rate):
+    if isinstance(rate, Decimal):
+        return rate
+    return Decimal(str(rate))
+
+
+class RateTable:
+    """Historical exchange rates stored exactly as Decimals."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        value = _as_decimal(rate)
+        self._rates.setdefault((base, quote), {})[on] = value
+        return self
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        candidates = [d for d in entries if d <= on]
+        if not candidates:
+            return None
+        return entries[max(candidates)]
+
+    def _direct_or_inverse(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        value = self._latest(base, quote, on)
+        if value is not None:
+            return value
+        inverse = self._latest(quote, base, on)
+        if inverse is not None:
+            return Decimal(1) / inverse
+        return None
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        with localcontext() as ctx:
+            ctx.prec = max(ctx.prec, 28)
+            direct = self._direct_or_inverse(base, quote, on)
+            if direct is not None:
+                return direct
+
+            to_usd = self._direct_or_inverse(base, "USD", on)
+            from_usd = self._direct_or_inverse("USD", quote, on)
+            if to_usd is not None and from_usd is not None:
+                return to_usd * from_usd
+
+            raise KeyError((base, quote, on))
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    with localcontext() as ctx:
+        ctx.prec = max(ctx.prec, 50)
+        rate = table.rate(money.currency, to, on)
+        return Money(money.amount * rate, to)
