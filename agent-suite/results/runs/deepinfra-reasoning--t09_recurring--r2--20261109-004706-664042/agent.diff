+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+    def __post_init__(self):
+        if self.freq not in FREQUENCIES:
+            raise ValueError(f"invalid frequency: {self.freq!r}")
+        if self.interval < 1:
+            raise ValueError("interval must be at least 1")
+        if self.count is not None and self.count < 0:
+            raise ValueError("count must not be negative")
+
+
+def _add_months(d, months):
+    month_index = d.month - 1 + months
+    year = d.year + month_index // 12
+    month = month_index % 12 + 1
+    day = min(d.day, calendar.monthrange(year, month)[1])
+    return date(year, month, day)
+
+
+def _add_years(d, years):
+    year = d.year + years
+    day = min(d.day, calendar.monthrange(year, d.month)[1])
+    return date(year, d.month, day)
+
+
+def _occurrence(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+    if rule.freq == "monthly":
+        return _add_months(rule.start, rule.interval * k)
+    return _add_years(rule.start, rule.interval * k)
+
+
+def _first_k(rule, window_start):
+    """Return a k at or just before the first occurrence that could be in the window."""
+    if window_start <= rule.start:
+        return 0
+    if rule.freq == "weekly":
+        period = 7 * rule.interval
+        k = (window_start - rule.start).days // period
+    elif rule.freq == "monthly":
+        months = (window_start.year - rule.start.year) * 12 + (
+            window_start.month - rule.start.month
+        )
+        k = months // rule.interval
+    else:
+        years = window_start.year - rule.start.year
+        k = years // rule.interval
+    return max(0, k - 1)
+
+
+def occurrences(rule, window_start, window_end):
+    """Return the rule's occurrence dates within [window_start, window_end]."""
+    if window_end < rule.start or window_end < window_start:
+        return []
+
+    results = []
+    k = _first_k(rule, window_start)
+    while True:
+        if rule.count is not None and k >= rule.count:
+            break
+        d = _occurrence(rule, k)
+        if rule.until is not None and d > rule.until:
+            break
+        if d > window_end:
+            break
+        if d >= window_start and d not in rule.skip:
+            results.append(d)
+        k += 1
+    return results
+
+
+def expand(rule, window_start, window_end):
+    """Expand a recurrence into transactions within the given window."""
+    return [
+        Transaction(
+            date=d,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for d in occurrences(rule, window_start, window_end)
+    ]
