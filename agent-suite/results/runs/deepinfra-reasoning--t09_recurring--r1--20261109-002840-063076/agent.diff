+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _add_months(day, months):
+    total = day.year * 12 + (day.month - 1) + months
+    year, month = divmod(total, 12)
+    month += 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day.day, last))
+
+
+def _occurrence(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(weeks=rule.interval * k)
+    if rule.freq == "monthly":
+        return _add_months(rule.start, rule.interval * k)
+    year = rule.start.year + rule.interval * k
+    last = calendar.monthrange(year, rule.start.month)[1]
+    return date(year, rule.start.month, min(rule.start.day, last))
+
+
+def _first_k(rule, window_start):
+    if window_start <= rule.start:
+        return 0
+    if rule.freq == "weekly":
+        days = (window_start - rule.start).days
+        return max(0, days // (7 * rule.interval) - 1)
+    if rule.freq == "monthly":
+        months = ((window_start.year - rule.start.year) * 12
+                  + (window_start.month - rule.start.month))
+        return max(0, months // rule.interval - 2)
+    years = window_start.year - rule.start.year
+    return max(0, years // rule.interval - 1)
+
+
+def occurrences(rule, window_start, window_end):
+    if rule.freq not in FREQUENCIES:
+        raise ValueError(f"invalid frequency: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+    skip = set(rule.skip)
+    result = []
+    k = _first_k(rule, window_start)
+    while True:
+        if rule.count is not None and k >= rule.count:
+            break
+        when = _occurrence(rule, k)
+        if rule.until is not None and when > rule.until:
+            break
+        if when > window_end:
+            break
+        if when >= window_start and when not in skip:
+            result.append(when)
+        k += 1
+    return result
+
+
+def expand(rule, window_start, window_end):
+    return [
+        Transaction(
+            date=when,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for when in occurrences(rule, window_start, window_end)
+    ]
