@@ -0,0 +1,83 @@
+from datetime import date
+import pytest
+
+from ledger import Ledger, Money, Transaction
+
+
+def make_ledger():
+    return Ledger([
+        Transaction(date(2026, 1, 3), "Coffee Shop", Money("-4.50"), "food", ("morning", "work")),
+        Transaction(date(2026, 1, 15), "Salary", Money("3000.00"), "income"),
+        Transaction(date(2026, 2, 1), "Rent", Money("-1200.00"), "housing", ("fixed", "monthly")),
+        Transaction(date(2026, 2, 2), "coffee beans", Money("-15.00"), "food", ("morning",)),
+    ])
+
+
+def descriptions(ledger, query):
+    return [tx.description for tx in ledger.search(query)]
+
+
+def test_empty_query_matches_everything():
+    l = make_ledger()
+    assert l.search("") == l.transactions
+    assert l.search("   ") == l.transactions
+
+
+def test_fields_are_case_insensitive():
+    l = make_ledger()
+    assert descriptions(l, "category:FOOD") == ["Coffee Shop", "coffee beans"]
+    assert descriptions(l, "tag:WORK") == ["Coffee Shop"]
+    assert descriptions(l, "desc:COFFEE") == ["Coffee Shop", "coffee beans"]
+
+
+def test_quoted_values_and_escapes():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), 'say "hi" (coffee)', Money("1"), "food"),
+        Transaction(date(2026, 1, 2), "a\\b", Money("2"), "food"),
+    ])
+    assert descriptions(l, 'desc:"say \\"hi\\" (coffee)"') == ['say "hi" (coffee)']
+    assert descriptions(l, 'desc:"a\\\\b"') == ["a\\b"]
+
+
+def test_amount_and_date_comparisons():
+    l = make_ledger()
+    assert descriptions(l, "amount<-20") == ["Rent"]
+    assert descriptions(l, "amount < -20") == ["Rent"]
+    assert descriptions(l, "amount>=10.50") == ["Salary"]
+    assert descriptions(l, "date>=2026-01-15") == ["Salary", "Rent", "coffee beans"]
+
+
+def test_boolean_precedence_and_implicit_and():
+    l = make_ledger()
+    assert descriptions(l, "category:food NOT tag:work") == ["coffee beans"]
+    assert descriptions(l, "NOT category:food") == ["Salary", "Rent"]
+    assert descriptions(l, "category:food OR category:income") == [
+        "Coffee Shop", "Salary", "coffee beans",
+    ]
+    assert descriptions(l, "(category:food OR category:housing) amount<-5") == [
+        "Rent", "coffee beans",
+    ]
+
+
+@pytest.mark.parametrize("query", [
+    "foo:bar",
+    "(category:food",
+    "category:food)",
+    "()",
+    "( )",
+    "category:food AND",
+    "OR tag:x",
+    "NOT",
+    "amount<",
+    "amount<abc",
+    "amount<1.2.3",
+    "amount!=5",
+    "date>=2026-13-01",
+    "date>=2026-1-1",
+    'desc:"unterminated',
+    "desc:",
+    'desc: "spaced"',
+])
+def test_malformed_queries_raise(query):
+    with pytest.raises(ValueError):
+        make_ledger().search(query)
