diff --git a/ledger/search.py b/ledger/search.py
new file mode 100644
index 0000000..6f9b058
--- /dev/null
+++ b/ledger/search.py
@@ -0,0 +1,259 @@
+import re
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+_NUMBER_RE = re.compile(r"^-?\d+(?:\.\d+)?$")
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+_OPERATORS = ("<=", ">=", "<", ">", "=")
+_FIELDS = ("category", "tag", "desc")
+
+
+class _Token:
+    __slots__ = ("kind", "value", "start", "end")
+
+    def __init__(self, kind, value, start, end):
+        self.kind = kind
+        self.value = value
+        self.start = start
+        self.end = end
+
+
+def _tokenize(query):
+    tokens = []
+    i = 0
+    n = len(query)
+    while i < n:
+        ch = query[i]
+        if ch.isspace():
+            i += 1
+            continue
+        if ch == "(":
+            tokens.append(_Token("LPAREN", ch, i, i + 1))
+            i += 1
+            continue
+        if ch == ")":
+            tokens.append(_Token("RPAREN", ch, i, i + 1))
+            i += 1
+            continue
+        if ch == '"':
+            start = i
+            i += 1
+            value = []
+            closed = False
+            while i < n:
+                ch = query[i]
+                if ch == "\\" and i + 1 < n and query[i + 1] in ('"', "\\"):
+                    value.append(query[i + 1])
+                    i += 2
+                    continue
+                if ch == '"':
+                    i += 1
+                    closed = True
+                    break
+                value.append(ch)
+                i += 1
+            if not closed:
+                raise ValueError("unterminated quote")
+            tokens.append(_Token("QUOTED", "".join(value), start, i))
+            continue
+        start = i
+        while i < n and not query[i].isspace() and query[i] not in '()"':
+            i += 1
+        tokens.append(_Token("WORD", query[start:i], start, i))
+    return tokens
+
+
+def _extract_operator(text):
+    for op in _OPERATORS:
+        if text.startswith(op):
+            return op, text[len(op):]
+    raise ValueError("bad operator")
+
+
+def _compare(operator, left, right):
+    if operator == "<":
+        return left < right
+    if operator == "<=":
+        return left <= right
+    if operator == ">":
+        return left > right
+    if operator == ">=":
+        return left >= right
+    return left == right
+
+
+def _field_matcher(field, value):
+    needle = value.lower()
+    if field == "category":
+        return lambda tx: tx.category.lower() == needle
+    if field == "tag":
+        return lambda tx: any(tag.lower() == needle for tag in tx.tags)
+    return lambda tx: needle in tx.description.lower()
+
+
+def _and(left, right):
+    return lambda tx: left(tx) and right(tx)
+
+
+def _or(left, right):
+    return lambda tx: left(tx) or right(tx)
+
+
+def _not(operand):
+    return lambda tx: not operand(tx)
+
+
+class _Parser:
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return None
+
+    def advance(self):
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def parse(self):
+        if not self.tokens:
+            return lambda tx: True
+        node = self._parse_or()
+        if self.pos != len(self.tokens):
+            raise ValueError("unexpected token")
+        return node
+
+    def _parse_or(self):
+        node = self._parse_and()
+        while True:
+            token = self.peek()
+            if token is not None and token.kind == "WORD" and token.value.upper() == "OR":
+                self.advance()
+                node = _or(node, self._parse_and())
+            else:
+                break
+        return node
+
+    def _parse_and(self):
+        node = self._parse_not()
+        while True:
+            token = self.peek()
+            if token is None or token.kind == "RPAREN":
+                break
+            if token.kind == "WORD" and token.value.upper() == "OR":
+                break
+            if token.kind == "WORD" and token.value.upper() == "AND":
+                self.advance()
+                node = _and(node, self._parse_not())
+                continue
+            if token.kind in ("LPAREN", "WORD"):
+                node = _and(node, self._parse_not())
+                continue
+            raise ValueError("unexpected token")
+        return node
+
+    def _parse_not(self):
+        token = self.peek()
+        if token is not None and token.kind == "WORD" and token.value.upper() == "NOT":
+            self.advance()
+            return _not(self._parse_not())
+        return self._parse_primary()
+
+    def _parse_primary(self):
+        token = self.peek()
+        if token is None:
+            raise ValueError("missing operand")
+        if token.kind == "LPAREN":
+            self.advance()
+            if self.peek() is not None and self.peek().kind == "RPAREN":
+                raise ValueError("empty group")
+            node = self._parse_or()
+            token = self.peek()
+            if token is None or token.kind != "RPAREN":
+                raise ValueError("unbalanced parentheses")
+            self.advance()
+            return node
+        if token.kind == "WORD":
+            return self._parse_term()
+        raise ValueError("unexpected token")
+
+    def _parse_term(self):
+        token = self.advance()
+        word = token.value
+
+        if ":" in word:
+            field, _, value = word.partition(":")
+            if field not in _FIELDS:
+                raise ValueError(f"unknown field: {field}")
+            if value == "":
+                following = self.peek()
+                if (following is not None and following.kind == "QUOTED"
+                        and following.start == token.end):
+                    value = following.value
+                    self.advance()
+                else:
+                    raise ValueError("missing value")
+            else:
+                following = self.peek()
+                if (following is not None and following.kind == "QUOTED"
+                        and following.start == token.end):
+                    raise ValueError("invalid value")
+            return _field_matcher(field, value)
+
+        return self._parse_comparison(word, token)
+
+    def _parse_comparison(self, word, token):
+        if word in ("amount", "date"):
+            field = word
+            rest = ""
+        elif word.startswith("amount") and len(word) > len("amount") and word[len("amount")] in "<>=":
+            field = "amount"
+            rest = word[len("amount"):]
+        elif word.startswith("date") and len(word) > len("date") and word[len("date")] in "<>=":
+            field = "date"
+            rest = word[len("date"):]
+        else:
+            raise ValueError(f"invalid term: {word}")
+
+        if rest == "":
+            following = self.peek()
+            if following is None or following.kind != "WORD":
+                raise ValueError("missing operator")
+            operator, rest = _extract_operator(following.value)
+            self.advance()
+        else:
+            operator, rest = _extract_operator(rest)
+
+        if rest == "":
+            following = self.peek()
+            if following is None or following.kind != "WORD":
+                raise ValueError(f"missing {field}")
+            value = following.value
+            self.advance()
+        else:
+            value = rest
+
+        if field == "amount":
+            if not _NUMBER_RE.match(value):
+                raise ValueError(f"invalid number: {value}")
+            try:
+                number = Decimal(value)
+            except InvalidOperation:
+                raise ValueError(f"invalid number: {value}") from None
+            return lambda tx: _compare(operator, tx.amount.amount, number)
+
+        if not _DATE_RE.match(value):
+            raise ValueError(f"invalid date: {value}")
+        try:
+            day = date.fromisoformat(value)
+        except ValueError:
+            raise ValueError(f"invalid date: {value}") from None
+        return lambda tx: _compare(operator, tx.date, day)
+
+
+def compile_query(query):
+    """Compile a query string into a predicate over transactions."""
+    return _Parser(_tokenize(query)).parse()
