new file mode 100644
index 0000000..16aec99
--- /dev/null
+++ b/ledger/budget.py
@@ -0,0 +1,71 @@
+import re
+from .money import Money
+
+_MONTH_RE = re.compile(r"^(\d{4})-(\d{2})$")
+
+
+def _parse_month(value):
+    if not isinstance(value, str) or not _MONTH_RE.match(value):
+        raise ValueError(f"malformed month: {value!r}")
+    year, month = int(value[:4]), int(value[5:])
+    if not 1 <= month <= 12:
+        raise ValueError(f"malformed month: {value!r}")
+    return year, month
+
+
+def _iter_months(start, end):
+    year, month = start
+    while (year, month) <= end:
+        yield f"{year:04d}-{month:02d}"
+        month += 1
+        if month > 12:
+            month = 1
+            year += 1
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    start = _parse_month(start_month)
+    end = _parse_month(end_month)
+    if start > end:
+        raise ValueError("start_month must not be after end_month")
+
+    months = list(_iter_months(start, end))
+
+    spent = {m: {cat: None for cat in budgets} for m in months}
+    for tx in ledger.transactions:
+        m = f"{tx.date.year:04d}-{tx.date.month:02d}"
+        if m not in spent or tx.category not in budgets:
+            continue
+        budget = budgets[tx.category]
+        if tx.amount.currency != budget.currency:
+            raise ValueError(
+                f"currency mismatch for {tx.category}: "
+                f"{tx.amount.currency} != {budget.currency}"
+            )
+        if spent[m][tx.category] is None:
+            spent[m][tx.category] = Money.zero(budget.currency)
+        spent[m][tx.category] = spent[m][tx.category] + tx.amount
+
+    report = {}
+    carried = {cat: Money.zero(budgets[cat].currency) for cat in budgets}
+    for m in months:
+        row_month = {}
+        for cat in budgets:
+            budget = budgets[cat]
+            raw = spent[m][cat]
+            s = -raw if raw is not None else Money.zero(budget.currency)
+            available = budget + carried[cat]
+            remaining = available - s
+            row_month[cat] = {
+                "budget": budget,
+                "carried_in": carried[cat],
+                "spent": s,
+                "available": available,
+                "remaining": remaining,
+            }
+            carry = remaining if remaining.amount > 0 else Money.zero(budget.currency)
+            if rollover_cap is not None and carry.amount > rollover_cap.amount:
+                carry = Money(rollover_cap.amount, budget.currency)
+            carried[cat] = carry
+        report[m] = row_month
+    return report
