new file mode 100644
index 0000000..0d01b19
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,311 @@
+from datetime import date
+
+from ledger import Ledger, Money, Transaction
+from ledger.report import largest_expenses, monthly_summary
+
+
+def tx(day, amount, category, description="tx", tags=()):
+    return Transaction(
+        date=date.fromisoformat(day),
+        description=description,
+        amount=Money(amount),
+        category=category,
+        tags=tuple(tags),
+    )
+
+
+# ---------------------------------------------------------------------------
+# monthly_summary
+# ---------------------------------------------------------------------------
+
+
+def test_monthly_summary_empty_ledger():
+    assert monthly_summary(Ledger()) == {}
+
+
+def test_monthly_summary_groups_by_month_and_category():
+    ledger = Ledger(
+        [
+            tx("2026-01-03", "-4.50", "food"),
+            tx("2026-01-20", "-15.50", "food"),
+            tx("2026-01-15", "3000.00", "income"),
+            tx("2026-02-01", "-1200.00", "housing"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary == {
+        "2026-01": {
+            "food": Money("-20.00"),
+            "income": Money("3000.00"),
+        },
+        "2026-02": {"housing": Money("-1200.00")},
+    }
+
+
+def test_monthly_summary_sums_within_a_month_but_not_across_months():
+    ledger = Ledger(
+        [
+            tx("2026-01-01", "-10.00", "food"),
+            tx("2026-01-31", "-2.50", "food"),
+            tx("2026-02-01", "-7.25", "food"),
+            tx("2026-02-28", "-0.75", "food"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["food"] == Money("-12.50")
+    assert summary["2026-02"]["food"] == Money("-8.00")
+
+
+def test_monthly_summary_returns_months_in_chronological_order():
+    # Inserted deliberately out of order, including a year boundary.
+    ledger = Ledger(
+        [
+            tx("2026-02-10", "-1.00", "food"),
+            tx("2025-12-31", "-2.00", "food"),
+            tx("2026-01-01", "-3.00", "food"),
+            tx("2025-11-15", "-4.00", "food"),
+        ]
+    )
+
+    assert list(monthly_summary(ledger)) == [
+        "2025-11",
+        "2025-12",
+        "2026-01",
+        "2026-02",
+    ]
+
+
+def test_monthly_summary_sorts_lexicographically_for_multi_year_data():
+    ledger = Ledger(
+        [
+            tx("2027-01-01", "-1.00", "a"),
+            tx("2026-12-01", "-1.00", "a"),
+            tx("2026-01-01", "-1.00", "a"),
+            tx("2025-12-01", "-1.00", "a"),
+        ]
+    )
+
+    assert list(monthly_summary(ledger)) == [
+        "2025-12",
+        "2026-01",
+        "2026-12",
+        "2027-01",
+    ]
+
+
+def test_monthly_summary_zero_pads_single_digit_months():
+    ledger = Ledger(
+        [
+            tx("2026-01-05", "-1.00", "a"),
+            tx("2026-09-05", "-2.00", "a"),
+            tx("2026-10-05", "-3.00", "a"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01", "2026-09", "2026-10"]
+    assert "2026-1" not in summary
+    assert summary["2026-09"]["a"] == Money("-2.00")
+    assert summary["2026-10"]["a"] == Money("-3.00")
+
+
+def test_monthly_summary_handles_signs_and_zero():
+    ledger = Ledger(
+        [
+            tx("2026-03-01", "100.00", "mixed"),
+            tx("2026-03-02", "-30.00", "mixed"),
+            tx("2026-03-03", "0.00", "mixed"),
+            tx("2026-03-04", "-5.00", "mixed"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-03"]["mixed"] == Money("65.00")
+
+
+def test_monthly_summary_keeps_categories_independent_per_month():
+    ledger = Ledger(
+        [
+            tx("2026-01-01", "-10.00", "food"),
+            tx("2026-01-02", "-20.00", "transport"),
+            tx("2026-02-01", "-1.00", "food"),
+        ]
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"] == {
+        "food": Money("-10.00"),
+        "transport": Money("-20.00"),
+    }
+    assert summary["2026-02"] == {"food": Money("-1.00")}
+
+
+def test_monthly_summary_preserves_amount_currency():
+    eur = Transaction(
+        date=date(2026, 4, 1),
+        description="train",
+        amount=Money("12.34", "EUR"),
+        category="travel",
+    )
+    usd = Transaction(
+        date=date(2026, 4, 2),
+        description="coffee",
+        amount=Money("-2.50", "USD"),
+        category="food",
+    )
+
+    summary = monthly_summary(Ledger([eur, usd]))
+
+    assert summary["2026-04"]["travel"] == Money("12.34", "EUR")
+    assert summary["2026-04"]["food"] == Money("-2.50", "USD")
+
+
+def test_monthly_summary_does_not_mutate_the_ledger():
+    ledger = Ledger(
+        [
+            tx("2026-01-01", "-1.00", "a"),
+            tx("2026-02-01", "-2.00", "b"),
+        ]
+    )
+    original = list(ledger.transactions)
+
+    monthly_summary(ledger)
+
+    assert ledger.transactions == original
+    assert len(ledger.transactions) == 2
+
+
+# ---------------------------------------------------------------------------
+# largest_expenses
+# ---------------------------------------------------------------------------
+
+
+def test_largest_expenses_empty_ledger():
+    assert largest_expenses(Ledger()) == []
+
+
+def test_largest_expenses_returns_most_negative_first():
+    small = tx("2026-01-01", "-5.00", "food")
+    medium = tx("2026-01-02", "-100.00", "shopping")
+    large = tx("2026-01-03", "-1000.00", "housing")
+    tiny = tx("2026-01-04", "-0.01", "food")
+
+    result = largest_expenses(Ledger([small, large, tiny, medium]), n=4)
+
+    assert result == [large, medium, small, tiny]
+    assert [t.amount for t in result] == [
+        Money("-1000.00"),
+        Money("-100.00"),
+        Money("-5.00"),
+        Money("-0.01"),
+    ]
+
+
+def test_largest_expenses_default_limit_is_three():
+    expenses = [tx(f"2026-01-{i:02d}", f"-{i}.00", "food") for i in range(1, 6)]
+
+    result = largest_expenses(Ledger(expenses))
+
+    assert [t.amount for t in result] == [
+        Money("-5.00"),
+        Money("-4.00"),
+        Money("-3.00"),
+    ]
+
+
+def test_largest_expenses_honours_explicit_n():
+    expenses = [tx(f"2026-01-{i:02d}", f"-{i}.00", "food") for i in range(1, 6)]
+    ledger = Ledger(expenses)
+
+    assert [t.amount for t in largest_expenses(ledger, n=1)] == [Money("-5.00")]
+    assert [t.amount for t in largest_expenses(ledger, n=2)] == [
+        Money("-5.00"),
+        Money("-4.00"),
+    ]
+    assert [t.amount for t in largest_expenses(ledger, n=5)] == [
+        Money("-5.00"),
+        Money("-4.00"),
+        Money("-3.00"),
+        Money("-2.00"),
+        Money("-1.00"),
+    ]
+
+
+def test_largest_expenses_n_zero_returns_empty_list():
+    ledger = Ledger([tx("2026-01-01", "-10.00", "food")])
+
+    assert largest_expenses(ledger, n=0) == []
+
+
+def test_largest_expenses_n_larger_than_available_returns_all_sorted():
+    expenses = [
+        tx("2026-01-01", "-2.00", "food"),
+        tx("2026-01-02", "-50.00", "rent"),
+        tx("2026-01-03", "-10.00", "food"),
+    ]
+
+    result = largest_expenses(Ledger(expenses), n=100)
+
+    assert [t.amount for t in result] == [
+        Money("-50.00"),
+        Money("-10.00"),
+        Money("-2.00"),
+    ]
+
+
+def test_largest_expenses_excludes_income_and_zero_amounts():
+    expense = tx("2026-01-01", "-20.00", "food")
+    income = tx("2026-01-02", "500.00", "income")
+    zero = tx("2026-01-03", "0.00", "misc")
+    another_income = tx("2026-01-04", "0.01", "gift")
+
+    result = largest_expenses(Ledger([income, zero, expense, another_income]), n=10)
+
+    assert result == [expense]
+    assert all(t.amount.amount < 0 for t in result)
+
+
+def test_largest_expenses_ties_keep_original_order():
+    first = tx("2026-01-01", "-10.00", "a", description="first")
+    second = tx("2026-01-02", "-10.00", "b", description="second")
+    third = tx("2026-01-03", "-10.00", "c", description="third")
+
+    result = largest_expenses(Ledger([first, second, third]), n=3)
+
+    assert result == [first, second, third]
+    assert [t.description for t in result] == ["first", "second", "third"]
+
+
+def test_largest_expenses_does_not_mutate_the_ledger():
+    expenses = [
+        tx("2026-01-01", "-1.00", "a"),
+        tx("2026-01-02", "-100.00", "b"),
+        tx("2026-01-03", "-10.00", "c"),
+    ]
+    ledger = Ledger(expenses)
+    original = list(ledger.transactions)
+
+    largest_expenses(ledger, n=2)
+
+    assert ledger.transactions == original
+    assert [t.description for t in ledger.transactions] == [
+        t.description for t in expenses
+    ]
+
+
+def test_largest_expenses_compares_cents_not_absolute_values():
+    # A less-negative amount must not outrank a more-negative one.
+    cent = tx("2026-01-01", "-0.01", "a")
+    dollar = tx("2026-01-02", "-1.00", "b")
+    ten = tx("2026-01-03", "-10.00", "c")
+
+    result = largest_expenses(Ledger([cent, ten, dollar]), n=3)
+
+    assert result == [ten, dollar, cent]
