@@ -0,0 +1,86 @@
+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _add_months(d, months):
+    total = d.year * 12 + (d.month - 1) + months
+    year, month = divmod(total, 12)
+    month += 1
+    day = min(d.day, calendar.monthrange(year, month)[1])
+    return date(year, month, day)
+
+
+def _nth(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+    if rule.freq == "monthly":
+        return _add_months(rule.start, rule.interval * k)
+    total = rule.start.year + rule.interval * k
+    day = min(rule.start.day, calendar.monthrange(total, rule.start.month)[1])
+    return date(total, rule.start.month, day)
+
+
+def _validate(rule):
+    if rule.freq not in FREQUENCIES:
+        raise ValueError(f"invalid freq: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be >= 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must be >= 0")
+
+
+def _exhausted(rule, k, d):
+    if rule.count is not None and k >= rule.count:
+        return True
+    if rule.until is not None and d > rule.until:
+        return True
+    return False
+
+
+def occurrences(rule, window_start, window_end):
+    _validate(rule)
+    skip = set(rule.skip)
+    out = []
+    k = 0
+    while True:
+        d = _nth(rule, k)
+        if _exhausted(rule, k, d):
+            break
+        if d > window_end:
+            break
+        if d >= window_start and d not in skip:
+            out.append(d)
+        k += 1
+    return out
+
+
+def expand(rule, window_start, window_end):
+    return [
+        Transaction(
+            date=d,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for d in occurrences(rule, window_start, window_end)
+    ]
