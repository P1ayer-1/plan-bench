--- /dev/null
+++ b/ledger/budget.py
@@ -0,0 +1,77 @@
+import re
+
+from .money import Money
+
+_MONTH_RE = re.compile(r"^\d{4}-(0[1-9]|1[0-2])$")
+
+
+def _parse_month(value):
+    if not isinstance(value, str) or not _MONTH_RE.match(value):
+        raise ValueError(f"invalid month: {value!r}")
+    year, month = value.split("-")
+    return int(year), int(month)
+
+
+def _month_range(start_month, end_month):
+    start_year, start = _parse_month(start_month)
+    end_year, end = _parse_month(end_month)
+    if (start_year, start) > (end_year, end):
+        raise ValueError("start_month must not be after end_month")
+    months = []
+    year, month = start_year, start
+    while (year, month) <= (end_year, end):
+        months.append(f"{year:04d}-{month:02d}")
+        month += 1
+        if month > 12:
+            month = 1
+            year += 1
+    return months
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    months = _month_range(start_month, end_month)
+
+    currencies = {}
+    for category, budget in budgets.items():
+        currencies[category] = budget.currency
+
+    spent = {}
+    for tx in ledger.transactions:
+        m = f"{tx.date.year:04d}-{tx.date.month:02d}"
+        if m not in months:
+            continue
+        category = tx.category
+        if category not in budgets:
+            continue
+        if tx.amount.currency != currencies[category]:
+            raise ValueError(
+                f"currency mismatch for category {category!r}: "
+                f"expected {currencies[category]!r}, got {tx.amount.currency!r}"
+            )
+        spent[(m, category)] = spent.get((m, category), Money.zero(currencies[category])) + tx.amount
+
+    carried = {}
+    report = {}
+    for m in months:
+        report[m] = {}
+        next_carried = {}
+        for category, budget in budgets.items():
+            currency = currencies[category]
+            carried_in = carried.get(category, Money.zero(currency))
+            month_spent = -spent.get((m, category), Money.zero(currency))
+            available = budget + carried_in
+            remaining = available - month_spent
+            report[m][category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": month_spent,
+                "available": available,
+                "remaining": remaining,
+            }
+            roll = remaining if remaining.amount > 0 else Money.zero(currency)
+            if rollover_cap is not None and roll.amount > rollover_cap.amount:
+                roll = Money(rollover_cap.amount, currency)
+            next_carried[category] = roll
+        carried = next_carried
+
+    return report
