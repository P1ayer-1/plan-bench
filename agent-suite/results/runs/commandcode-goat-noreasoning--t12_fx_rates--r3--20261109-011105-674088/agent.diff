@@ -0,0 +1,63 @@
+from datetime import date
+from decimal import Decimal, getcontext, localcontext
+
+from .money import Money
+
+with localcontext() as ctx:
+    ctx.prec = max(getcontext().prec, 28)
+
+
+def _dec(rate):
+    if isinstance(rate, Decimal):
+        return rate
+    return Decimal(str(rate))
+
+
+class RateTable:
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        self._rates.setdefault((base, quote), {})[on] = _dec(rate)
+        return self
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        best = None
+        for d, r in entries.items():
+            if d <= on and (best is None or d > best[0]):
+                best = (d, r)
+        return None if best is None else best[1]
+
+    def rate(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        with localcontext() as ctx:
+            ctx.prec = max(ctx.prec, 28)
+            r = self._latest(base, quote, on)
+            if r is not None:
+                return r
+            inv = self._latest(quote, base, on)
+            if inv is not None:
+                if inv == 0:
+                    raise KeyError((base, quote, on))
+                return Decimal(1) / inv
+            try:
+                a = self.rate(base, "USD", on)
+            except KeyError:
+                raise KeyError((base, quote, on))
+            try:
+                b = self.rate("USD", quote, on)
+            except KeyError:
+                raise KeyError((base, quote, on))
+            return a * b
+
+
+def convert(money, to, table, on):
+    with localcontext() as ctx:
+        ctx.prec = max(ctx.prec, 28)
+        rate = table.rate(money.currency, to, on)
+        amount = money.amount * rate
+    return Money(amount, to)
