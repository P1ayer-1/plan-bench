+import re
+from decimal import Decimal
+
+from .money import Money
+
+_MONTH_RE = re.compile(r"(\d{4})-(0[1-9]|1[0-2])")
+
+
+def _parse_month(value):
+    if not isinstance(value, str):
+        raise ValueError(f"invalid month: {value!r}")
+    match = _MONTH_RE.fullmatch(value)
+    if match is None:
+        raise ValueError(f"invalid month: {value!r}")
+    return int(match.group(1)), int(match.group(2))
+
+
+def _month_key(year, month):
+    return f"{year:04d}-{month:02d}"
+
+
+def _months(start, end):
+    year, month = start
+    end_year, end_month = end
+    out = []
+    while (year, month) <= (end_year, end_month):
+        out.append(_month_key(year, month))
+        month += 1
+        if month > 12:
+            year += 1
+            month = 1
+    return out
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    """Return per-month budget rows for each budgeted category, with rollover."""
+    start = _parse_month(start_month)
+    end = _parse_month(end_month)
+    if start > end:
+        raise ValueError("start_month must not be after end_month")
+
+    months = _months(start, end)
+    month_set = set(months)
+    spent_by_month = {
+        month: {category: Decimal("0") for category in budgets} for month in months
+    }
+
+    for tx in ledger.transactions:
+        if tx.category not in budgets:
+            continue
+        tx_month = _month_key(tx.date.year, tx.date.month)
+        if tx_month not in month_set:
+            continue
+        if tx.amount.currency != budgets[tx.category].currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r} in {tx_month}"
+            )
+        spent_by_month[tx_month][tx.category] -= tx.amount.amount
+
+    carried = {
+        category: Money.zero(budget.currency) for category, budget in budgets.items()
+    }
+    result = {}
+
+    for month in months:
+        rows = {}
+        next_carried = {}
+        for category, budget in budgets.items():
+            spent = Money(spent_by_month[month][category], budget.currency)
+            carried_in = carried[category]
+            available = budget + carried_in
+            remaining = available - spent
+            rows[category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": spent,
+                "available": available,
+                "remaining": remaining,
+            }
+            carry_amount = max(remaining.amount, Decimal("0"))
+            if rollover_cap is not None:
+                carry_amount = min(carry_amount, rollover_cap.amount)
+            next_carried[category] = Money(carry_amount, budget.currency)
+        result[month] = rows
+        carried = next_carried
+
+    return result
