diff --git a/ledger/report.py b/ledger/report.py
index 0f3c778..d42d5a9 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,36 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    If a month contains more than one currency, its keys are
+    (category, currency) tuples; single-currency months keep plain category
+    keys.
+    """
+    by_month = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        month = by_month.setdefault(m, {})
+        category = month.setdefault(tx.category, {})
+        currency = tx.amount.currency
+        if currency not in category:
+            category[currency] = Money.zero(currency)
+        category[currency] = category[currency] + tx.amount
+
+    result = {}
+    for month_key, categories in by_month.items():
+        currencies = {
+            currency
+            for per_currency in categories.values()
+            for currency in per_currency
+        }
+        mixed = len(currencies) > 1
+        summary = {}
+        for category, per_currency in categories.items():
+            for currency, total in per_currency.items():
+                key = (category, currency) if mixed else category
+                summary[key] = total
+        result[month_key] = summary
     return dict(sorted(result.items()))
 
 
