 from .money import Money
 
 
+def group_by_month(transactions):
+    """Return {"YYYY-MM": [transactions]} with keys sorted and original order kept."""
+    grouped = {}
+    for tx in transactions:
+        m = f"{tx.date.year:04d}-{tx.date.month:02d}"
+        grouped.setdefault(m, []).append(tx)
+    return dict(sorted(grouped.items()))
+
+
+def totals_by_category(transactions):
+    """Return {category: Money} summing amounts per category."""
+    totals = {}
+    for tx in transactions:
+        if tx.category not in totals:
+            totals[tx.category] = Money.zero(tx.amount.currency)
+        totals[tx.category] = totals[tx.category] + tx.amount
+    return totals
+
