+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _validate(rule):
+    if rule.freq not in FREQUENCIES:
+        raise ValueError(f"invalid freq: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+
+def _date_at(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+    if rule.freq == "monthly":
+        index = rule.start.year * 12 + (rule.start.month - 1) + rule.interval * k
+        year, month = divmod(index, 12)
+        month += 1
+        day = min(rule.start.day, monthrange(year, month)[1])
+        return date(year, month, day)
+    year = rule.start.year + rule.interval * k
+    day = min(rule.start.day, monthrange(year, rule.start.month)[1])
+    return date(year, rule.start.month, day)
+
+
+def _first_index(rule, window_start):
+    if rule.freq == "weekly":
+        days = (window_start - rule.start).days
+        if days <= 0:
+            return 0
+        return days // (7 * rule.interval)
+    if rule.freq == "monthly":
+        months = (
+            (window_start.year - rule.start.year) * 12
+            + window_start.month
+            - rule.start.month
+        )
+        if months <= 0:
+            return 0
+        return months // rule.interval
+    years = window_start.year - rule.start.year
+    if years <= 0:
+        return 0
+    return years // rule.interval
+
+
+def occurrences(rule, window_start, window_end):
+    """Return occurrence dates within [window_start, window_end], inclusive."""
+    _validate(rule)
+    if rule.count == 0:
+        return []
+
+    skip = frozenset(rule.skip)
+    result = []
+    k = _first_index(rule, window_start)
+    while True:
+        if rule.count is not None and k >= rule.count:
+            break
+        current = _date_at(rule, k)
+        if rule.until is not None and current > rule.until:
+            break
+        if current > window_end:
+            break
+        if current >= window_start and current not in skip:
+            result.append(current)
+        k += 1
+    return result
+
+
+def expand(rule, window_start, window_end):
+    """Expand a recurrence into transactions within the window."""
+    return [
+        Transaction(
+            date=current,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for current in occurrences(rule, window_start, window_end)
+    ]
