+++ b/ledger/budget.py
@@ -0,0 +1,90 @@
+import re
+
+from .money import Money
+
+_MONTH_RE = re.compile(r"^(\d{4})-(\d{2})$")
+
+
+def _parse_month(value):
+    if not isinstance(value, str):
+        raise ValueError(f"malformed month: {value!r}")
+    match = _MONTH_RE.match(value)
+    if not match:
+        raise ValueError(f"malformed month: {value!r}")
+    year = int(match.group(1))
+    month = int(match.group(2))
+    if month < 1 or month > 12:
+        raise ValueError(f"malformed month: {value!r}")
+    return year, month
+
+
+def _month_key(year, month):
+    return f"{year:04d}-{month:02d}"
+
+
+def _iter_months(start, end):
+    year, month = start
+    while (year, month) <= end:
+        yield year, month
+        month += 1
+        if month > 12:
+            month = 1
+            year += 1
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    """Build a monthly budget report with rollover per category."""
+    start = _parse_month(start_month)
+    end = _parse_month(end_month)
+    if start > end:
+        raise ValueError(f"start_month {start_month!r} is after end_month {end_month!r}")
+
+    months = list(_iter_months(start, end))
+    keys = [_month_key(y, m) for y, m in months]
+    key_set = set(keys)
+
+    spent = {key: {} for key in keys}
+    for tx in ledger.transactions:
+        key = f"{tx.date.year:04d}-{tx.date.month:02d}"
+        if key not in key_set or tx.category not in budgets:
+            continue
+        budget = budgets[tx.category]
+        if tx.amount.currency != budget.currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r} in {key}: "
+                f"{tx.amount.currency} != {budget.currency}"
+            )
+        if tx.category not in spent[key]:
+            spent[key][tx.category] = Money.zero(budget.currency)
+        spent[key][tx.category] = spent[key][tx.category] + tx.amount
+
+    report = {}
+    carried = {}
+    for key in keys:
+        row_month = {}
+        for category, cat_budget in budgets.items():
+            carried_in = carried.get(category, Money.zero(cat_budget.currency))
+            cat_spent = spent[key].get(
+                category, Money.zero(cat_budget.currency)
+            )
+            cat_spent = -cat_spent
+            available = cat_budget + carried_in
+            remaining = available - cat_spent
+            row_month[category] = {
+                "budget": cat_budget,
+                "carried_in": carried_in,
+                "spent": cat_spent,
+                "available": available,
+                "remaining": remaining,
+            }
+
+            if remaining.amount < 0:
+                next_carried = Money.zero(cat_budget.currency)
+            else:
+                next_carried = remaining
+            if rollover_cap is not None and next_carried.amount > rollover_cap.amount:
+                next_carried = Money(rollover_cap.amount, cat_budget.currency)
+            carried[category] = next_carried
+        report[key] = row_month
+
+    return report
