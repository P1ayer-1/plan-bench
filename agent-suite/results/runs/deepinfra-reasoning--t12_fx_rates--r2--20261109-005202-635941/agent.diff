+from datetime import date
+from decimal import Decimal, localcontext
+from fractions import Fraction
+
+from .money import Money
+
+
+class RateTable:
+    """Historical exchange rates, looked up by date."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        """Record that from ``on`` onward 1 ``base`` equals ``rate`` ``quote``."""
+        value = _to_decimal(rate)
+        self._rates.setdefault((base, quote), {})[on] = value
+
+    def _latest(self, base, quote, on):
+        rates = self._rates.get((base, quote))
+        if not rates:
+            return None
+        candidates = [d for d in rates if d <= on]
+        if not candidates:
+            return None
+        return rates[max(candidates)]
+
+    def _lookup(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        direct = self._latest(base, quote, on)
+        if direct is not None:
+            return direct
+        reverse = self._latest(quote, base, on)
+        if reverse is not None:
+            with localcontext() as ctx:
+                ctx.prec = max(28, ctx.prec)
+                return Decimal(1) / reverse
+        return None
+
+    def rate(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        result = self._lookup(base, quote, on)
+        if result is not None:
+            return result
+        base_usd = self._lookup(base, "USD", on)
+        usd_quote = self._lookup("USD", quote, on)
+        if base_usd is not None and usd_quote is not None:
+            with localcontext() as ctx:
+                ctx.prec = max(28, ctx.prec)
+                return base_usd * usd_quote
+        raise KeyError((base, quote, on))
+
+
+def _to_decimal(rate):
+    if isinstance(rate, Decimal):
+        return rate
+    if isinstance(rate, (str, int)):
+        return Decimal(rate)
+    if isinstance(rate, float):
+        return Decimal(str(rate))
+    raise TypeError(f"unsupported rate type: {type(rate).__name__}")
+
+
+def _fraction_to_decimal(value):
+    """Convert a Fraction with a finite decimal expansion to an exact Decimal."""
+    if value == 0:
+        return Decimal(0)
+    numerator = value.numerator
+    sign = 1
+    if numerator < 0:
+        sign = -1
+        numerator = -numerator
+    denominator = value.denominator
+    twos = 0
+    fives = 0
+    remainder = denominator
+    while remainder % 2 == 0:
+        remainder //= 2
+        twos += 1
+    while remainder % 5 == 0:
+        remainder //= 5
+        fives += 1
+    if remainder != 1:
+        with localcontext() as ctx:
+            ctx.prec = max(28, len(str(numerator)) + len(str(denominator)) + 10)
+            return Decimal(sign) * (Decimal(numerator) / Decimal(denominator))
+    exponent = max(twos, fives)
+    coefficient = numerator * (10 ** exponent) // denominator
+    digits = tuple(int(c) for c in str(coefficient))
+    return Decimal((0 if sign > 0 else 1, digits, -exponent))
+
+
+def _converted_amount(money, to, table, on):
+    rate = table.rate(money.currency, to, on)
+    return Fraction(money.amount) * Fraction(rate)
+
+
+def convert(money, to, table, on):
+    """Convert ``money`` to ``to`` and round once to the cent."""
+    exact = _converted_amount(money, to, table, on)
+    return Money(_fraction_to_decimal(exact), to)
