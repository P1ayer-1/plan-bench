@@ -0,0 +1,64 @@
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+_PREC = 28
+
+
+def _as_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+class RateTable:
+    """Historical exchange rates keyed by ordered currency pair and date."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        self._rates.setdefault((base, quote), {})[on] = _as_decimal(rate)
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            raise KeyError((base, quote, on))
+        eligible = [d for d in entries if d <= on]
+        if not eligible:
+            raise KeyError((base, quote, on))
+        return entries[max(eligible)]
+
+    def _leg(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        try:
+            return self._latest(base, quote, on)
+        except KeyError:
+            return Decimal(1) / self._latest(quote, base, on)
+
+    def rate(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        try:
+            with localcontext() as ctx:
+                ctx.prec = _PREC
+                return self._leg(base, quote, on)
+        except KeyError:
+            pass
+        try:
+            with localcontext() as ctx:
+                ctx.prec = _PREC
+                return self._leg(base, "USD", on) * self._leg("USD", quote, on)
+        except KeyError:
+            raise KeyError((base, quote, on))
+
+
+def _converted_amount(money, to, table, on):
+    with localcontext() as ctx:
+        ctx.prec = _PREC
+        return money.amount * table.rate(money.currency, to, on)
+
+
+def convert(money, to, table, on):
+    return Money(_converted_amount(money, to, table, on), to)
