+    def balance_in(self, currency, table, on=None):
+        """Total in `currency`, converting each transaction at its own rate
+        (or at `on` for all of them) and rounding once at the end."""
+        from decimal import Decimal, ROUND_HALF_UP, localcontext
+        from .money import CENT, Money
+
+        if not self.transactions:
+            return Money.zero(currency)
+        with localcontext() as ctx:
+            ctx.prec = 28
+            total = Decimal(0)
+            for tx in self.transactions:
+                day = on if on is not None else tx.date
+                total += tx.amount.amount * table.rate(tx.amount.currency, currency, day)
+        amount = total.quantize(CENT, rounding=ROUND_HALF_UP)
+        return Money(amount, currency)
+
     def dedupe(self):
