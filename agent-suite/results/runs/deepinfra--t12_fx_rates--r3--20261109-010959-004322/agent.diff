@@ -0,0 +1,73 @@
+from decimal import Decimal, ROUND_HALF_UP, localcontext
+
+from .money import CENT, Money
+
+USD = "USD"
+
+
+def _to_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, int):
+        return Decimal(value)
+    return Decimal(str(value))
+
+
+class RateTable:
+    """Historical exchange rates, stored as exact decimals."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        rate = _to_decimal(rate)
+        self._rates.setdefault((base, quote), {})[on] = rate
+        return self
+
+    def _direct(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        best_date = None
+        for d in entries:
+            if d <= on and (best_date is None or d > best_date):
+                best_date = d
+        if best_date is None:
+            return None
+        return entries[best_date]
+
+    def _lookup(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        direct = self._direct(base, quote, on)
+        if direct is not None:
+            return direct
+        reverse = self._direct(quote, base, on)
+        if reverse is not None:
+            return Decimal(1) / reverse
+        return None
+
+    def rate(self, base, quote, on):
+        with localcontext() as ctx:
+            ctx.prec = 28
+            if base == quote:
+                return Decimal(1)
+            direct = self._lookup(base, quote, on)
+            if direct is not None:
+                return direct
+            if base != USD and quote != USD:
+                leg_base = self._lookup(base, USD, on)
+                leg_quote = self._lookup(USD, quote, on)
+                if leg_base is not None and leg_quote is not None:
+                    return leg_base * leg_quote
+            raise KeyError((base, quote, on))
+
+
+def convert(money, to, table, on):
+    """Convert money to `to` at the rate in effect on `on`, rounding once."""
+    with localcontext() as ctx:
+        ctx.prec = 28
+        rate = table.rate(money.currency, to, on)
+        amount = money.amount * rate
+    amount = amount.quantize(CENT, rounding=ROUND_HALF_UP)
+    return Money(amount, to)
