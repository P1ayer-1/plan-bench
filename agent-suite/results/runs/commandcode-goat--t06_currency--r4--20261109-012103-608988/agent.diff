diff --git a/ledger/report.py b/ledger/report.py
index 0f3c778..a6712aa 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,26 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    When a month contains more than one currency, keys become
+    (category, currency) tuples so amounts are never mixed.
+    """
+    by_month = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        by_month.setdefault(m, []).append(tx)
+
+    result = {}
+    for m, txs in by_month.items():
+        multi_currency = len({tx.amount.currency for tx in txs}) > 1
+        cats = {}
+        for tx in txs:
+            key = (tx.category, tx.amount.currency) if multi_currency else tx.category
+            if key not in cats:
+                cats[key] = Money.zero(tx.amount.currency)
+            cats[key] = cats[key] + tx.amount
+        result[m] = cats
     return dict(sorted(result.items()))
 
 
