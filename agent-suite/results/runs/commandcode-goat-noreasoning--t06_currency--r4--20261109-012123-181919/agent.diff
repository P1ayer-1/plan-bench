index 0f3c778..856b73c 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,27 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    When a month contains more than one currency, category keys become
+    ``(category, currency)`` tuples so mixed-currency totals are not combined.
+    Months with a single currency use plain category keys.
+    """
+    grouped = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        grouped.setdefault(m, []).append(tx)
+
+    result = {}
+    for month, txs in grouped.items():
+        currencies = {tx.amount.currency for tx in txs}
+        cats = {}
+        for tx in txs:
+            key = (tx.category, tx.amount.currency) if len(currencies) > 1 else tx.category
+            if key not in cats:
+                cats[key] = Money.zero(tx.amount.currency)
+            cats[key] = cats[key] + tx.amount
+        result[month] = cats
     return dict(sorted(result.items()))
 
 
