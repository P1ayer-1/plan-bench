+def test_currency_mismatch_operations():
+    import pytest
+    from ledger import CurrencyMismatch
+    usd = Money("1.00", "USD")
+    eur = Money("1.00", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        usd + eur
+    with pytest.raises(CurrencyMismatch):
+        usd - eur
+    with pytest.raises(CurrencyMismatch):
+        usd < eur
+
+
+def test_empty_balance():
+    assert Ledger().balance() == {}
+
+
+def test_mixed_currency_balance():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("1.00", "USD"), "food"),
+        Transaction(date(2026, 1, 2), "b", Money("2.00", "EUR"), "food"),
+    ])
+    assert l.balance() == {"USD": Money("1.00", "USD"), "EUR": Money("2.00", "EUR")}
+
+
+def test_mixed_currency_summary():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("1.00", "USD"), "food"),
+        Transaction(date(2026, 1, 2), "b", Money("2.00", "EUR"), "food"),
+        Transaction(date(2026, 1, 3), "c", Money("3.00", "USD"), "food"),
+        Transaction(date(2026, 2, 1), "d", Money("4.00", "USD"), "food"),
+    ])
+    s = monthly_summary(l)
+    assert s["2026-01"][("food", "USD")] == Money("4.00", "USD")
+    assert s["2026-01"][("food", "EUR")] == Money("2.00", "EUR")
+    assert s["2026-02"]["food"] == Money("4.00", "USD")
