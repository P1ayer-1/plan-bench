+def _split(line):
+    fields = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == '"':
+            i += 1
+            buf = []
+            while i < n:
+                if line[i] == '"':
+                    if i + 1 < n and line[i + 1] == '"':
+                        buf.append('"')
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(line[i])
+                i += 1
+            while i < n and line[i] in " \t":
+                i += 1
+            if i < n and line[i] == ",":
+                i += 1
+                fields.append("".join(buf))
+                continue
+            if i >= n:
+                fields.append("".join(buf))
+                break
+            raise ValueError(f"unexpected character at position {i}")
+        start = i
+        while i < n and line[i] != ",":
+            i += 1
+        fields.append(line[start:i])
+        if i >= n:
+            break
+        i += 1
+    return fields
+
