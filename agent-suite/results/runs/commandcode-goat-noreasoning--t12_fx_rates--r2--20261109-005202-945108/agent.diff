diff --git a/tests/test_fx.py b/tests/test_fx.py
new file mode 100644
index 0000000..b3e627d
--- /dev/null
+++ b/tests/test_fx.py
@@ -0,0 +1,80 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from ledger import Money, Ledger, Transaction
+from ledger.fx import RateTable, convert
+
+
+def test_rate_same_currency():
+    assert RateTable().rate("USD", "USD", date(2026, 1, 1)) == Decimal(1)
+
+
+def test_rate_forward_and_asof():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    t.add(date(2026, 2, 1), "EUR", "USD", "1.20")
+    assert t.rate("EUR", "USD", date(2026, 1, 15)) == Decimal("1.10")
+    assert t.rate("EUR", "USD", date(2026, 2, 1)) == Decimal("1.20")
+    assert t.rate("EUR", "USD", date(2026, 3, 1)) == Decimal("1.20")
+
+
+def test_rate_exact_no_float():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", 0.1)
+    assert t.rate("EUR", "USD", date(2026, 1, 1)) == Decimal("0.1")
+
+
+def test_rate_inverse():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.25")
+    assert t.rate("USD", "EUR", date(2026, 1, 1)) == Decimal(1) / Decimal("1.25")
+
+
+def test_rate_through_usd():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    t.add(date(2026, 1, 1), "USD", "GBP", "0.80")
+    assert t.rate("EUR", "GBP", date(2026, 1, 1)) == Decimal("1.10") * Decimal("0.80")
+
+
+def test_rate_missing():
+    with pytest.raises(KeyError):
+        RateTable().rate("EUR", "USD", date(2026, 1, 1))
+
+
+def test_rate_replace_same_date():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.50")
+    assert t.rate("EUR", "USD", date(2026, 1, 1)) == Decimal("1.50")
+
+
+def test_convert():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    assert convert(Money("10.00", "EUR"), "USD", t, date(2026, 1, 1)) == Money("11.00", "USD")
+
+
+def test_balance_in_per_date():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    t.add(date(2026, 2, 1), "EUR", "USD", "1.20")
+    l = Ledger([
+        Transaction(date(2026, 1, 10), "a", Money("1.00", "EUR"), "x"),
+        Transaction(date(2026, 2, 10), "b", Money("1.00", "EUR"), "x"),
+    ])
+    assert l.balance_in("USD", t) == Money("2.30")
+    assert l.balance_in("USD", t, date(2026, 1, 20)) == Money("2.20")
+    assert Ledger().balance_in("USD", t) == Money.zero("USD")
+
+
+def test_balance_in_rounds_once():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "0.005")
+    l = Ledger([
+        Transaction(date(2026, 1, 10), "a", Money("1.00", "EUR"), "x"),
+        Transaction(date(2026, 1, 10), "b", Money("1.00", "EUR"), "x"),
+    ])
+    assert l.balance_in("USD", t) == Money("0.01", "USD")
