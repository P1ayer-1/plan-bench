@@ -0,0 +1,64 @@
+from decimal import Decimal, ROUND_HALF_UP
+
+from .money import CENT, Money
+
+USD = "USD"
+
+_PRECISION = 28
+
+
+def _to_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+class RateTable:
+    """Historical exact exchange rates keyed by (base, quote)."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        series = self._rates.setdefault((base, quote), {})
+        series[on] = _to_decimal(rate)
+
+    def _latest(self, base, quote, on):
+        series = self._rates.get((base, quote))
+        if not series:
+            return None
+        best_date = None
+        for d in series:
+            if d <= on and (best_date is None or d > best_date):
+                best_date = d
+        if best_date is None:
+            return None
+        return series[best_date]
+
+    def rate(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+
+        direct = self._latest(base, quote, on)
+        if direct is not None:
+            return direct
+
+        inverse = self._latest(quote, base, on)
+        if inverse is not None:
+            return Decimal(1) / inverse
+
+        if base != USD and quote != USD:
+            try:
+                return self.rate(base, USD, on) * self.rate(USD, quote, on)
+            except KeyError:
+                pass
+
+        raise KeyError(f"no rate for {base}->{quote} on {on}")
+
+
+def convert(money, to, table, on):
+    """Convert money to `to` at the rate in effect on `on`, rounding once."""
+    if money.currency == to:
+        return Money(money.amount, to)
+    rate = table.rate(money.currency, to, on)
+    return Money(money.amount * rate, to)
