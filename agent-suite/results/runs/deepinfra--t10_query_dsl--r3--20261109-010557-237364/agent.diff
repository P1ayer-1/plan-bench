@@ -29,3 +29,45 @@ def test_summary():
     s = monthly_summary(Ledger(parse_csv(CSV)))
     assert list(s) == ["2026-01", "2026-02"]
     assert s["2026-02"]["housing"] == Money("-1200.00")
+
+
+def test_search_terms_and_operators():
+    l = Ledger(parse_csv(CSV))
+    assert [t.description for t in l.search("category:FOOD")] == ["Coffee"]
+    assert [t.description for t in l.search("tag:MONTHLY")] == ["Rent"]
+    assert [t.description for t in l.search("desc:cof")] == ["Coffee"]
+    assert [t.description for t in l.search("amount<-20")] == ["Rent"]
+    assert [t.description for t in l.search("amount >= 3000")] == ["Salary"]
+    assert [t.description for t in l.search("date>=2026-02-01")] == ["Rent"]
+    assert [t.description for t in l.search("category:food OR category:income")] == ["Coffee", "Salary"]
+    assert [t.description for t in l.search("NOT category:food")] == ["Salary", "Rent"]
+    assert [t.description for t in l.search("category:food tag:morning")] == ["Coffee"]
+    assert l.search("") == l.transactions
+    assert l.search("   ") == l.transactions
+
+
+def test_search_precedence_and_groups():
+    l = Ledger(parse_csv(CSV))
+    q = "(category:food OR category:income) AND amount>0"
+    assert [t.description for t in l.search(q)] == ["Salary"]
+    q = "category:food OR category:income AND amount>0"
+    assert [t.description for t in l.search(q)] == ["Coffee", "Salary"]
+
+
+def test_search_quoted_and_escaped():
+    from ledger import Transaction, Money
+    from datetime import date
+    l = Ledger([Transaction(date(2026, 1, 1), 'say "hi" (there)', Money("1"), "a b", ('x y',))])
+    assert l.search('desc:"say \\"hi\\" (there)"') == l.transactions
+    assert l.search('category:"a b"') == l.transactions
+    assert l.search('tag:"x y"') == l.transactions
+
+
+def test_search_errors():
+    import pytest
+    l = Ledger(parse_csv(CSV))
+    for bad in ["foo:bar", "(category:food", "category:food AND", "OR tag:x",
+                "NOT", "amount<>1", "amount<abc", "date>2026-13-01",
+                'desc:"abc', "()"]:
+        with pytest.raises(ValueError):
+            l.search(bad)
