@@ -0,0 +1,88 @@
+import re
+from .money import Money
+
+_MONTH_RE = re.compile(r"^(\d{4})-(\d{2})$")
+
+
+def _parse_month(value):
+    match = _MONTH_RE.match(value) if isinstance(value, str) else None
+    if match is None:
+        raise ValueError(f"invalid month: {value!r}")
+    month = int(match.group(2))
+    if month < 1 or month > 12:
+        raise ValueError(f"invalid month: {value!r}")
+    return int(match.group(1)), month
+
+
+def _month_key(year, month):
+    return f"{year:04d}-{month:02d}"
+
+
+def _next_month(year, month):
+    if month == 12:
+        return year + 1, 1
+    return year, month + 1
+
+
+def _months(start_month, end_month):
+    start = _parse_month(start_month)
+    end = _parse_month(end_month)
+    if start > end:
+        raise ValueError("start_month must not be after end_month")
+    out = []
+    year, month = start
+    while (year, month) <= end:
+        out.append((year, month))
+        year, month = _next_month(year, month)
+    return out
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    months = _months(start_month, end_month)
+    month_keys = [_month_key(y, m) for y, m in months]
+
+    spent = {key: {category: None for category in budgets} for key in month_keys}
+    in_range = set(month_keys)
+    for tx in ledger.transactions:
+        key = _month_key(tx.date.year, tx.date.month)
+        if key not in in_range or tx.category not in budgets:
+            continue
+        budget = budgets[tx.category]
+        if tx.amount.currency != budget.currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r}: "
+                f"transaction in {tx.amount.currency}, budget in {budget.currency}"
+            )
+        current = spent[key][tx.category]
+        if current is None:
+            current = Money.zero(budget.currency)
+        spent[key][tx.category] = current + tx.amount
+
+    carried = {category: Money.zero(budget.currency) for category, budget in budgets.items()}
+    report = {}
+    for key in month_keys:
+        rows = {}
+        for category, budget in budgets.items():
+            carried_in = carried[category]
+            spent_amount = spent[key][category]
+            if spent_amount is None:
+                spent_amount = Money.zero(budget.currency)
+            spent_amount = -spent_amount
+            available = budget + carried_in
+            remaining = available - spent_amount
+            rows[category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": spent_amount,
+                "available": available,
+                "remaining": remaining,
+            }
+
+            next_carried = remaining
+            if next_carried.amount < 0:
+                next_carried = Money.zero(budget.currency)
+            if rollover_cap is not None and next_carried.amount > rollover_cap.amount:
+                next_carried = Money(rollover_cap.amount, budget.currency)
+            carried[category] = next_carried
+        report[key] = rows
+    return report
