+import re
+
+from .money import Money
+
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+def _parse_month(value):
+    if not isinstance(value, str) or _MONTH_RE.fullmatch(value) is None:
+        raise ValueError(f"invalid month: {value!r}")
+    year, month = value.split("-")
+    return int(year), int(month)
+
+
+def _month_index(year, month):
+    return year * 12 + (month - 1)
+
+
+def _format_month(index):
+    year, month = divmod(index, 12)
+    return f"{year:04d}-{month + 1:02d}"
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    """Return per-month budget rows with rollover for the given month range."""
+    start_year, start_num = _parse_month(start_month)
+    end_year, end_num = _parse_month(end_month)
+    start_index = _month_index(start_year, start_num)
+    end_index = _month_index(end_year, end_num)
+    if start_index > end_index:
+        raise ValueError("start_month must not be after end_month")
+
+    spent = {}
+    for tx in ledger.transactions:
+        if tx.category not in budgets:
+            continue
+        index = _month_index(tx.date.year, tx.date.month)
+        if index < start_index or index > end_index:
+            continue
+        budget = budgets[tx.category]
+        if tx.amount.currency != budget.currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r}: "
+                f"{tx.amount.currency} != {budget.currency}"
+            )
+        key = (index, tx.category)
+        if key not in spent:
+            spent[key] = Money.zero(budget.currency)
+        spent[key] = spent[key] + tx.amount
+
+    result = {}
+    carried = {
+        category: Money.zero(budget.currency)
+        for category, budget in budgets.items()
+    }
+    for index in range(start_index, end_index + 1):
+        month = _format_month(index)
+        rows = {}
+        for category, budget in budgets.items():
+            carried_in = carried[category]
+            spent_amount = -spent.get(
+                (index, category), Money.zero(budget.currency)
+            )
+            available = budget + carried_in
+            remaining = available - spent_amount
+            rows[category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": spent_amount,
+                "available": available,
+                "remaining": remaining,
+            }
+
+            next_carried = remaining
+            if next_carried.amount < 0:
+                next_carried = Money.zero(budget.currency)
+            if rollover_cap is not None:
+                cap = max(rollover_cap.amount, Money.zero().amount)
+                if next_carried.amount > cap:
+                    next_carried = Money(cap, budget.currency)
+            carried[category] = next_carried
+        result[month] = rows
+    return result
