@@ -0,0 +1,74 @@
+from bisect import bisect_right
+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+_PRECISION = 28
+
+
+class RateTable:
+    """Historical exchange rates between currencies."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        if isinstance(rate, Decimal):
+            value = rate
+        else:
+            value = Decimal(str(rate))
+        entries = self._rates.setdefault((base, quote), [])
+        dates = [d for d, _ in entries]
+        index = bisect_right(dates, on)
+        if index > 0 and entries[index - 1][0] == on:
+            entries[index - 1] = (on, value)
+        else:
+            entries.insert(index, (on, value))
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        dates = [d for d, _ in entries]
+        index = bisect_right(dates, on)
+        if index == 0:
+            return None
+        return entries[index - 1][1]
+
+    def _direct(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        value = self._latest(base, quote, on)
+        if value is not None:
+            return value
+        inverse = self._latest(quote, base, on)
+        if inverse is not None:
+            with localcontext() as ctx:
+                ctx.prec = _PRECISION
+                return Decimal(1) / inverse
+        raise KeyError((base, quote, on))
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        if base == quote:
+            return Decimal(1)
+        try:
+            return self._direct(base, quote, on)
+        except KeyError:
+            pass
+        try:
+            with localcontext() as ctx:
+                ctx.prec = _PRECISION
+                return self._direct(base, "USD", on) * self._direct("USD", quote, on)
+        except KeyError:
+            raise KeyError((base, quote, on)) from None
+
+
+def _convert_amount(money: Money, to: str, table: RateTable, on: date) -> Decimal:
+    with localcontext() as ctx:
+        ctx.prec = _PRECISION
+        return money.amount * table.rate(money.currency, to, on)
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    return Money(_convert_amount(money, to, table, on), to)
