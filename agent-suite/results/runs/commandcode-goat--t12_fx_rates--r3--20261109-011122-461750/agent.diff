@@ -0,0 +1,81 @@
+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+_PRECISION = 28
+
+
+def _as_decimal(rate):
+    if isinstance(rate, Decimal):
+        return rate
+    return Decimal(str(rate))
+
+
+class RateTable:
+    """Historical exchange rates, keyed by ordered currency pair."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        value = _as_decimal(rate)
+        entries = self._rates.setdefault((base, quote), [])
+
+        for i, (day, _) in enumerate(entries):
+            if day == on:
+                entries[i] = (on, value)
+                return
+            if day > on:
+                entries.insert(i, (on, value))
+                return
+
+        entries.append((on, value))
+
+    def _historical(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        for day, value in reversed(entries):
+            if day <= on:
+                return value
+        return None
+
+    def _direct(self, base, quote, on):
+        """Rules 1-3: identity, direct rate, or inverted rate."""
+        if base == quote:
+            return Decimal(1)
+
+        value = self._historical(base, quote, on)
+        if value is not None:
+            return value
+
+        inverse = self._historical(quote, base, on)
+        if inverse is not None:
+            with localcontext() as ctx:
+                ctx.prec = _PRECISION
+                return Decimal(1) / inverse
+
+        return None
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        value = self._direct(base, quote, on)
+        if value is not None:
+            return value
+
+        via_base = self._direct(base, "USD", on)
+        via_quote = self._direct("USD", quote, on)
+        if via_base is not None and via_quote is not None:
+            with localcontext() as ctx:
+                ctx.prec = _PRECISION
+                return via_base * via_quote
+
+        raise KeyError(f"no rate for {base}/{quote} on {on}")
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    exchange_rate = table.rate(money.currency, to, on)
+    with localcontext() as ctx:
+        ctx.prec = _PRECISION
+        amount = money.amount * exchange_rate
+    return Money(amount, to)
