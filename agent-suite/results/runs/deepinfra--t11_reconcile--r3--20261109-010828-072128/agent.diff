+"""Bank-statement reconciliation.
+
+Pair ledger transactions with bank transactions when amounts match exactly
+(currency included) and dates are at most ``max_days`` apart.  The pairing
+maximises the number of pairs and, among those, minimises the total date
+distance.
+"""
+
+from dataclasses import dataclass, field
+from typing import List, Tuple
+
+
+@dataclass
+class Reconciliation:
+    matched: List[Tuple[object, object]] = field(default_factory=list)
+    unmatched_ledger: List[object] = field(default_factory=list)
+    unmatched_bank: List[object] = field(default_factory=list)
+
+
+def _min_cost_assignment(cost):
+    """Minimum-cost assignment for a square matrix (Hungarian algorithm).
+
+    Returns ``assignment`` such that row ``i`` is assigned column
+    ``assignment[i]`` and the total cost is minimal.
+    """
+    n = len(cost)
+    if n == 0:
+        return []
+    INF = float("inf")
+    u = [0] * (n + 1)
+    v = [0] * (n + 1)
+    p = [0] * (n + 1)
+    way = [0] * (n + 1)
+    for i in range(1, n + 1):
+        p[0] = i
+        j0 = 0
+        minv = [INF] * (n + 1)
+        used = [False] * (n + 1)
+        while True:
+            used[j0] = True
+            i0 = p[j0]
+            delta = INF
+            j1 = 0
+            row = cost[i0 - 1]
+            for j in range(1, n + 1):
+                if not used[j]:
+                    cur = row[j - 1] - u[i0] - v[j]
+                    if cur < minv[j]:
+                        minv[j] = cur
+                        way[j] = j0
+                    if minv[j] < delta:
+                        delta = minv[j]
+                        j1 = j
+            for j in range(n + 1):
+                if used[j]:
+                    u[p[j]] += delta
+                    v[j] -= delta
+                else:
+                    minv[j] -= delta
+            j0 = j1
+            if p[j0] == 0:
+                break
+        while True:
+            j1 = way[j0]
+            p[j0] = p[j1]
+            j0 = j1
+            if j0 == 0:
+                break
+    assignment = [-1] * n
+    for j in range(1, n + 1):
+        if p[j] != 0:
+            assignment[p[j] - 1] = j - 1
+    return assignment
+
+
+def _match_group(ledger_rows, bank_cols, ledger_dates, bank_dates, max_days):
+    """Optimal pairing for one amount group.
+
+    ``ledger_rows`` / ``bank_cols`` are indices into the original inputs.
+    Returns a list of ``(ledger_row, bank_col)`` pairs that maximises the
+    number of pairs and minimises the total date distance.
+    """
+    n = len(ledger_rows)
+    m = len(bank_cols)
+    size = max(n, m)
+    penalty = (max_days + 1) * (size + 1)
+    cost = []
+    for r in range(size):
+        row = []
+        for c in range(size):
+            if r < n and c < m:
+                dist = abs((ledger_dates[ledger_rows[r]] - bank_dates[bank_cols[c]]).days)
+                row.append(dist if dist <= max_days else penalty)
+            else:
+                row.append(penalty)
+        cost.append(row)
+    assignment = _min_cost_assignment(cost)
+    pairs = []
+    for r, c in enumerate(assignment):
+        if r >= n or c < 0 or c >= m:
+            continue
+        lk = ledger_rows[r]
+        bj = bank_cols[c]
+        if abs((ledger_dates[lk] - bank_dates[bj]).days) <= max_days:
+            pairs.append((lk, bj))
+    return pairs
+
+
+def reconcile(ledger_txs, bank_txs, max_days=3):
+    """Reconcile ``ledger_txs`` against ``bank_txs``.
+
+    Returns a :class:`Reconciliation` with ``matched`` ordered by the ledger
+    transaction's position in ``ledger_txs``.
+    """
+    ledger_txs = list(ledger_txs)
+    bank_txs = list(bank_txs)
+
+    ledger_dates = [tx.date for tx in ledger_txs]
+    bank_dates = [tx.date for tx in bank_txs]
+
+    # Bucket both sides by amount (Money equality includes the currency).
+    bank_by_amount = {}
+    for j, btx in enumerate(bank_txs):
+        bank_by_amount.setdefault(btx.amount, []).append(j)
+
+    ledger_by_amount = {}
+    for i, ltx in enumerate(ledger_txs):
+        ledger_by_amount.setdefault(ltx.amount, []).append(i)
+
+    pairs = {}
+    matched_bank = set()
+    for amount, bank_cols in bank_by_amount.items():
+        ledger_rows = ledger_by_amount.get(amount)
+        if not ledger_rows:
+            continue
+        # Only participants with at least one feasible partner matter; the
+        # assignment below lets everyone stay unmatched via dummy edges, so
+        # filtering here is purely an optimisation.
+        active_rows = [
+            i for i in ledger_rows
+            if any(abs((ledger_dates[i] - bank_dates[j]).days) <= max_days for j in bank_cols)
+        ]
+        active_cols = [
+            j for j in bank_cols
+            if any(abs((ledger_dates[i] - bank_dates[j]).days) <= max_days for i in ledger_rows)
+        ]
+        if not active_rows or not active_cols:
+            continue
+        group_pairs = _match_group(
+            active_rows, active_cols, ledger_dates, bank_dates, max_days
+        )
+        for lk, bj in group_pairs:
+            pairs[lk] = bj
+            matched_bank.add(bj)
+
+    matched = [(ledger_txs[i], bank_txs[pairs[i]]) for i in range(len(ledger_txs)) if i in pairs]
+    unmatched_ledger = [tx for i, tx in enumerate(ledger_txs) if i not in pairs]
+    unmatched_bank = [tx for j, tx in enumerate(bank_txs) if j not in matched_bank]
+    return Reconciliation(matched=matched, unmatched_ledger=unmatched_ledger, unmatched_bank=unmatched_bank)
