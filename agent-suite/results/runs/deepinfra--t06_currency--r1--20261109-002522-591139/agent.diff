@@ -2,15 +2,29 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    When a month contains transactions in more than one currency, the inner
+    keys become ``(category, currency)`` tuples so that each currency is
+    reported separately. Months with a single currency keep plain category
+    keys.
+    """
+    by_month = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        by_month.setdefault(m, []).append(tx)
+
+    result = {}
+    for month, transactions in by_month.items():
+        currencies = {tx.amount.currency for tx in transactions}
+        mixed = len(currencies) > 1
+        cats = {}
+        for tx in transactions:
+            key = (tx.category, tx.amount.currency) if mixed else tx.category
+            if key not in cats:
+                cats[key] = Money.zero(tx.amount.currency)
+            cats[key] = cats[key] + tx.amount
+        result[month] = cats
     return dict(sorted(result.items()))
 
 
