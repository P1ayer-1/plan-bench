@@ -0,0 +1,63 @@
+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+
+def _dec(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+class RateTable:
+    """Historical exchange rates, stored as exact Decimals."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        series = self._rates.setdefault((base, quote), {})
+        series[on] = _dec(rate)
+
+    def _latest(self, base, quote, on):
+        best = None
+        for day, rate in self._rates.get((base, quote), {}).items():
+            if day <= on and (best is None or day > best[0]):
+                best = (day, rate)
+        return best[1] if best is not None else None
+
+    def _direct_rate(self, base, quote, on):
+        """Rules 1-3: identity, direct, or inverse lookup."""
+        if base == quote:
+            return Decimal(1)
+        direct = self._latest(base, quote, on)
+        if direct is not None:
+            return direct
+        inverse = self._latest(quote, base, on)
+        if inverse is not None:
+            return Decimal(1) / inverse
+        return None
+
+    def rate(self, base, quote, on: date) -> Decimal:
+        with localcontext() as ctx:
+            ctx.prec = 28
+            result = self._direct_rate(base, quote, on)
+            if result is not None:
+                return +result
+            if base != "USD" and quote != "USD":
+                left = self._direct_rate(base, "USD", on)
+                right = self._direct_rate("USD", quote, on)
+                if left is not None and right is not None:
+                    return +(left * right)
+            raise KeyError(f"no rate for {base}->{quote} on {on}")
+
+
+def convert_unrounded(money: Money, to: str, table: RateTable, on: date) -> Decimal:
+    with localcontext() as ctx:
+        ctx.prec = 28
+        return +(money.amount * table.rate(money.currency, to, on))
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    return Money(convert_unrounded(money, to, table, on), to)
