index 0f3c778..c96752b 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,26 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    If a month contains more than one currency, its keys are
+    ``(category, currency)`` tuples; single-currency months keep plain
+    category keys.
+    """
+    by_month = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        by_month.setdefault(m, []).append(tx)
+
+    result = {}
+    for month, txs in by_month.items():
+        currencies = {tx.amount.currency for tx in txs}
+        multi = len(currencies) > 1
+        cats = {}
+        for tx in txs:
+            key = (tx.category, tx.amount.currency) if multi else tx.category
+            cats[key] = cats.get(key, Money.zero(tx.amount.currency)) + tx.amount
+        result[month] = cats
     return dict(sorted(result.items()))
 
 
