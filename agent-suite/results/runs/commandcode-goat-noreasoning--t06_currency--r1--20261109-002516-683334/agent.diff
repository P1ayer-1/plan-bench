+def test_currency_mismatch():
+    import pytest
+    usd = Money("1.00", "USD")
+    eur = Money("1.00", "EUR")
+    with pytest.raises(CurrencyMismatch):
+        usd + eur
+    with pytest.raises(CurrencyMismatch):
+        usd - eur
+    with pytest.raises(CurrencyMismatch):
+        usd < eur
+    assert issubclass(CurrencyMismatch, ValueError)
+
+
+def test_multi_currency_balance():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("1.00", "USD"), "x"),
+        Transaction(date(2026, 1, 2), "b", Money("2.00", "EUR"), "y"),
+        Transaction(date(2026, 1, 3), "c", Money("3.00", "USD"), "x"),
+    ])
+    assert l.balance() == {"USD": Money("4.00", "USD"), "EUR": Money("2.00", "EUR")}
+
+
+def test_multi_currency_summary():
+    l = Ledger([
+        Transaction(date(2026, 1, 1), "a", Money("1.00", "USD"), "food"),
+        Transaction(date(2026, 1, 2), "b", Money("2.00", "EUR"), "food"),
+        Transaction(date(2026, 2, 1), "c", Money("3.00", "USD"), "food"),
+    ])
+    s = monthly_summary(l)
+    assert s["2026-01"][("food", "USD")] == Money("1.00", "USD")
+    assert s["2026-01"][("food", "EUR")] == Money("2.00", "EUR")
