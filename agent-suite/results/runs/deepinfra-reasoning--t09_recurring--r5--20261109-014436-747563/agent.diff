+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _days_in_month(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _nth_date(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+
+    if rule.freq == "monthly":
+        month_index = rule.start.year * 12 + (rule.start.month - 1) + rule.interval * k
+        year, month = divmod(month_index, 12)
+        month += 1
+        day = min(rule.start.day, _days_in_month(year, month))
+        return date(year, month, day)
+
+    year = rule.start.year + rule.interval * k
+    day = min(rule.start.day, _days_in_month(year, rule.start.month))
+    return date(year, rule.start.month, day)
+
+
+def _first_candidate(rule, window_start):
+    """Return an occurrence index at or before the first one that could be in
+    the window, so large gaps do not require walking from the start."""
+    if window_start <= rule.start:
+        return 0
+
+    if rule.freq == "weekly":
+        span = (window_start - rule.start).days
+        k = span // (7 * rule.interval) - 1
+    elif rule.freq == "monthly":
+        span = (window_start.year - rule.start.year) * 12 + (
+            window_start.month - rule.start.month
+        )
+        k = span // rule.interval - 1
+    else:
+        span = window_start.year - rule.start.year
+        k = span // rule.interval - 1
+
+    return max(0, k)
+
+
+def occurrences(rule, window_start, window_end):
+    """Return the rule's occurrence dates within the inclusive window."""
+    if rule.freq not in FREQUENCIES:
+        raise ValueError(f"invalid frequency: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+    result = []
+    k = _first_candidate(rule, window_start)
+    if rule.count is not None:
+        k = min(k, rule.count)
+
+    while rule.count is None or k < rule.count:
+        current = _nth_date(rule, k)
+        if rule.until is not None and current > rule.until:
+            break
+        if current > window_end:
+            break
+        if current >= window_start and current not in rule.skip:
+            result.append(current)
+        k += 1
+
+    return result
+
+
+def expand(rule, window_start, window_end):
+    """Return one recurring transaction per occurrence in the window."""
+    return [
+        Transaction(
+            date=occurrence,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for occurrence in occurrences(rule, window_start, window_end)
+    ]
