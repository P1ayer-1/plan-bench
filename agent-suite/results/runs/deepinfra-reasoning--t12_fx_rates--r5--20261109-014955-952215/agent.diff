+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+
+def _as_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def _mul_exact(a, b):
+    """Multiply two Decimals without rounding away significant digits."""
+    a = _as_decimal(a)
+    b = _as_decimal(b)
+    precision = len(a.as_tuple().digits) + len(b.as_tuple().digits) + 2
+    with localcontext() as ctx:
+        ctx.prec = max(precision, 28)
+        return a * b
+
+
+def _add_exact(a, b):
+    """Add two Decimals without rounding away significant digits."""
+    a = _as_decimal(a)
+    b = _as_decimal(b)
+
+    def span(value):
+        exponent = value.as_tuple().exponent
+        digits = len(value.as_tuple().digits)
+        integer_digits = max(digits + exponent, 0)
+        fractional_digits = max(-exponent, 0)
+        return integer_digits, fractional_digits
+
+    a_int, a_frac = span(a)
+    b_int, b_frac = span(b)
+    with localcontext() as ctx:
+        ctx.prec = max(a_int, b_int) + max(a_frac, b_frac) + 2
+        return a + b
+
+
+class RateTable:
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        self._rates.setdefault((base, quote), {})[on] = _as_decimal(rate)
+
+    def _direct(self, base, quote, on):
+        """Look up a rate using rules 1-3 only (no USD chaining)."""
+        if base == quote:
+            return Decimal(1)
+
+        forward = self._rates.get((base, quote))
+        if forward:
+            applicable = [d for d in forward if d <= on]
+            if applicable:
+                return forward[max(applicable)]
+
+        reverse = self._rates.get((quote, base))
+        if reverse:
+            applicable = [d for d in reverse if d <= on]
+            if applicable:
+                with localcontext() as ctx:
+                    ctx.prec = max(ctx.prec, 28)
+                    return Decimal(1) / reverse[max(applicable)]
+
+        return None
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        if base == quote:
+            return Decimal(1)
+
+        rate = self._direct(base, quote, on)
+        if rate is not None:
+            return rate
+
+        base_usd = self._direct(base, "USD", on)
+        usd_quote = self._direct("USD", quote, on)
+        if base_usd is not None and usd_quote is not None:
+            return _mul_exact(base_usd, usd_quote)
+
+        raise KeyError((base, quote, on))
+
+
+def _convert_amount(amount, from_currency, to, table, on):
+    return _mul_exact(amount, table.rate(from_currency, to, on))
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    amount = _convert_amount(money.amount, money.currency, to, table, on)
+    return Money(amount, to)
