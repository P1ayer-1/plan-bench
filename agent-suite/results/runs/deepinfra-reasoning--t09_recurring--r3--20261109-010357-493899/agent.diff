@@ -0,0 +1,73 @@
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _occurrence(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+
+    if rule.freq == "monthly":
+        month_index = rule.start.year * 12 + (rule.start.month - 1) + rule.interval * k
+        year, month = divmod(month_index, 12)
+        month += 1
+        day = min(rule.start.day, monthrange(year, month)[1])
+        return date(year, month, day)
+
+    year = rule.start.year + rule.interval * k
+    day = min(rule.start.day, monthrange(year, rule.start.month)[1])
+    return date(year, rule.start.month, day)
+
+
+def occurrences(rule, window_start, window_end):
+    if rule.freq not in FREQUENCIES:
+        raise ValueError(f"invalid frequency: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+    skipped = set(rule.skip)
+    result = []
+    k = 0
+    while rule.count is None or k < rule.count:
+        current = _occurrence(rule, k)
+        if rule.until is not None and current > rule.until:
+            break
+        if current > window_end:
+            break
+        if current >= window_start and current not in skipped:
+            result.append(current)
+        k += 1
+    return result
+
+
+def expand(rule, window_start, window_end):
+    return [
+        Transaction(
+            date=occurrence,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for occurrence in occurrences(rule, window_start, window_end)
+    ]
