+from decimal import Decimal, localcontext
+
+from .money import Money
+
+PREC = 28
+
+
+class RateTable:
+    """Historical exchange rates, exact to a Decimal."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        value = rate if isinstance(rate, Decimal) else Decimal(str(rate))
+        self._rates.setdefault((base, quote), {})[on] = value
+
+    def _most_recent(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        dates = [d for d in entries if d <= on]
+        if not dates:
+            return None
+        return entries[max(dates)]
+
+    def _lookup(self, base, quote, on):
+        """Apply rules 1-3 only (no USD chaining)."""
+        if base == quote:
+            return Decimal(1)
+        rate = self._most_recent(base, quote, on)
+        if rate is not None:
+            return rate
+        inverse = self._most_recent(quote, base, on)
+        if inverse is not None:
+            return Decimal(1) / inverse
+        return None
+
+    def rate(self, base, quote, on):
+        with localcontext() as ctx:
+            ctx.prec = PREC
+            direct = self._lookup(base, quote, on)
+            if direct is not None:
+                return direct
+            left = self._lookup(base, "USD", on)
+            right = self._lookup("USD", quote, on)
+            if left is not None and right is not None:
+                return left * right
+        raise KeyError((base, quote, on))
+
+
+def convert(money, to, table, on):
+    with localcontext() as ctx:
+        ctx.prec = PREC
+        amount = money.amount * table.rate(money.currency, to, on)
+    return Money(amount, to)
