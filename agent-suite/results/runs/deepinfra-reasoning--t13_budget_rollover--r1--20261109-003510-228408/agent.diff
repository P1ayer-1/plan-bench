+import re
+from decimal import Decimal
+
+from .money import Money
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def _month_index(value):
+    if not isinstance(value, str) or _MONTH_RE.fullmatch(value) is None:
+        raise ValueError(f"malformed month: {value!r}")
+    year, month = value.split("-")
+    return int(year) * 12 + int(month) - 1
+
+
+def _month_key(index):
+    year, month = divmod(index, 12)
+    return f"{year:04d}-{month + 1:02d}"
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    """Return monthly budget rows with optional rollover for each category."""
+    start = _month_index(start_month)
+    end = _month_index(end_month)
+    if start > end:
+        raise ValueError("start_month must not be after end_month")
+
+    months = list(range(start, end + 1))
+    spent = {
+        index: {category: Money.zero(budget.currency) for category, budget in budgets.items()}
+        for index in months
+    }
+
+    for tx in ledger.transactions:
+        index = tx.date.year * 12 + tx.date.month - 1
+        if index < start or index > end or tx.category not in budgets:
+            continue
+        budget = budgets[tx.category]
+        if tx.amount.currency != budget.currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r}: "
+                f"{tx.amount.currency!r} != {budget.currency!r}"
+            )
+        spent[index][tx.category] = spent[index][tx.category] - tx.amount
+
+    carried = {
+        category: Money.zero(budget.currency)
+        for category, budget in budgets.items()
+    }
+    report = {}
+
+    for index in months:
+        rows = {}
+        for category, budget in budgets.items():
+            row_spent = spent[index][category]
+            carried_in = carried[category]
+            available = budget + carried_in
+            remaining = available - row_spent
+            rows[category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": row_spent,
+                "available": available,
+                "remaining": remaining,
+            }
+
+            next_carried = remaining.amount
+            if next_carried < 0:
+                next_carried = Decimal("0")
+            if rollover_cap is not None and next_carried > rollover_cap.amount:
+                next_carried = rollover_cap.amount
+            carried[category] = Money(next_carried, budget.currency)
+
+        report[_month_key(index)] = rows
+
+    return report
