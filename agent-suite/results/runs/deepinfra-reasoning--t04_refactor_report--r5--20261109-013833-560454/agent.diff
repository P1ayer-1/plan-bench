+def totals_by_category(transactions):
+    """Return {category: Money} with amounts summed per category."""
+    result = {}
+    for tx in transactions:
+        if tx.category not in result:
+            result[tx.category] = Money.zero(tx.amount.currency)
+        result[tx.category] = result[tx.category] + tx.amount
+    return result
+
+
+def monthly_summary(ledger):
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
+    return {
+        month: totals_by_category(transactions)
+        for month, transactions in group_by_month(ledger.transactions).items()
+    }
+
+
+def category_share(ledger, month):
+    """Return {category: fraction} of spending for the given month."""
+    transactions = group_by_month(ledger.transactions).get(month, [])
+    spending = [tx for tx in transactions if tx.amount.amount < 0]
+    totals = totals_by_category(spending)
+    if not totals:
+        return {}
+    total = sum((abs(amount.amount) for amount in totals.values()), 0)
+    return {
+        category: float(abs(amount.amount) / total)
+        for category, amount in totals.items()
+    }
+
