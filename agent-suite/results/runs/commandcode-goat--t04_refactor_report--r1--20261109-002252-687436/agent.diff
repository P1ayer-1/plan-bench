+def totals_by_category(transactions):
+    """Return {category: Money} with amounts summed per category."""
+    result = {}
+    for tx in transactions:
+        if tx.category not in result:
+            result[tx.category] = Money.zero(tx.amount.currency)
+        result[tx.category] = result[tx.category] + tx.amount
+    return result
+
+
+def monthly_summary(ledger):
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
+    result = {}
+    for month, transactions in group_by_month(ledger.transactions).items():
+        result[month] = totals_by_category(transactions)
+    return result
+
+
+def category_share(ledger, month):
+    """Return {category: fraction} of the month's spending per category."""
+    spending = {}
+    total = 0.0
+    for tx in group_by_month(ledger.transactions).get(month, []):
+        if tx.amount.amount < 0:
+            value = abs(float(tx.amount.amount))
+            spending[tx.category] = spending.get(tx.category, 0.0) + value
+            total += value
+    if total == 0:
+        return {}
+    return {category: value / total for category, value in spending.items()}
+
