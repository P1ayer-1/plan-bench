+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+
+def _as_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+class RateTable:
+    """Historical exchange rates.
+
+    A rate added on a date applies from that date onward until a later rate
+    for the same pair supersedes it.
+    """
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        self._rates.setdefault((base, quote), {})[on] = _as_decimal(rate)
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        eligible = [d for d in entries if d <= on]
+        if not eligible:
+            return None
+        return entries[max(eligible)]
+
+    def _direct_or_inverse(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+        rate = self._latest(base, quote, on)
+        if rate is not None:
+            return rate
+        rate = self._latest(quote, base, on)
+        if rate is not None:
+            return Decimal(1) / rate
+        return None
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        if base == quote:
+            return Decimal(1)
+
+        with localcontext() as ctx:
+            ctx.prec = 28
+            direct = self._latest(base, quote, on)
+            if direct is not None:
+                return direct
+
+            inverse = self._latest(quote, base, on)
+            if inverse is not None:
+                return Decimal(1) / inverse
+
+            via_base = self._direct_or_inverse(base, "USD", on)
+            via_quote = self._direct_or_inverse("USD", quote, on)
+            if via_base is not None and via_quote is not None:
+                return via_base * via_quote
+
+        raise KeyError((base, quote, on))
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    """Convert money to another currency, rounding once to the cent."""
+    with localcontext() as ctx:
+        ctx.prec = 60
+        amount = money.amount * table.rate(money.currency, to, on)
+    return Money(amount, to)
