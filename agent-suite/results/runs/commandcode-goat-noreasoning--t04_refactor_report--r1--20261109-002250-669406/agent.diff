+def totals_by_category(transactions):
+    """Sum transaction amounts per category."""
+    result = {}
+    for tx in transactions:
+        if tx.category not in result:
+            result[tx.category] = Money.zero(tx.amount.currency)
+        result[tx.category] = result[tx.category] + tx.amount
+    return result
+
+
+def monthly_summary(ledger):
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
+    return {
+        month: totals_by_category(txs)
+        for month, txs in group_by_month(ledger.transactions).items()
+    }
+
+
+def category_share(ledger, month):
+    """Return {category: fraction} of the month's total spending (0..1)."""
+    txs = group_by_month(ledger.transactions).get(month, [])
+    spending = {}
+    for tx in txs:
+        if tx.amount.amount < 0:
+            if tx.category not in spending:
+                spending[tx.category] = Money.zero(tx.amount.currency)
+            spending[tx.category] = spending[tx.category] + (-tx.amount)
+    total = sum((m.amount for m in spending.values()), start=0)
+    if not spending or total == 0:
+        return {}
+    return {cat: float(m.amount / total) for cat, m in spending.items()}
+
