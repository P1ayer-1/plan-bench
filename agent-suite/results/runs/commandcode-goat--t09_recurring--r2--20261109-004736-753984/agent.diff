+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+_FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: "int | None" = None
+    until: "date | None" = None
+    skip: tuple = ()
+
+
+def _validate(rule):
+    if rule.freq not in _FREQUENCIES:
+        raise ValueError(f"invalid freq: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+
+def _add_months(d, months):
+    month_index = d.month - 1 + months
+    year = d.year + month_index // 12
+    month = month_index % 12 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last_day))
+
+
+def _add_years(d, years):
+    year = d.year + years
+    last_day = calendar.monthrange(year, d.month)[1]
+    return date(year, d.month, min(d.day, last_day))
+
+
+def _occurrence(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+    if rule.freq == "monthly":
+        return _add_months(rule.start, rule.interval * k)
+    return _add_years(rule.start, rule.interval * k)
+
+
+def _first_index(rule, window_start):
+    """Smallest k likely to be at or just before window_start."""
+    if rule.freq == "weekly":
+        delta = (window_start - rule.start).days
+        if delta <= 0:
+            return 0
+        return max(0, delta // (7 * rule.interval) - 1)
+    if rule.freq == "monthly":
+        months = (window_start.year - rule.start.year) * 12 + (
+            window_start.month - rule.start.month
+        )
+        if months <= 0:
+            return 0
+        return max(0, months // rule.interval - 1)
+    years = window_start.year - rule.start.year
+    if years <= 0:
+        return 0
+    return max(0, years // rule.interval - 1)
+
+
+def occurrences(rule, window_start, window_end):
+    """Return occurrence dates within [window_start, window_end]."""
+    _validate(rule)
+
+    k = _first_index(rule, window_start)
+    while _occurrence(rule, k) < window_start:
+        k += 1
+
+    result = []
+    while True:
+        if rule.count is not None and k >= rule.count:
+            break
+        d = _occurrence(rule, k)
+        if rule.until is not None and d > rule.until:
+            break
+        if d > window_end:
+            break
+        if d >= window_start and d not in rule.skip:
+            result.append(d)
+        k += 1
+    return result
+
+
+def expand(rule, window_start, window_end):
+    """Expand a recurrence into transactions for the given window."""
+    return [
+        Transaction(
+            date=d,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for d in occurrences(rule, window_start, window_end)
+    ]
