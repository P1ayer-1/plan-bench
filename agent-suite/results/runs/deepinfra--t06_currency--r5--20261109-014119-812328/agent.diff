diff --git a/ledger/report.py b/ledger/report.py
index 0f3c778..260f579 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -2,15 +2,28 @@ from .money import Money
 
 
 def monthly_summary(ledger):
-    """Return {"YYYY-MM": {category: Money}} with categories summed per month."""
-    result = {}
+    """Return {"YYYY-MM": {category: Money}} with categories summed per month.
+
+    When a month contains more than one currency, keys are (category, currency)
+    tuples instead of plain category strings.
+    """
+    months = {}
     for tx in ledger.transactions:
         m = f"{tx.date.year:04d}-{tx.date.month:02d}"
-        if m not in result:
-            result[m] = {}
-        if tx.category not in result[m]:
-            result[m][tx.category] = Money.zero(tx.amount.currency)
-        result[m][tx.category] = result[m][tx.category] + tx.amount
+        month = months.setdefault(m, {})
+        month.setdefault(tx.amount.currency, []).append(tx)
+
+    result = {}
+    for m, by_currency in months.items():
+        mixed = len(by_currency) > 1
+        cats = {}
+        for currency, txs in by_currency.items():
+            for tx in txs:
+                key = (tx.category, currency) if mixed else tx.category
+                if key not in cats:
+                    cats[key] = Money.zero(currency)
+                cats[key] = cats[key] + tx.amount
+        result[m] = cats
     return dict(sorted(result.items()))
 
 
