-        result[m][tx.category] = result[m][tx.category] + tx.amount
-    return dict(sorted(result.items()))
+        month = grouped.setdefault(m, {})
+        key = (tx.category, tx.amount.currency)
+        if key not in month:
+            month[key] = Money.zero(tx.amount.currency)
+        month[key] = month[key] + tx.amount
+
+    result = {}
+    for m, month in sorted(grouped.items()):
+        currencies = {currency for _, currency in month}
+        if len(currencies) > 1:
+            result[m] = dict(sorted(month.items()))
+        else:
+            result[m] = {
+                category: total for (category, _), total in sorted(month.items())
+            }
+    return result
 
 
