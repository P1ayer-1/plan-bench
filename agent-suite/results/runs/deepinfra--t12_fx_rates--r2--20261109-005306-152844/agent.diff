         keeping the first occurrence and preserving order."""
diff --git a/tests/test_fx.py b/tests/test_fx.py
new file mode 100644
index 0000000..e74fad1
--- /dev/null
+++ b/tests/test_fx.py
@@ -0,0 +1,90 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from ledger import Ledger, Money, Transaction
+from ledger.fx import RateTable, convert
+
+
+def test_identity_and_direct():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    assert t.rate("USD", "USD", date(2026, 1, 1)) == Decimal(1)
+    assert t.rate("EUR", "USD", date(2026, 1, 5)) == Decimal("1.10")
+
+
+def test_before_any_rate_raises():
+    t = RateTable()
+    t.add(date(2026, 1, 5), "EUR", "USD", "1.10")
+    with pytest.raises(KeyError):
+        t.rate("EUR", "USD", date(2026, 1, 4))
+
+
+def test_inverse_and_later_add():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.25")
+    assert t.rate("USD", "EUR", date(2026, 1, 2)) == Decimal(1) / Decimal("1.25")
+    t.add(date(2026, 1, 3), "EUR", "USD", "1.20")
+    assert t.rate("EUR", "USD", date(2026, 1, 2)) == Decimal("1.25")
+    assert t.rate("EUR", "USD", date(2026, 1, 3)) == Decimal("1.20")
+
+
+def test_replace_same_pair_date():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.10")
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.11")
+    assert t.rate("EUR", "USD", date(2026, 1, 1)) == Decimal("1.11")
+
+
+def test_usd_chaining():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "2")
+    t.add(date(2026, 1, 1), "USD", "JPY", "100")
+    assert t.rate("EUR", "JPY", date(2026, 1, 1)) == Decimal(200)
+
+
+def test_usd_chaining_uses_inverse():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "USD", "EUR", "0.5")
+    t.add(date(2026, 1, 1), "JPY", "USD", "0.01")
+    assert t.rate("EUR", "JPY", date(2026, 1, 1)) == Decimal(200)
+
+
+def test_convert_rounds_once():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.005")
+    m = convert(Money("1.00", "EUR"), "USD", t, date(2026, 1, 1))
+    assert m == Money("1.01", "USD")
+
+
+def test_balance_in_empty():
+    assert Ledger().balance_in("USD", RateTable()) == Money.zero("USD")
+
+
+def test_balance_in_per_date_and_override():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "2")
+    t.add(date(2026, 2, 1), "EUR", "USD", "3")
+    l = Ledger([
+        Transaction(date(2026, 1, 10), "a", Money("10.00", "EUR"), "x"),
+        Transaction(date(2026, 2, 10), "b", Money("10.00", "EUR"), "x"),
+    ])
+    assert l.balance_in("USD", t) == Money("50.00", "USD")
+    assert l.balance_in("USD", t, on=date(2026, 1, 1)) == Money("40.00", "USD")
+
+
+def test_balance_in_sums_unrounded():
+    t = RateTable()
+    t.add(date(2026, 1, 1), "EUR", "USD", "1.005")
+    l = Ledger([
+        Transaction(date(2026, 1, 10), "a", Money("1.00", "EUR"), "x"),
+        Transaction(date(2026, 1, 10), "b", Money("1.00", "EUR"), "x"),
+    ])
+    assert l.balance_in("USD", t) == Money("2.01", "USD")
+
+
+def test_balance_in_missing_rate_raises():
+    l = Ledger([Transaction(date(2026, 1, 10), "a", Money("1.00", "GBP"), "x")])
+    with pytest.raises(KeyError):
+        l.balance_in("USD", RateTable())
