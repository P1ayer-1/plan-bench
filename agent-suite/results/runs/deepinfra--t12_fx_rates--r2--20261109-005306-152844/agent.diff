@@ -0,0 +1,71 @@
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+PRECISION = 50
+
+
+def _to_decimal(value):
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def _inverse(r):
+    with localcontext() as ctx:
+        ctx.prec = PRECISION
+        return Decimal(1) / r
+
+
+class RateTable:
+    """Historical exchange rates between currency pairs."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on, base, quote, rate):
+        rate = _to_decimal(rate)
+        self._rates.setdefault((base, quote), {})[on] = rate
+
+    def _latest(self, base, quote, on):
+        entries = self._rates.get((base, quote))
+        if not entries:
+            return None
+        eligible = [d for d in entries if d <= on]
+        if not eligible:
+            return None
+        return entries[max(eligible)]
+
+    def _direct(self, base, quote, on):
+        """Rules 1-3: identity, direct pair, or inverse pair."""
+        if base == quote:
+            return Decimal(1)
+        r = self._latest(base, quote, on)
+        if r is not None:
+            return r
+        r = self._latest(quote, base, on)
+        if r is not None:
+            return _inverse(r)
+        return None
+
+    def rate(self, base, quote, on):
+        r = self._direct(base, quote, on)
+        if r is not None:
+            return r
+
+        usd_base = self._direct(base, "USD", on)
+        usd_quote = self._direct("USD", quote, on)
+        if usd_base is not None and usd_quote is not None:
+            with localcontext() as ctx:
+                ctx.prec = PRECISION
+                return usd_base * usd_quote
+
+        raise KeyError((base, quote, on))
+
+
+def convert(money, to, table, on):
+    rate = table.rate(money.currency, to, on)
+    with localcontext() as ctx:
+        ctx.prec = PRECISION
+        amount = money.amount * rate
+    return Money(amount, to)
