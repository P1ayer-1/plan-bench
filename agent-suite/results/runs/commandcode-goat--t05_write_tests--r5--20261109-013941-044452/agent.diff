diff --git a/tests/test_report.py b/tests/test_report.py
new file mode 100644
index 0000000..4e872de
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,310 @@
+from datetime import date
+from decimal import Decimal
+
+from ledger import Ledger, Money, Transaction
+from ledger.report import largest_expenses, monthly_summary
+
+
+def make_tx(iso_date, amount, category="misc", description="tx", currency="USD"):
+    return Transaction(
+        date=date.fromisoformat(iso_date),
+        description=description,
+        amount=Money(amount, currency),
+        category=category,
+    )
+
+
+def ledger_of(*txs):
+    return Ledger(list(txs))
+
+
+# ---------------------------------------------------------------------------
+# monthly_summary
+# ---------------------------------------------------------------------------
+
+def test_monthly_summary_empty_ledger_returns_empty_dict():
+    assert monthly_summary(Ledger()) == {}
+
+
+def test_monthly_summary_groups_and_sums_per_category():
+    ledger = ledger_of(
+        make_tx("2026-01-02", "-4.50", "food"),
+        make_tx("2026-01-03", "-10.25", "food"),
+        make_tx("2026-01-04", "-2.00", "transport"),
+        make_tx("2026-01-05", "3000.00", "income"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert list(summary) == ["2026-01"]
+    assert summary["2026-01"] == {
+        "food": Money("-14.75"),
+        "transport": Money("-2.00"),
+        "income": Money("3000.00"),
+    }
+
+
+def test_monthly_summary_keeps_categories_separate_within_a_month():
+    ledger = ledger_of(
+        make_tx("2026-03-01", "-5.00", "food"),
+        make_tx("2026-03-02", "-7.00", "housing"),
+    )
+
+    summary = monthly_summary(ledger)["2026-03"]
+
+    assert summary["food"] == Money("-5.00")
+    assert summary["housing"] == Money("-7.00")
+    assert summary["food"] != summary["housing"]
+
+
+def test_monthly_summary_keys_are_zero_padded_year_month():
+    ledger = ledger_of(
+        make_tx("2026-01-31", "-1.00", "food"),
+        make_tx("2026-09-01", "-2.00", "food"),
+        make_tx("2026-10-01", "-3.00", "food"),
+        make_tx("2026-12-31", "-4.00", "food"),
+    )
+
+    assert list(monthly_summary(ledger)) == [
+        "2026-01",
+        "2026-09",
+        "2026-10",
+        "2026-12",
+    ]
+
+
+def test_monthly_summary_keys_are_sorted_across_year_boundary():
+    ledger = ledger_of(
+        make_tx("2026-02-01", "-1.00", "food"),
+        make_tx("2025-12-31", "-2.00", "food"),
+        make_tx("2026-01-01", "-3.00", "food"),
+    )
+
+    assert list(monthly_summary(ledger)) == ["2025-12", "2026-01", "2026-02"]
+
+
+def test_monthly_summary_does_not_merge_same_category_across_months():
+    ledger = ledger_of(
+        make_tx("2026-01-15", "-10.00", "food"),
+        make_tx("2026-02-15", "-20.00", "food"),
+    )
+
+    summary = monthly_summary(ledger)
+
+    assert summary["2026-01"]["food"] == Money("-10.00")
+    assert summary["2026-02"]["food"] == Money("-20.00")
+
+
+def test_monthly_summary_sums_positive_and_negative_amounts_with_signs():
+    ledger = ledger_of(
+        make_tx("2026-04-01", "100.00", "refund"),
+        make_tx("2026-04-02", "-30.00", "refund"),
+        make_tx("2026-04-03", "-20.00", "refund"),
+    )
+
+    assert monthly_summary(ledger)["2026-04"]["refund"] == Money("50.00")
+
+
+def test_monthly_summary_keeps_category_whose_month_total_is_zero():
+    ledger = ledger_of(
+        make_tx("2026-05-01", "25.00", "misc"),
+        make_tx("2026-05-02", "-25.00", "misc"),
+    )
+
+    summary = monthly_summary(ledger)["2026-05"]
+
+    assert "misc" in summary
+    assert summary["misc"] == Money("0.00")
+
+
+def test_monthly_summary_includes_zero_amount_transaction():
+    ledger = ledger_of(make_tx("2026-06-01", "0.00", "misc"))
+
+    assert monthly_summary(ledger)["2026-06"]["misc"] == Money("0.00")
+
+
+def test_monthly_summary_preserves_currency():
+    ledger = ledger_of(
+        make_tx("2026-07-01", "-1.50", "food", currency="EUR"),
+        make_tx("2026-07-02", "-2.50", "food", currency="EUR"),
+    )
+
+    result = monthly_summary(ledger)["2026-07"]["food"]
+
+    assert result == Money("-4.00", "EUR")
+    assert result.currency == "EUR"
+
+
+def test_monthly_summary_handles_decimal_values_exactly():
+    ledger = ledger_of(
+        make_tx("2026-08-01", "0.10", "misc"),
+        make_tx("2026-08-02", "0.20", "misc"),
+    )
+
+    result = monthly_summary(ledger)["2026-08"]["misc"]
+
+    assert result.amount == Decimal("0.30")
+    assert result == Money("0.30")
+
+
+def test_monthly_summary_does_not_mutate_the_ledger():
+    transactions = [
+        make_tx("2026-01-02", "-4.50", "food"),
+        make_tx("2026-01-03", "10.00", "income"),
+    ]
+    ledger = Ledger(transactions)
+    original = list(ledger.transactions)
+
+    monthly_summary(ledger)
+
+    assert ledger.transactions == original
+
+
+# ---------------------------------------------------------------------------
+# largest_expenses
+# ---------------------------------------------------------------------------
+
+def test_largest_expenses_default_returns_three_most_negative_in_order():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "-10.00", "a"),
+        make_tx("2026-01-02", "-100.00", "b"),
+        make_tx("2026-01-03", "-50.00", "c"),
+        make_tx("2026-01-04", "-25.00", "d"),
+    )
+
+    result = largest_expenses(ledger)
+
+    assert [tx.description for tx in result] == ["tx", "tx", "tx"]
+    assert [tx.amount for tx in result] == [
+        Money("-100.00"),
+        Money("-50.00"),
+        Money("-25.00"),
+    ]
+
+
+def test_largest_expenses_sorts_most_negative_first():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "-2.00", "small"),
+        make_tx("2026-01-02", "-200.00", "biggest"),
+        make_tx("2026-01-03", "-20.00", "middle"),
+    )
+
+    result = largest_expenses(ledger, n=3)
+
+    assert [tx.amount for tx in result] == [
+        Money("-200.00"),
+        Money("-20.00"),
+        Money("-2.00"),
+    ]
+    assert [tx.category for tx in result] == ["biggest", "middle", "small"]
+
+
+def test_largest_expenses_excludes_income_and_zero_amounts():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "500.00", "income"),
+        make_tx("2026-01-02", "0.00", "misc"),
+        make_tx("2026-01-03", "-1.00", "expense"),
+    )
+
+    result = largest_expenses(ledger)
+
+    assert [tx.amount for tx in result] == [Money("-1.00")]
+
+
+def test_largest_expenses_uses_sign_not_category_name():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "999.00", "expense"),
+        make_tx("2026-01-02", "-5.00", "income"),
+    )
+
+    result = largest_expenses(ledger)
+
+    assert len(result) == 1
+    assert result[0].amount == Money("-5.00")
+
+
+def test_largest_expenses_returns_all_when_fewer_than_n():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "-3.00", "a"),
+        make_tx("2026-01-02", "-4.00", "b"),
+    )
+
+    result = largest_expenses(ledger, n=5)
+
+    assert [tx.amount for tx in result] == [Money("-4.00"), Money("-3.00")]
+
+
+def test_largest_expenses_n_equal_to_count():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "-3.00", "a"),
+        make_tx("2026-01-02", "-4.00", "b"),
+    )
+
+    result = largest_expenses(ledger, n=2)
+
+    assert [tx.amount for tx in result] == [Money("-4.00"), Money("-3.00")]
+
+
+def test_largest_expenses_n_of_one_returns_single_largest_expense():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "-3.00", "a"),
+        make_tx("2026-01-02", "-30.00", "b"),
+        make_tx("2026-01-03", "-300.00", "c"),
+    )
+
+    result = largest_expenses(ledger, n=1)
+
+    assert result == [ledger.transactions[2]]
+    assert result[0].amount == Money("-300.00")
+
+
+def test_largest_expenses_zero_n_returns_empty_list():
+    ledger = ledger_of(make_tx("2026-01-01", "-3.00", "a"))
+
+    assert largest_expenses(ledger, n=0) == []
+
+
+def test_largest_expenses_no_expenses_returns_empty_list():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "100.00", "income"),
+        make_tx("2026-01-02", "0.00", "misc"),
+    )
+
+    assert largest_expenses(ledger) == []
+
+
+def test_largest_expenses_empty_ledger_returns_empty_list():
+    assert largest_expenses(Ledger()) == []
+
+
+def test_largest_expenses_returns_transaction_objects():
+    expense = make_tx("2026-01-01", "-3.00", "a", description="Coffee")
+    ledger = ledger_of(expense)
+
+    result = largest_expenses(ledger)
+
+    assert result == [expense]
+    assert isinstance(result[0], Transaction)
+
+
+def test_largest_expenses_preserves_input_order_for_equal_amounts():
+    first = make_tx("2026-01-01", "-10.00", "first")
+    second = make_tx("2026-01-02", "-20.00", "second")
+    third = make_tx("2026-01-03", "-10.00", "third")
+    ledger = ledger_of(first, second, third)
+
+    result = largest_expenses(ledger, n=3)
+
+    assert result == [second, first, third]
+
+
+def test_largest_expenses_does_not_mutate_the_ledger():
+    ledger = ledger_of(
+        make_tx("2026-01-01", "-3.00", "a"),
+        make_tx("2026-01-02", "-30.00", "b"),
+    )
+    original = list(ledger.transactions)
+
+    largest_expenses(ledger, n=1)
+
+    assert ledger.transactions == original
