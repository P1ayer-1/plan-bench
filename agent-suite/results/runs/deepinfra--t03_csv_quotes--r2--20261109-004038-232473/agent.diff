+def _split_line(line, line_no):
+    """Split a single CSV line honoring quoted fields."""
+    fields = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == '"':
+            i += 1
+            buf = []
+            closed = False
+            while i < n:
+                if line[i] == '"':
+                    if i + 1 < n and line[i + 1] == '"':
+                        buf.append('"')
+                        i += 2
+                    else:
+                        i += 1
+                        closed = True
+                        break
+                else:
+                    buf.append(line[i])
+                    i += 1
+            if not closed:
+                raise ValueError(f"unterminated quoted field on line {line_no}")
+            if i < n and line[i] != ",":
+                raise ValueError(f"malformed field on line {line_no}")
+            fields.append("".join(buf))
+            if i < n and line[i] == ",":
+                i += 1
+            else:
+                break
+        else:
+            j = line.find(",", i)
+            if j == -1:
+                fields.append(line[i:])
+                break
+            fields.append(line[i:j])
+            i = j + 1
+    return fields
+
