+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+_FREQS = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _days_in_month(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _add_months(start, months):
+    total = start.year * 12 + (start.month - 1) + months
+    year, month0 = divmod(total, 12)
+    month = month0 + 1
+    day = min(start.day, _days_in_month(year, month))
+    return date(year, month, day)
+
+
+def _add_years(start, years):
+    year = start.year + years
+    day = min(start.day, _days_in_month(year, start.month))
+    return date(year, start.month, day)
+
+
+def _occurrence_date(rule, k):
+    n = rule.interval * k
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * n)
+    if rule.freq == "monthly":
+        return _add_months(rule.start, n)
+    return _add_years(rule.start, n)
+
+
+def _validate(rule):
+    if rule.freq not in _FREQS:
+        raise ValueError(f"invalid freq: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+
+def _first_k_at_or_after(rule, target):
+    start = rule.start
+    if start >= target:
+        return 0
+    if rule.freq == "weekly":
+        k = (target - start).days // (7 * rule.interval)
+    elif rule.freq == "monthly":
+        k = ((target.year - start.year) * 12 + target.month - start.month) // rule.interval
+    else:
+        k = (target.year - start.year) // rule.interval
+    k = max(0, k)
+    while k > 0 and _occurrence_date(rule, k - 1) >= target:
+        k -= 1
+    while _occurrence_date(rule, k) < target:
+        k += 1
+    return k
+
+
+def occurrences(rule, window_start, window_end):
+    _validate(rule)
+    skip = set(rule.skip)
+    result = []
+    k = _first_k_at_or_after(rule, window_start)
+    while True:
+        if rule.count is not None and k >= rule.count:
+            break
+        current = _occurrence_date(rule, k)
+        if current > window_end:
+            break
+        if rule.until is not None and current > rule.until:
+            break
+        if current >= window_start and current not in skip:
+            result.append(current)
+        k += 1
+    return result
+
+
+def expand(rule, window_start, window_end):
+    return [
+        Transaction(
+            date=d,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for d in occurrences(rule, window_start, window_end)
+    ]
