+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from .ledger import Transaction
+from .money import Money
+
+FREQUENCIES = ("weekly", "monthly", "yearly")
+
+
+@dataclass(frozen=True)
+class Recurrence:
+    description: str
+    amount: Money
+    category: str
+    start: date
+    freq: str
+    interval: int = 1
+    count: int | None = None
+    until: date | None = None
+    skip: tuple = ()
+
+
+def _validate(rule):
+    if rule.freq not in FREQUENCIES:
+        raise ValueError(f"invalid frequency: {rule.freq!r}")
+    if rule.interval < 1:
+        raise ValueError("interval must be at least 1")
+    if rule.count is not None and rule.count < 0:
+        raise ValueError("count must not be negative")
+
+
+def _nth(rule, k):
+    if rule.freq == "weekly":
+        return rule.start + timedelta(days=7 * rule.interval * k)
+
+    if rule.freq == "monthly":
+        month_index = rule.start.month - 1 + rule.interval * k
+        year = rule.start.year + month_index // 12
+        month = month_index % 12 + 1
+        day = min(rule.start.day, calendar.monthrange(year, month)[1])
+        return date(year, month, day)
+
+    year = rule.start.year + rule.interval * k
+    day = min(rule.start.day, calendar.monthrange(year, rule.start.month)[1])
+    return date(year, rule.start.month, day)
+
+
+def _first_k(rule, window_start):
+    if rule.freq == "weekly":
+        delta = (window_start - rule.start).days
+        if delta <= 0:
+            return 0
+        return max(0, delta // (7 * rule.interval) - 1)
+
+    if rule.freq == "monthly":
+        months = (window_start.year - rule.start.year) * 12 + (
+            window_start.month - rule.start.month
+        )
+        if months <= 0:
+            return 0
+        return max(0, months // rule.interval - 1)
+
+    years = window_start.year - rule.start.year
+    if years <= 0:
+        return 0
+    return max(0, years // rule.interval - 1)
+
+
+def occurrences(rule, window_start, window_end):
+    """Return occurrence dates of rule within [window_start, window_end]."""
+    _validate(rule)
+    if window_end < window_start:
+        return []
+
+    skip = set(rule.skip)
+    k = _first_k(rule, window_start)
+    result = []
+
+    while True:
+        if rule.count is not None and k >= rule.count:
+            break
+
+        try:
+            current = _nth(rule, k)
+        except (OverflowError, ValueError):
+            break
+        if rule.until is not None and current > rule.until:
+            break
+        if current > window_end:
+            break
+
+        if current >= window_start and current not in skip:
+            result.append(current)
+        k += 1
+
+    return result
+
+
+def expand(rule, window_start, window_end):
+    """Expand a recurrence into transactions within the given window."""
+    return [
+        Transaction(
+            date=day,
+            description=rule.description,
+            amount=rule.amount,
+            category=rule.category,
+            tags=("recurring",),
+        )
+        for day in occurrences(rule, window_start, window_end)
+    ]
