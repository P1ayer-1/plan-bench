+from dataclasses import dataclass, field
+
+
+@dataclass
+class Reconciliation:
+    matched: list = field(default_factory=list)
+    unmatched_ledger: list = field(default_factory=list)
+    unmatched_bank: list = field(default_factory=list)
+
+
+def _group_by_amount(transactions):
+    groups = {}
+    for index, tx in enumerate(transactions):
+        groups.setdefault(tx.amount, []).append(index)
+    return groups
+
+
+def _match_group(ledger_indices, bank_indices, ledger_txs, bank_txs, max_days):
+    ledger = sorted(
+        ((ledger_txs[i].date, i) for i in ledger_indices),
+        key=lambda item: item[0],
+    )
+    bank = sorted(
+        ((bank_txs[i].date, i) for i in bank_indices),
+        key=lambda item: item[0],
+    )
+
+    ledger_count = len(ledger)
+    bank_count = len(bank)
+
+    pairs = [[0] * (bank_count + 1) for _ in range(ledger_count + 1)]
+    distances = [[0] * (bank_count + 1) for _ in range(ledger_count + 1)]
+    choices = [[None] * (bank_count + 1) for _ in range(ledger_count + 1)]
+
+    for i in range(1, ledger_count + 1):
+        choices[i][0] = "ledger"
+    for j in range(1, bank_count + 1):
+        choices[0][j] = "bank"
+
+    for i in range(1, ledger_count + 1):
+        ledger_date = ledger[i - 1][0]
+        for j in range(1, bank_count + 1):
+            bank_date = bank[j - 1][0]
+
+            best_pairs = pairs[i - 1][j]
+            best_distance = distances[i - 1][j]
+            best_choice = "ledger"
+
+            if (pairs[i][j - 1], -distances[i][j - 1]) > (best_pairs, -best_distance):
+                best_pairs = pairs[i][j - 1]
+                best_distance = distances[i][j - 1]
+                best_choice = "bank"
+
+            difference = abs((ledger_date - bank_date).days)
+            if difference <= max_days:
+                candidate_pairs = pairs[i - 1][j - 1] + 1
+                candidate_distance = distances[i - 1][j - 1] + difference
+                if (candidate_pairs, -candidate_distance) > (best_pairs, -best_distance):
+                    best_pairs = candidate_pairs
+                    best_distance = candidate_distance
+                    best_choice = "pair"
+
+            pairs[i][j] = best_pairs
+            distances[i][j] = best_distance
+            choices[i][j] = best_choice
+
+    matched = []
+    i, j = ledger_count, bank_count
+    while i > 0 and j > 0:
+        choice = choices[i][j]
+        if choice == "pair":
+            matched.append((ledger[i - 1][1], bank[j - 1][1]))
+            i -= 1
+            j -= 1
+        elif choice == "ledger":
+            i -= 1
+        else:
+            j -= 1
+
+    return matched
+
+
+def reconcile(ledger_txs, bank_txs, max_days=3):
+    ledger_groups = _group_by_amount(ledger_txs)
+    bank_groups = _group_by_amount(bank_txs)
+
+    matched_indices = []
+    for amount, ledger_indices in ledger_groups.items():
+        bank_indices = bank_groups.get(amount)
+        if not bank_indices:
+            continue
+        matched_indices.extend(
+            _match_group(ledger_indices, bank_indices, ledger_txs, bank_txs, max_days)
+        )
+
+    matched_indices.sort(key=lambda pair: pair[0])
+    matched_ledger = {ledger_index for ledger_index, _ in matched_indices}
+    matched_bank = {bank_index for _, bank_index in matched_indices}
+
+    return Reconciliation(
+        matched=[(ledger_txs[i], bank_txs[j]) for i, j in matched_indices],
+        unmatched_ledger=[
+            tx for i, tx in enumerate(ledger_txs) if i not in matched_ledger
+        ],
+        unmatched_bank=[tx for i, tx in enumerate(bank_txs) if i not in matched_bank],
+    )
