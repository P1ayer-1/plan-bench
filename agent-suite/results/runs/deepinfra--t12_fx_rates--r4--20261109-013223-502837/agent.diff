@@ -0,0 +1,71 @@
+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+USD = "USD"
+
+
+def _to_decimal(rate):
+    if isinstance(rate, Decimal):
+        return rate
+    return Decimal(str(rate))
+
+
+class RateTable:
+    """Historical exchange rates, stored as exact Decimals."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        rate = _to_decimal(rate)
+        self._rates.setdefault((base, quote), {})[on] = rate
+
+    def _latest(self, base, quote, on):
+        series = self._rates.get((base, quote))
+        if not series:
+            return None
+        best = None
+        best_date = None
+        for d, r in series.items():
+            if d <= on and (best_date is None or d > best_date):
+                best = r
+                best_date = d
+        return best
+
+    def rate(self, base: str, quote: str, on: date) -> Decimal:
+        with localcontext() as ctx:
+            ctx.prec = 50
+            return self._rate(base, quote, on)
+
+    def _rate(self, base, quote, on):
+        if base == quote:
+            return Decimal(1)
+
+        direct = self._latest(base, quote, on)
+        if direct is not None:
+            return direct
+
+        inverse = self._latest(quote, base, on)
+        if inverse is not None:
+            return Decimal(1) / inverse
+
+        if base != USD and quote != USD:
+            try:  # noqa: SIM105
+                first = self._rate(base, USD, on)
+                second = self._rate(USD, quote, on)
+            except KeyError:
+                pass
+            else:
+                return first * second
+
+        raise KeyError((base, quote, on))
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    with localcontext() as ctx:
+        ctx.prec = 50
+        rate = table.rate(money.currency, to, on)
+        amount = money.amount * rate
+    return Money(amount, to)
