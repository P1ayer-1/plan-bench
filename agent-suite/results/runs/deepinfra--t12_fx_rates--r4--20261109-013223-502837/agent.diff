+    def balance_in(self, currency, table, on=None):
+        """Total of all transactions converted to currency.
+
+        Each transaction is converted at the rate on its own date, or on
+        ``on`` for every transaction if given. Unrounded amounts are summed
+        and rounded once at the end.
+        """
+        from decimal import Decimal, localcontext
+
+        from .money import Money
+
+        if not self.transactions:
+            return Money.zero(currency)
+
+        with localcontext() as ctx:
+            ctx.prec = 50
+            total = Decimal(0)
+            for tx in self.transactions:
+                when = on if on is not None else tx.date
+                rate = table.rate(tx.amount.currency, currency, when)
+                total += tx.amount.amount * rate
+            return Money(total, currency)
+
     def dedupe(self):
