+from .money import Money
+
+
+def _parse_month(value):
+    if not isinstance(value, str):
+        raise ValueError(f"invalid month: {value!r}")
+    if len(value) != 7 or value[4] != "-":
+        raise ValueError(f"invalid month: {value!r}")
+    year_part, month_part = value[:4], value[5:]
+    if not year_part.isdigit() or not month_part.isdigit():
+        raise ValueError(f"invalid month: {value!r}")
+    month = int(month_part)
+    if not 1 <= month <= 12:
+        raise ValueError(f"invalid month: {value!r}")
+    return int(year_part), month
+
+
+def _month_range(start, end):
+    year, month = start
+    while (year, month) <= end:
+        yield f"{year:04d}-{month:02d}"
+        month += 1
+        if month > 12:
+            month = 1
+            year += 1
+
+
+def budget_report(ledger, budgets, start_month, end_month, rollover_cap=None):
+    """Return per-month budget rows for the given categories and month range."""
+    start = _parse_month(start_month)
+    end = _parse_month(end_month)
+    if start > end:
+        raise ValueError("start_month must not be after end_month")
+
+    months = list(_month_range(start, end))
+    month_set = set(months)
+
+    spent_by_month = {}
+    for tx in ledger.transactions:
+        month = f"{tx.date.year:04d}-{tx.date.month:02d}"
+        if month not in month_set or tx.category not in budgets:
+            continue
+        currency = budgets[tx.category].currency
+        if tx.amount.currency != currency:
+            raise ValueError(
+                f"currency mismatch for category {tx.category!r}: "
+                f"expected {currency}, got {tx.amount.currency}"
+            )
+        key = (month, tx.category)
+        if key not in spent_by_month:
+            spent_by_month[key] = Money.zero(currency)
+        spent_by_month[key] = spent_by_month[key] + tx.amount
+
+    result = {}
+    next_carried = {
+        category: Money.zero(budget.currency)
+        for category, budget in budgets.items()
+    }
+
+    for month in months:
+        rows = {}
+        for category, budget in budgets.items():
+            if month == start_month:
+                carried_in = Money.zero(budget.currency)
+            else:
+                carried_in = next_carried[category]
+
+            spent = -spent_by_month.get(
+                (month, category), Money.zero(budget.currency)
+            )
+            available = budget + carried_in
+            remaining = available - spent
+
+            carry = remaining if remaining.amount > 0 else Money.zero(budget.currency)
+            if rollover_cap is not None and carry.amount > rollover_cap.amount:
+                carry = Money(rollover_cap.amount, budget.currency)
+            next_carried[category] = carry
+
+            rows[category] = {
+                "budget": budget,
+                "carried_in": carried_in,
+                "spent": spent,
+                "available": available,
+                "remaining": remaining,
+            }
+        result[month] = rows
+
+    return result
