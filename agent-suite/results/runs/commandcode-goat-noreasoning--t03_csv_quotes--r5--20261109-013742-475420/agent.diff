+def _parse_row(line):
+    """Parse a single CSV row into a list of fields, handling double-quote
+    quoting where quoted fields may contain commas and '""' means a literal
+    quote character."""
+    fields = []
+    i = 0
+    n = len(line)
+    while True:
+        if i < n and line[i] == '"':
+            i += 1
+            buf = []
+            while i < n:
+                if line[i] == '"':
+                    if i + 1 < n and line[i + 1] == '"':
+                        buf.append('"')
+                        i += 2
+                    else:
+                        i += 1
+                        break
+                else:
+                    buf.append(line[i])
+                    i += 1
+            field = "".join(buf)
+            while i < n and line[i] != ",":
+                field += line[i]
+                i += 1
+        else:
+            j = i
+            while j < n and line[j] != ",":
+                j += 1
+            field = line[i:j]
+            i = j
+        fields.append(field)
+        if i >= n:
+            break
+        i += 1
+        if i > n:
+            break
+    return fields
 
 
