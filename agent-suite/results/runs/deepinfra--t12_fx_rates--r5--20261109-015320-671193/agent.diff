@@ -0,0 +1,54 @@
+from datetime import date
+from decimal import Decimal, localcontext
+
+from .money import Money
+
+_PREC = 50
+
+
+class RateTable:
+    """Historical exchange rates, stored as exact Decimals."""
+
+    def __init__(self):
+        self._rates = {}
+
+    def add(self, on: date, base: str, quote: str, rate):
+        self._rates.setdefault((base, quote), {})[on] = Decimal(str(rate))
+
+    def _direct(self, base, quote, on):
+        series = self._rates.get((base, quote))
+        if not series:
+            return None
+        best = None
+        for d, r in series.items():
+            if d <= on and (best is None or d > best):
+                best = d
+        if best is None:
+            return None
+        return series[best]
+
+    def rate(self, base, quote, on: date) -> Decimal:
+        if base == quote:
+            return Decimal(1)
+        r = self._direct(base, quote, on)
+        if r is not None:
+            return r
+        r = self._direct(quote, base, on)
+        if r is not None:
+            with localcontext() as ctx:
+                ctx.prec = max(_PREC, 28)
+                return Decimal(1) / r
+        with localcontext() as ctx:
+            ctx.prec = max(_PREC, 28)
+            left = self.rate(base, "USD", on)
+            right = self.rate("USD", quote, on)
+            return left * right
+
+
+def convert(money: Money, to: str, table: RateTable, on: date) -> Money:
+    if money.currency == to:
+        return Money(money.amount, to)
+    with localcontext() as ctx:
+        ctx.prec = max(_PREC, 28)
+        amount = money.amount * table.rate(money.currency, to, on)
+    return Money(amount, to)
